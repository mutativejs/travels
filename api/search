onstructor.","locale":"en"},"2017":{"id":"/docs/concepts/history-lifecycle","page_id":"/docs/concepts/history-lifecycle","type":"page","content":"History Lifecycle","breadcrumbs":["Travels","Core Concepts"],"tags":[],"url":"/docs/concepts/history-lifecycle","locale":"en"},"2018":{"id":"/docs/concepts/history-lifecycle-0","page_id":"/docs/concepts/history-lifecycle","tags":[],"type":"text","url":"/docs/concepts/history-lifecycle","content":"Manage retained windows, baselines, reset, rebase, trimming, and branch replacement.","locale":"en"},"2019":{"id":"/docs/concepts/history-lifecycle-1","page_id":"/docs/concepts/history-lifecycle","type":"heading","tags":[],"url":"/docs/concepts/history-lifecycle#positions-and-entries","content":"Positions and entries","locale":"en"},"2020":{"id":"/docs/concepts/history-lifecycle-2","page_id":"/docs/concepts/history-lifecycle","type":"heading","tags":[],"url":"/docs/concepts/history-lifecycle#maxhistory","content":"`maxHistory`","locale":"en"},"2021":{"id":"/docs/concepts/history-lifecycle-3","page_id":"/docs/concepts/history-lifecycle","type":"heading","tags":[],"url":"/docs/concepts/history-lifecycle#reset","content":"`reset()`","locale":"en"},"2022":{"id":"/docs/concepts/history-lifecycle-4","page_id":"/docs/concepts/history-lifecycle","type":"heading","tags":[],"url":"/docs/concepts/history-lifecycle#rebase","content":"`rebase()`","locale":"en"},"2023":{"id":"/docs/concepts/history-lifecycle-5","page_id":"/docs/concepts/history-lifecycle","type":"heading","tags":[],"url":"/docs/concepts/history-lifecycle#creating-a-new-branch","content":"Creating a new branch","locale":"en"},"2024":{"id":"/docs/concepts/history-lifecycle-6","page_id":"/docs/concepts/history-lifecycle","type":"heading","tags":[],"url":"/docs/concepts/history-lifecycle#loading-state-without-history","content":"Loading state without history","locale":"en"},"2025":{"id":"/docs/concepts/history-lifecycle-7","page_id":"/docs/concepts/history-lifecycle","type":"heading","tags":[],"url":"/docs/concepts/history-lifecycle#reading-history-safely","content":"Reading history safely","locale":"en"},"2026":{"id":"/docs/concepts/history-lifecycle-8","page_id":"/docs/concepts/history-lifecycle","tags":[],"type":"text","url":"/docs/concepts/history-lifecycle","content":"A Travels timeline has two related but different ideas: the **retained history window** used by navigation, and the **instance baseline** used by `reset()`. Understanding their lifecycle prevents subtle undo/redo bugs.","locale":"en"},"2027":{"id":"/docs/concepts/history-lifecycle-9","page_id":"/docs/concepts/history-lifecycle","tags":[],"type":"text","url":"/docs/concepts/history-lifecycle#positions-and-entries","content":"Position `0` is the start of the current retained window. Each patch entry represents a transition to the next position. If three entries are retained, four states can be reconstructed: the window baseline plus three transitions.","locale":"en"},"2028":{"id":"/docs/concepts/history-lifecycle-10","page_id":"/docs/concepts/history-lifecycle","tags":[],"type":"text","url":"/docs/concepts/history-lifecycle#positions-and-entries","content":"The oldest transitions were trimmed, but the current state remains `5` and the retained window starts at `2`.","locale":"en"},"2029":{"id":"/docs/concepts/history-lifecycle-11","page_id":"/docs/concepts/history-lifecycle","tags":[],"type":"text","url":"/docs/concepts/history-lifecycle#maxhistory","content":"`maxHistory` must be a non-negative integer. Invalid values such as decimals, `NaN`, and `Infinity` are rejected immediately.","locale":"en"},"2030":{"id":"/docs/concepts/history-lifecycle-12","page_id":"/docs/concepts/history-lifecycle","tags":[],"type":"text","url":"/docs/concepts/history-lifecycle#maxhistory","content":"It counts patch entries, not states.","locale":"en"},"2031":{"id":"/docs/concepts/history-lifecycle-13","page_id":"/docs/concepts/history-lifecycle","tags":[],"type":"text","url":"/docs/concepts/history-lifecycle#maxhistory","content":"Old entries are dropped automatically.","locale":"en"},"2032":{"id":"/docs/concepts/history-lifecycle-14","page_id":"/docs/concepts/history-lifecycle","tags":[],"type":"text","url":"/docs/concepts/history-lifecycle#maxhistory","content":"The position is relative to the retained window and capped at the limit.","locale":"en"},"2033":{"id":"/docs/concepts/history-lifecycle-15","page_id":"/docs/concepts/history-lifecycle","tags":[],"type":"text","url":"/docs/concepts/history-lifecycle#maxhistory","content":"`reset()` can still restore the original instance baseline.","locale":"en"},"2034":{"id":"/docs/concepts/history-lifecycle-16","page_id":"/docs/concepts/history-lifecycle","tags":[],"type":"text","url":"/docs/concepts/history-lifecycle#maxhistory","content":"Use a deliberate limit; “unlimited” history is not a safe persistence strategy by default.","locale":"en"},"2035":{"id":"/docs/concepts/history-lifecycle-17","page_id":"/docs/concepts/history-lifecycle","tags":[],"type":"text","url":"/docs/concepts/history-lifecycle#maxhistory","content":"`onWarning` can report `HISTORY_TRIMMED` when the application needs diagnostics. Do not infer overflow solely by comparing positions across every operation; navigation and rebase also change positions.","locale":"en"},"2036":{"id":"/docs/concepts/history-lifecycle-18","page_id":"/docs/concepts/history-lifecycle","tags":[],"type":"text","url":"/docs/concepts/history-lifecycle#reset","content":"`reset()` restores the baseline captured when the instance was created or restored, then clears the timeline back to that baseline.","locale":"en"},"2037":{"id":"/docs/concepts/history-lifecycle-19","page_id":"/docs/concepts/history-lifecycle","tags":[],"type":"text","url":"/docs/concepts/history-lifecycle#reset","content":"For a restored instance, the baseline is the validated starting timeline captured by the restore operation. Subsequent baseline-changing operations—such as `rebase()`, `replaceStateWithoutHistory()`, or updates while tracking is paused—affect what later resets return to.","locale":"en"},"2038":{"id":"/docs/concepts/history-lifecycle-20","page_id":"/docs/concepts/history-lifecycle","tags":[],"type":"text","url":"/docs/concepts/history-lifecycle#rebase","content":"`rebase()` makes current state the new initial baseline and discards all retained past and future entries.","locale":"en"},"2039":{"id":"/docs/concepts/history-lifecycle-21","page_id":"/docs/concepts/history-lifecycle","tags":[],"type":"text","url":"/docs/concepts/history-lifecycle#rebase","content":"Use `rebase()` only when the old timeline should become unreachable, such as after accepting a server snapshot or deliberately starting a new editing session. It is not the same as undoing to position `0`.","locale":"en"},"2040":{"id":"/docs/concepts/history-lifecycle-22","page_id":"/docs/concepts/history-lifecycle","tags":[],"type":"text","url":"/docs/concepts/history-lifecycle#creating-a-new-branch","content":"After `back()`, future entries remain available through `forward()` until a new edit commits. That edit discards the redo branch and appends a new entry at the current position.","locale":"en"},"2041":{"id":"/docs/concepts/history-lifecycle-23","page_id":"/docs/concepts/history-lifecycle","tags":[],"type":"text","url":"/docs/concepts/history-lifecycle#creating-a-new-branch","content":"Use `onBranchDiscard({ position, discarded })` for auditing or cleanup. The hook runs after the committed transition and cannot veto it.","locale":"en"},"2042":{"id":"/docs/concepts/history-lifecycle-24","page_id":"/docs/concepts/history-lifecycle","tags":[],"type":"text","url":"/docs/concepts/history-lifecycle#loading-state-without-history","content":"`replaceStateWithoutHistory(updater)` applies an update, clears history, and makes the result the new baseline. It is useful for accepting an authoritative remote snapshot or replacing a document without letting users undo into the previous document.","locale":"en"},"2043":{"id":"/docs/concepts/history-lifecycle-25","page_id":"/docs/concepts/history-lifecycle","tags":[],"type":"text","url":"/docs/concepts/history-lifecycle#loading-state-without-history","content":"`pauseTracking()` and `resumeTracking()` instead form a scope for updates that should become the new baseline while ordinary timeline operations continue afterward. See Tracking and Replacement.","locale":"en"},"2044":{"id":"/docs/concepts/history-lifecycle-26","page_id":"/docs/concepts/history-lifecycle","tags":[],"type":"text","url":"/docs/concepts/history-lifecycle#reading-history-safely","content":"`getHistory()` returns a shared, cached, read-only array of read-only state views. Use it while rendering or measuring the current timeline.","locale":"en"},"2045":{"id":"/docs/concepts/history-lifecycle-27","page_id":"/docs/concepts/history-lifecycle","tags":[],"type":"text","url":"/docs/concepts/history-lifecycle#reading-history-safely","content":"`getHistorySnapshot()` returns detached, caller-owned states. Use it when retaining, sorting, posting to a worker, or mutating the result.","locale":"en"},"2046":{"id":"/docs/concepts/history-lifecycle-28","page_id":"/docs/concepts/history-lifecycle","tags":[],"type":"text","url":"/docs/concepts/history-lifecycle#reading-history-safely","content":"`getPatches()` returns a detached retained patch snapshot.","locale":"en"},"2047":{"id":"/docs/concepts/history-lifecycle-29","page_id":"/docs/concepts/history-lifecycle","tags":[],"type":"text","url":"/docs/concepts/history-lifecycle#reading-history-safely","content":"`getControls().patches` is a cached read-only view whose identity remains stable until history changes.","locale":"en"},"2048":{"id":"/docs/concepts/history-lifecycle-30","page_id":"/docs/concepts/history-lifecycle","tags":[],"type":"text","url":"/docs/concepts/history-lifecycle#reading-history-safely","content":"Mutable timelines can share the live object with history entries, so an old `getHistory()` result can reflect later in-place updates. Detached snapshots are the correct tool when historical values must remain fixed.","locale":"en"},"2049":{"id":"/docs/concepts/how-it-works","page_id":"/docs/concepts/how-it-works","type":"page","content":"How Travels Works","breadcrumbs":["Travels","Core Concepts"],"tags":[],"url":"/docs/concepts/how-it-works","locale":"en"},"2050":{"id":"/docs/concepts/how-it-works-0","page_id":"/docs/concepts/how-it-works","tags":[],"type":"text","url":"/docs/concepts/how-it-works","content":"Follow state, forward patches, inverse patches, positions, and branches through one timeline.","locale":"en"},"2051":{"id":"/docs/concepts/how-it-works-1","page_id":"/docs/concepts/how-it-works","type":"heading","tags":[],"url":"/docs/concepts/how-it-works#the-five-core-terms","content":"The five core terms","locale":"en"},"2052":{"id":"/docs/concepts/how-it-works-2","page_id":"/docs/concepts/how-it-works","type":"heading","tags":[],"url":"/docs/concepts/how-it-works#one-edit-two-directions","content":"One edit, two directions","locale":"en"},"2053":{"id":"/docs/concepts/how-it-works-3","page_id":"/docs/concepts/how-it-works","type":"heading","tags":[],"url":"/docs/concepts/how-it-works#immutable-mode-by-default","content":"Immutable mode by default","locale":"en"},"2054":{"id":"/docs/concepts/how-it-works-4","page_id":"/docs/concepts/how-it-works","type":"heading","tags":[],"url":"/docs/concepts/how-it-works#mutable-mode-for-identity-stable-stores","content":"Mutable mode for identity-stable stores","locale":"en"},"2055":{"id":"/docs/concepts/how-it-works-5","page_id":"/docs/concepts/how-it-works","type":"heading","tags":[],"url":"/docs/concepts/how-it-works#automatic-and-manual-history","content":"Automatic and manual history","locale":"en"},"2056":{"id":"/docs/concepts/how-it-works-6","page_id":"/docs/concepts/how-it-works","type":"heading","tags":[],"url":"/docs/concepts/how-it-works#branches-and-the-redo-boundary","content":"Branches and the redo boundary","locale":"en"},"2057":{"id":"/docs/concepts/how-it-works-7","page_id":"/docs/concepts/how-it-works","type":"heading","tags":[],"url":"/docs/concepts/how-it-works#retained-window-versus-true-baseline","content":"Retained window versus true baseline","locale":"en"},"2058":{"id":"/docs/concepts/how-it-works-8","page_id":"/docs/concepts/how-it-works","type":"heading","tags":[],"url":"/docs/concepts/how-it-works#what-persistence-stores","content":"What persistence stores","locale":"en"},"2059":{"id":"/docs/concepts/how-it-works-9","page_id":"/docs/concepts/how-it-works","tags":[],"type":"text","url":"/docs/concepts/how-it-works","content":"Travels turns each effective update into an immutable state transition plus two patch groups: one that moves forward and one that restores the previous state. The retained sequence of those transitions is the history.","locale":"en"},"2060":{"id":"/docs/concepts/how-it-works-10","page_id":"/docs/concepts/how-it-works","tags":[],"type":"text","url":"/docs/concepts/how-it-works#the-five-core-terms","content":"| Term      | Meaning                                                |\n| --------- | ------------------------------------------------------ |\n| **State** | The application data at the current timeline position. |","locale":"en","table":"table-0"},"2061":{"id":"/docs/concepts/how-it-works-11","page_id":"/docs/concepts/how-it-works","tags":[],"type":"text","url":"/docs/concepts/how-it-works#the-five-core-terms","content":"| Term      | Meaning                                                      |\n| --------- | ------------------------------------------------------------ |\n| **Draft** | The mutation-friendly draft passed to a `setState()` recipe. |","locale":"en","table":"table-0"},"2062":{"id":"/docs/concepts/how-it-works-12","page_id":"/docs/concepts/how-it-works","tags":[],"type":"text","url":"/docs/concepts/how-it-works#the-five-core-terms","content":"| Term        | Meaning                                                            |\n| ----------- | ------------------------------------------------------------------ |\n| **Patches** | JSON Patch operations describing a transition, plus their inverse. |","locale":"en","table":"table-0"},"2063":{"id":"/docs/concepts/how-it-works-13","page_id":"/docs/concepts/how-it-works","tags":[],"type":"text","url":"/docs/concepts/how-it-works#the-five-core-terms","content":"| Term         | Meaning                                                         |\n| ------------ | --------------------------------------------------------------- |\n| **Position** | The cursor in the retained history window; `0` is its baseline. |","locale":"en","table":"table-0"},"2064":{"id":"/docs/concepts/how-it-works-14","page_id":"/docs/concepts/how-it-works","tags":[],"type":"text","url":"/docs/concepts/how-it-works#the-five-core-terms","content":"| Term        | Meaning                                                   |\n| ----------- | --------------------------------------------------------- |\n| **Archive** | The act of committing pending changes as a history entry. |","locale":"en","table":"table-0"},"2065":{"id":"/docs/concepts/how-it-works-15","page_id":"/docs/concepts/how-it-works","tags":[],"type":"text","url":"/docs/concepts/how-it-works#one-edit-two-directions","content":"Consider this state and update:","locale":"en"},"2066":{"id":"/docs/concepts/how-it-works-16","page_id":"/docs/concepts/how-it-works","tags":[],"type":"text","url":"/docs/concepts/how-it-works#one-edit-two-directions","content":"Conceptually, Travels retains a forward entry like this:","locale":"en"},"2067":{"id":"/docs/concepts/how-it-works-17","page_id":"/docs/concepts/how-it-works","tags":[],"type":"text","url":"/docs/concepts/how-it-works#one-edit-two-directions","content":"It also retains the inverse entry needed to restore `{ title: 'Draft', views: 0 }`. `back()` applies inverse operations; `forward()` reapplies forward operations. You do not write either patch group yourself when using `setState()`.","locale":"en"},"2068":{"id":"/docs/concepts/how-it-works-18","page_id":"/docs/concepts/how-it-works","tags":[],"type":"text","url":"/docs/concepts/how-it-works#one-edit-two-directions","content":"Moving back changes the cursor and state; it does not destroy future entries until a new committed edit creates a branch.","locale":"en"},"2069":{"id":"/docs/concepts/how-it-works-19","page_id":"/docs/concepts/how-it-works","tags":[],"type":"text","url":"/docs/concepts/how-it-works#immutable-mode-by-default","content":"In the default mode, Travels produces a new immutable state through Mutative. Unchanged branches can be structurally shared. Treat values returned by `getState()`, `getHistory()`, and observer events as read-only: direct writes bypass patch recording and can also modify objects retained by patch values.","locale":"en"},"2070":{"id":"/docs/concepts/how-it-works-20","page_id":"/docs/concepts/how-it-works","tags":[],"type":"text","url":"/docs/concepts/how-it-works#immutable-mode-by-default","content":"Use `enableAutoFreeze: true` in immutable mode when you want accidental writes to fail during development. For a caller-owned history array, use `getHistorySnapshot()` rather than modifying the shared `getHistory()` cache.","locale":"en"},"2071":{"id":"/docs/concepts/how-it-works-21","page_id":"/docs/concepts/how-it-works","tags":[],"type":"text","url":"/docs/concepts/how-it-works#mutable-mode-for-identity-stable-stores","content":"With `mutable: true`, Travels applies patches back to the original object so MobX, Vue, Pinia, or custom proxies can keep observing the same reference. It still generates forward and inverse patches for navigation and persistence.","locale":"en"},"2072":{"id":"/docs/concepts/how-it-works-22","page_id":"/docs/concepts/how-it-works","tags":[],"type":"text","url":"/docs/concepts/how-it-works#mutable-mode-for-identity-stable-stores","content":"Root replacements and primitive roots can require an immutable fallback. `enableAutoFreeze` cannot be combined with mutable mode. The Mutable Mode Guide explains every operation’s identity behavior.","locale":"en"},"2073":{"id":"/docs/concepts/how-it-works-23","page_id":"/docs/concepts/how-it-works","tags":[],"type":"text","url":"/docs/concepts/how-it-works#automatic-and-manual-history","content":"With `autoArchive: true`, every effective `setState()` creates an entry. With `autoArchive: false`, state updates remain pending until `archive()` or an operation that implicitly archives them.","locale":"en"},"2074":{"id":"/docs/concepts/how-it-works-24","page_id":"/docs/concepts/how-it-works","tags":[],"type":"text","url":"/docs/concepts/how-it-works#automatic-and-manual-history","content":"A root `transaction()` also groups updates, but additionally hides provisional states from Travels observers and rolls back Travels-tracked changes on failure.","locale":"en"},"2075":{"id":"/docs/concepts/how-it-works-25","page_id":"/docs/concepts/how-it-works","tags":[],"type":"text","url":"/docs/concepts/how-it-works#branches-and-the-redo-boundary","content":"`onBranchDiscard` receives the entries removed by this transition. Transactions report only redo entries visible before the root transaction, not branches created and discarded entirely inside provisional work.","locale":"en"},"2076":{"id":"/docs/concepts/how-it-works-26","page_id":"/docs/concepts/how-it-works","tags":[],"type":"text","url":"/docs/concepts/how-it-works#retained-window-versus-true-baseline","content":"`maxHistory` drops old patches as the timeline advances. The cursor is relative to the retained window, so it remains capped at that limit. `reset()` can still restore the instance’s true baseline even after older entries are trimmed.","locale":"en"},"2077":{"id":"/docs/concepts/how-it-works-27","page_id":"/docs/concepts/how-it-works","tags":[],"type":"text","url":"/docs/concepts/how-it-works#retained-window-versus-true-baseline","content":"`rebase()` is different: it intentionally discards all past and future history and makes current state the new baseline. See History Lifecycle.","locale":"en"},"2078":{"id":"/docs/concepts/how-it-works-28","page_id":"/docs/concepts/how-it-works","tags":[],"type":"text","url":"/docs/concepts/how-it-works#what-persistence-stores","content":"`serialize()` creates one versioned value containing:","locale":"en"},"2079":{"id":"/docs/concepts/how-it-works-29","page_id":"/docs/concepts/how-it-works","tags":[],"type":"text","url":"/docs/concepts/how-it-works#what-persistence-stores","content":"current state;","locale":"en"},"2080":{"id":"/docs/concepts/how-it-works-30","page_id":"/docs/concepts/how-it-works","tags":[],"type":"text","url":"/docs/concepts/how-it-works#what-persistence-stores","content":"forward and inverse patch groups;","locale":"en"},"2081":{"id":"/docs/concepts/how-it-works-31","page_id":"/docs/concepts/how-it-works","tags":[],"type":"text","url":"/docs/concepts/how-it-works#what-persistence-stores","content":"current position;","locale":"en"},"2082":{"id":"/docs/concepts/how-it-works-32","page_id":"/docs/concepts/how-it-works","tags":[],"type":"text","url":"/docs/concepts/how-it-works#what-persistence-stores","content":"optional history metadata;","locale":"en"},"2083":{"id":"/docs/concepts/how-it-works-33","page_id":"/docs/concepts/how-it-works","tags":[],"type":"text","url":"/docs/concepts/how-it-works#what-persistence-stores","content":"the Travels history schema version.","locale":"en"},"2084":{"id":"/docs/concepts/how-it-works-34","page_id":"/docs/concepts/how-it-works","tags":[],"type":"text","url":"/docs/concepts/how-it-works#what-persistence-stores","content":"`Travels.deserialize()` validates that value, and `restoreTravels()` creates a timeline from it atomically. No separate state/history alignment step is required.","locale":"en"},"2085":{"id":"/docs/concepts/state-requirements","page_id":"/docs/concepts/state-requirements","type":"page","content":"State Requirements","breadcrumbs":["Travels","Core Concepts"],"tags":[],"url":"/docs/concepts/state-requirements","locale":"en"},"2086":{"id":"/docs/concepts/state-requirements-0","page_id":"/docs/concepts/state-requirements","tags":[],"type":"text","url":"/docs/concepts/state-requirements","content":"Use state, patch values, paths, and metadata that remain correct through replay and JSON persistence.","locale":"en"},"2087":{"id":"/docs/concepts/state-requirements-1","page_id":"/docs/concepts/state-requirements","type":"heading","tags":[],"url":"/docs/concepts/state-requirements#preferred-durable-data","content":"Preferred durable data","locale":"en"},"2088":{"id":"/docs/concepts/state-requirements-2","page_id":"/docs/concepts/state-requirements","type":"heading","tags":[],"url":"/docs/concepts/state-requirements#compatibility-matrix","content":"Compatibility matrix","locale":"en"},"2089":{"id":"/docs/concepts/state-requirements-3","page_id":"/docs/concepts/state-requirements","type":"heading","tags":[],"url":"/docs/concepts/state-requirements#normalize-collections-at-the-boundary","content":"Normalize collections at the boundary","locale":"en"},"2090":{"id":"/docs/concepts/state-requirements-4","page_id":"/docs/concepts/state-requirements","type":"heading","tags":[],"url":"/docs/concepts/state-requirements#unsafe-path-keys","content":"Unsafe path keys","locale":"en"},"2091":{"id":"/docs/concepts/state-requirements-5","page_id":"/docs/concepts/state-requirements","type":"heading","tags":[],"url":"/docs/concepts/state-requirements#static-and-runtime-checks","content":"Static and runtime checks","locale":"en"},"2092":{"id":"/docs/concepts/state-requirements-6","page_id":"/docs/concepts/state-requirements","type":"heading","tags":[],"url":"/docs/concepts/state-requirements#enforce-the-durable-shape-with-createpatchabletravels","content":"Enforce the durable shape with `createPatchableTravels()`","locale":"en"},"2093":{"id":"/docs/concepts/state-requirements-7","page_id":"/docs/concepts/state-requirements","type":"heading","tags":[],"url":"/docs/concepts/state-requirements#inspect-a-value-directly","content":"Inspect a value directly","locale":"en"},"2094":{"id":"/docs/concepts/state-requirements-8","page_id":"/docs/concepts/state-requirements","type":"heading","tags":[],"url":"/docs/concepts/state-requirements#validate-before-or-during-serialization","content":"Validate before or during serialization","locale":"en"},"2095":{"id":"/docs/concepts/state-requirements-9","page_id":"/docs/concepts/state-requirements","type":"heading","tags":[],"url":"/docs/concepts/state-requirements#development-diagnostics","content":"Development diagnostics","locale":"en"},"2096":{"id":"/docs/concepts/state-requirements-10","page_id":"/docs/concepts/state-requirements","tags":[],"type":"text","url":"/docs/concepts/state-requirements","content":"Travels’ durable contract is deliberately smaller than JavaScript’s object model. It applies to current state, values retained in old patches, patch paths, and custom history metadata—not just the object passed to `createTravels()`.","locale":"en"},"2097":{"id":"/docs/concepts/state-requirements-11","page_id":"/docs/concepts/state-requirements","tags":[],"type":"text","url":"/docs/concepts/state-requirements#preferred-durable-data","content":"Use plain objects, dense arrays, strings, finite numbers other than `-0`, booleans, and `null`. Patch paths must be Travels-accepted JSON Pointer strings or dense arrays of strings and finite non-negative integer indexes.","locale":"en"},"2098":{"id":"/docs/concepts/state-requirements-12","page_id":"/docs/concepts/state-requirements","tags":[],"type":"text","url":"/docs/concepts/state-requirements#preferred-durable-data","content":"Durable containers have normal writable, enumerable data properties and standard prototypes. Avoid accessors, hidden properties, custom own properties, non-extensible containers, array holes, and built-in subclasses. Standard frozen containers are recognized when `enableAutoFreeze` is enabled, but they are not a general durable-data recommendation for caller-created input.","locale":"en"},"2099":{"id":"/docs/concepts/state-requirements-13","page_id":"/docs/concepts/state-requirements","tags":[],"type":"text","url":"/docs/concepts/state-requirements#compatibility-matrix","content":"| Value        | Runtime behavior | JSON persistence | Recommendation |\n| ------------ | ---------------- | ---------------- | -------------- |\n| Plain object | Supported        | Supported        | Preferred      |","locale":"en","table":"table-0"},"2100":{"id":"/docs/concepts/state-requirements-14","page_id":"/docs/concepts/state-requirements","tags":[],"type":"text","url":"/docs/concepts/state-requirements#compatibility-matrix","content":"| Value       | Runtime behavior | JSON persistence | Recommendation |\n| ----------- | ---------------- | ---------------- | -------------- |\n| Dense array | Supported        | Supported        | Preferred      |","locale":"en","table":"table-0"},"2101":{"id":"/docs/concepts/state-requirements-15","page_id":"/docs/concepts/state-requirements","tags":[],"type":"text","url":"/docs/concepts/state-requirements#compatibility-matrix","content":"| Value                                 | Runtime behavior                      | JSON persistence       | Recommendation                   |\n| ------------------------------------- | ------------------------------------- | ---------------------- | -------------------------------- |\n| Sparse, extended, or subclassed array | Limited or rejected by durable checks | Shape is not preserved | Normalize to a dense plain array |","locale":"en","table":"table-0"},"2102":{"id":"/docs/concepts/state-requirements-16","page_id":"/docs/concepts/state-requirements","tags":[],"type":"text","url":"/docs/concepts/state-requirements#compatibility-matrix","content":"| Value                   | Runtime behavior | JSON persistence | Recommendation |\n| ----------------------- | ---------------- | ---------------- | -------------- |\n| String, boolean, `null` | Supported        | Supported        | Preferred      |","locale":"en","table":"table-0"},"2103":{"id":"/docs/concepts/state-requirements-17","page_id":"/docs/concepts/state-requirements","tags":[],"type":"text","url":"/docs/concepts/state-requirements#compatibility-matrix","content":"| Value                         | Runtime behavior | JSON persistence | Recommendation |\n| ----------------------------- | ---------------- | ---------------- | -------------- |\n| Finite number other than `-0` | Supported        | Supported        | Preferred      |","locale":"en","table":"table-0"},"2104":{"id":"/docs/concepts/state-requirements-18","page_id":"/docs/concepts/state-requirements","tags":[],"type":"text","url":"/docs/concepts/state-requirements#compatibility-matrix","content":"| Value                   | Runtime behavior                  | JSON persistence      | Recommendation  |\n| ----------------------- | --------------------------------- | --------------------- | --------------- |\n| `NaN`, infinities, `-0` | Supported in some in-memory paths | Becomes `null` or `0` | Normalize first |","locale":"en","table":"table-0"},"2105":{"id":"/docs/concepts/state-requirements-19","page_id":"/docs/concepts/state-requirements","tags":[],"type":"text","url":"/docs/concepts/state-requirements#compatibility-matrix","content":"| Value    | Runtime behavior                  | JSON persistence          | Recommendation     |\n| -------- | --------------------------------- | ------------------------- | ------------------ |\n| `bigint` | Supported in some in-memory paths | `JSON.stringify()` throws | Encode as a string |","locale":"en","table":"table-0"},"2106":{"id":"/docs/concepts/state-requirements-20","page_id":"/docs/concepts/state-requirements","tags":[],"type":"text","url":"/docs/concepts/state-requirements#compatibility-matrix","content":"| Value       | Runtime behavior    | JSON persistence                             | Recommendation |\n| ----------- | ------------------- | -------------------------------------------- | -------------- |\n| `undefined` | Patchable in memory | Removed from objects; array semantics differ | Use `null`     |","locale":"en","table":"table-0"},"2107":{"id":"/docs/concepts/state-requirements-21","page_id":"/docs/concepts/state-requirements","tags":[],"type":"text","url":"/docs/concepts/state-requirements#compatibility-matrix","content":"| Value  | Runtime behavior       | JSON persistence              | Recommendation                  |\n| ------ | ---------------------- | ----------------------------- | ------------------------------- |\n| `Date` | Cloneable, not durable | Becomes a string through JSON | Store a timestamp or ISO string |","locale":"en","table":"table-0"},"2108":{"id":"/docs/concepts/state-requirements-22","page_id":"/docs/concepts/state-requirements","tags":[],"type":"text","url":"/docs/concepts/state-requirements#compatibility-matrix","content":"| Value         | Runtime behavior               | JSON persistence                | Recommendation              |\n| ------------- | ------------------------------ | ------------------------------- | --------------------------- |\n| `Map` / `Set` | Rejected in both runtime modes | Rejected at snapshot boundaries | Use records or dense arrays |","locale":"en","table":"table-0"},"2109":{"id":"/docs/concepts/state-requirements-23","page_id":"/docs/concepts/state-requirements","tags":[],"type":"text","url":"/docs/concepts/state-requirements#compatibility-matrix","content":"| Value                          | Runtime behavior | JSON persistence               | Recommendation          |\n| ------------------------------ | ---------------- | ------------------------------ | ----------------------- |\n| Class or custom/null prototype | Not durable      | Prototype and methods are lost | Store plain data or IDs |","locale":"en","table":"table-0"},"2110":{"id":"/docs/concepts/state-requirements-24","page_id":"/docs/concepts/state-requirements","tags":[],"type":"text","url":"/docs/concepts/state-requirements#compatibility-matrix","content":"| Value              | Runtime behavior | JSON persistence | Recommendation              |\n| ------------------ | ---------------- | ---------------- | --------------------------- |\n| Function or symbol | Not durable      | Dropped by JSON  | Keep behavior outside state |","locale":"en","table":"table-0"},"2111":{"id":"/docs/concepts/state-requirements-25","page_id":"/docs/concepts/state-requirements","tags":[],"type":"text","url":"/docs/concepts/state-requirements#compatibility-matrix","content":"| Value                             | Runtime behavior | JSON persistence                              | Recommendation   |\n| --------------------------------- | ---------------- | --------------------------------------------- | ---------------- |\n| Circular or shared graph identity | Not durable      | Circular fails; shared identity is duplicated | Normalize to IDs |","locale":"en","table":"table-0"},"2112":{"id":"/docs/concepts/state-requirements-26","page_id":"/docs/concepts/state-requirements","tags":[],"type":"text","url":"/docs/concepts/state-requirements#compatibility-matrix","content":"| Value                          | Runtime behavior | JSON persistence | Recommendation        |\n| ------------------------------ | ---------------- | ---------------- | --------------------- |\n| DOM node, ref, observable body | Not durable      | Not serializable | Store outside Travels |","locale":"en","table":"table-0"},"2113":{"id":"/docs/concepts/state-requirements-27","page_id":"/docs/concepts/state-requirements","tags":[],"type":"text","url":"/docs/concepts/state-requirements#compatibility-matrix","content":"| Value                 | Runtime behavior | JSON persistence | Recommendation        |\n| --------------------- | ---------------- | ---------------- | --------------------- |\n| `WeakMap` / `WeakSet` | Not supported    | Not serializable | Store outside Travels |","locale":"en","table":"table-0"},"2114":{"id":"/docs/concepts/state-requirements-28","page_id":"/docs/concepts/state-requirements","tags":[],"type":"text","url":"/docs/concepts/state-requirements#compatibility-matrix","content":"Primitive roots work, but mutable mode cannot mutate a primitive in place and falls back to immutable replacement. Wrap a primitive in an object when stable root identity matters.","locale":"en"},"2115":{"id":"/docs/concepts/state-requirements-29","page_id":"/docs/concepts/state-requirements","tags":[],"type":"text","url":"/docs/concepts/state-requirements#normalize-collections-at-the-boundary","content":"Keep application-domain Map, Set, Date, or class views outside Travels and derive them from normalized state. Do not replay old collection-specific patch histories after conversion; materialize the authoritative current state, normalize it, and start a new baseline.","locale":"en"},"2116":{"id":"/docs/concepts/state-requirements-30","page_id":"/docs/concepts/state-requirements","tags":[],"type":"text","url":"/docs/concepts/state-requirements#unsafe-path-keys","content":"Mutative will not replay a change under a `__proto__` key or inside a value stored at a `constructor` key. Travels rejects such updates with `UNSUPPORTED_STATE`. Rename those keys before recording history. Root replacement has special handling in mutable and controlled-navigation paths; see the relevant guides before implementing in-place patch application.","locale":"en"},"2117":{"id":"/docs/concepts/state-requirements-31","page_id":"/docs/concepts/state-requirements","tags":[],"type":"text","url":"/docs/concepts/state-requirements#enforce-the-durable-shape-with-createpatchabletravels","content":"`PatchableInput<T>` performs a finite-depth, best-effort static check. TypeScript cannot prove every runtime property: `number` still includes `NaN`, infinities, and `-0`, and broad object types hide their contents. The strict factory therefore also validates its concrete initial value.","locale":"en"},"2118":{"id":"/docs/concepts/state-requirements-32","page_id":"/docs/concepts/state-requirements","tags":[],"type":"text","url":"/docs/concepts/state-requirements#inspect-a-value-directly","content":"Issue codes identify circular/shared references, dates, functions, class instances, DOM nodes, Map/Set, bigint, non-JSON numbers, nonstandard array/object shapes, weak collections, symbols, and undefined values.","locale":"en"},"2119":{"id":"/docs/concepts/state-requirements-33","page_id":"/docs/concepts/state-requirements","tags":[],"type":"text","url":"/docs/concepts/state-requirements#validate-before-or-during-serialization","content":"`assertPersistenceCompatible()` checks current state, retained patch values and paths, and metadata. `serialize({ strict: true })` rejects any value that cannot round-trip through the documented JSON contract. Plain `serialize()` still returns detached data, but it does not normalize runtime-only values for you.","locale":"en"},"2120":{"id":"/docs/concepts/state-requirements-34","page_id":"/docs/concepts/state-requirements","tags":[],"type":"text","url":"/docs/concepts/state-requirements#development-diagnostics","content":"Development builds scan initial and changed state plus retained patches and metadata for known hazards. `warnOnUnsupportedState: false` controls those warnings; it does not enable Map/Set or make invalid persistence safe. `onWarning` receives structured warning codes, and `onObserverError` isolates failures thrown by diagnostic or notification hooks.","locale":"en"},"2121":{"id":"/docs/concepts/state-requirements-35","page_id":"/docs/concepts/state-requirements","tags":[],"type":"text","url":"/docs/concepts/state-requirements#development-diagnostics","content":"The production package’s default entries avoid the full development scanner. Correctness boundaries such as strict serialization, restore validation, controlled patch validation, and Map/Set rejection remain explicit rather than depending on console warnings.","locale":"en"},"2122":{"id":"/docs/getting-started/choosing-travels","page_id":"/docs/getting-started/choosing-travels","type":"page","content":"Choosing Travels","breadcrumbs":["Travels","Getting Started"],"tags":[],"url":"/docs/getting-started/choosing-travels","locale":"en"},"2123":{"id":"/docs/getting-started/choosing-travels-0","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels","content":"Understand when patch-based history is a better fit than snapshots, CRDTs, or a simpler undo stack.","locale":"en"},"2124":{"id":"/docs/getting-started/choosing-travels-1","page_id":"/docs/getting-started/choosing-travels","type":"heading","tags":[],"url":"/docs/getting-started/choosing-travels#choose-by-workload","content":"Choose by workload","locale":"en"},"2125":{"id":"/docs/getting-started/choosing-travels-2","page_id":"/docs/getting-started/choosing-travels","type":"heading","tags":[],"url":"/docs/getting-started/choosing-travels#compare-the-costs","content":"Compare the costs","locale":"en"},"2126":{"id":"/docs/getting-started/choosing-travels-3","page_id":"/docs/getting-started/choosing-travels","type":"heading","tags":[],"url":"/docs/getting-started/choosing-travels#choose-an-ownership-model","content":"Choose an ownership model","locale":"en"},"2127":{"id":"/docs/getting-started/choosing-travels-4","page_id":"/docs/getting-started/choosing-travels","type":"heading","tags":[],"url":"/docs/getting-started/choosing-travels#createtravels","content":"`createTravels()`","locale":"en"},"2128":{"id":"/docs/getting-started/choosing-travels-5","page_id":"/docs/getting-started/choosing-travels","type":"heading","tags":[],"url":"/docs/getting-started/choosing-travels#createtraveljournal","content":"`createTravelJournal()`","locale":"en"},"2129":{"id":"/docs/getting-started/choosing-travels-6","page_id":"/docs/getting-started/choosing-travels","type":"heading","tags":[],"url":"/docs/getting-started/choosing-travels#choose-an-archive-mode","content":"Choose an archive mode","locale":"en"},"2130":{"id":"/docs/getting-started/choosing-travels-7","page_id":"/docs/getting-started/choosing-travels","type":"heading","tags":[],"url":"/docs/getting-started/choosing-travels#a-practical-decision-checklist","content":"A practical decision checklist","locale":"en"},"2131":{"id":"/docs/getting-started/choosing-travels-8","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels","content":"Travels is designed around a specific trade-off: spend work generating and applying patches to reduce retained history size and make complete timelines practical to persist. It is not intended to win every update-latency benchmark.","locale":"en"},"2132":{"id":"/docs/getting-started/choosing-travels-9","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#choose-by-workload","content":"| Scenario                         | Recommended approach                                               |\n| -------------------------------- | ------------------------------------------------------------------ |\n| Large state with localized edits | Travels: retained patches usually avoid repeated full-state copies |","locale":"en","table":"table-0"},"2133":{"id":"/docs/getting-started/choosing-travels-10","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#choose-by-workload","content":"| Scenario                               | Recommended approach                                       |\n| -------------------------------------- | ---------------------------------------------------------- |\n| Long history that must survive reloads | Travels: one versioned snapshot includes state and history |","locale":"en","table":"table-0"},"2134":{"id":"/docs/getting-started/choosing-travels-11","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#choose-by-workload","content":"| Scenario                                   | Recommended approach                                          |\n| ------------------------------------------ | ------------------------------------------------------------- |\n| Replayable operation logs or undo metadata | Travels: entries contain forward/inverse patches and metadata |","locale":"en","table":"table-0"},"2135":{"id":"/docs/getting-started/choosing-travels-12","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#choose-by-workload","content":"| Scenario                                       | Recommended approach                                             |\n| ---------------------------------------------- | ---------------------------------------------------------------- |\n| Tiny state and a handful of local-only entries | A snapshot stack, Redux-undo, or Zundo may be simpler and faster |","locale":"en","table":"table-0"},"2136":{"id":"/docs/getting-started/choosing-travels-13","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#choose-by-workload","content":"| Scenario                                | Recommended approach                                        |\n| --------------------------------------- | ----------------------------------------------------------- |\n| Replace most or all state on every edit | Measure both approaches; patches can approach snapshot cost |","locale":"en","table":"table-0"},"2137":{"id":"/docs/getting-started/choosing-travels-14","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#choose-by-workload","content":"| Scenario                                            | Recommended approach                                           |\n| --------------------------------------------------- | -------------------------------------------------------------- |\n| Collaborative conflict merging and concurrent users | A CRDT/OT system; Travels does not resolve conflicts by itself |","locale":"en","table":"table-0"},"2138":{"id":"/docs/getting-started/choosing-travels-15","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#compare-the-costs","content":"A snapshot history pays a state-copy cost for every entry and usually has cheap navigation. A patch history pays patch-generation and patch-application costs, while retaining only the changed operations for localized updates.","locale":"en"},"2139":{"id":"/docs/getting-started/choosing-travels-16","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#compare-the-costs","content":"With Travels, immutable updates also use Mutative’s structural sharing. “Patch-based” does not mean every retained state is deep-cloned, and “smaller history” does not imply the lowest possible `setState()` latency.","locale":"en"},"2140":{"id":"/docs/getting-started/choosing-travels-17","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#compare-the-costs","content":"Measure your actual workload across four dimensions:","locale":"en"},"2141":{"id":"/docs/getting-started/choosing-travels-18","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#compare-the-costs","content":"Update latency and throughput.","locale":"en"},"2142":{"id":"/docs/getting-started/choosing-travels-19","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#compare-the-costs","content":"Undo/redo and transaction latency.","locale":"en"},"2143":{"id":"/docs/getting-started/choosing-travels-20","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#compare-the-costs","content":"Retained and serialized history size.","locale":"en"},"2144":{"id":"/docs/getting-started/choosing-travels-21","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#compare-the-costs","content":"Save, restore, and semantic-validation cost.","locale":"en"},"2145":{"id":"/docs/getting-started/choosing-travels-22","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#compare-the-costs","content":"The repository’s benchmark suite separates these concerns rather than presenting a single universal winner.","locale":"en"},"2146":{"id":"/docs/getting-started/choosing-travels-23","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#createtravels","content":"Use this when Travels should receive and commit updates. It is the default choice for vanilla state, reducer-style state, and most new integrations.","locale":"en"},"2147":{"id":"/docs/getting-started/choosing-travels-24","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#createtravels","content":"Immutable mode returns new state references.","locale":"en"},"2148":{"id":"/docs/getting-started/choosing-travels-25","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#createtravels","content":"Mutable mode updates a live object for MobX, Vue, Pinia, and similar reactive owners.","locale":"en"},"2149":{"id":"/docs/getting-started/choosing-travels-26","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#createtravels","content":"`setState()`, transactions, tracking controls, and `getControls()` are available.","locale":"en"},"2150":{"id":"/docs/getting-started/choosing-travels-27","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#createtraveljournal","content":"Use this when another runtime already produces `nextState`, `patches`, and `inversePatches`. The external owner remains authoritative.","locale":"en"},"2151":{"id":"/docs/getting-started/choosing-travels-28","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#createtraveljournal","content":"Record an existing commit with `recordPatches()`.","locale":"en"},"2152":{"id":"/docs/getting-started/choosing-travels-29","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#createtraveljournal","content":"Apply undo/redo through the required synchronous `apply` callback.","locale":"en"},"2153":{"id":"/docs/getting-started/choosing-travels-30","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#createtraveljournal","content":"Avoid generating the same patches twice.","locale":"en"},"2154":{"id":"/docs/getting-started/choosing-travels-31","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#createtraveljournal","content":"Do not feed delegated navigation back into `recordPatches()`.","locale":"en"},"2155":{"id":"/docs/getting-started/choosing-travels-32","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#createtraveljournal","content":"See the Controlled Journal Guide for the commit and failure boundaries.","locale":"en"},"2156":{"id":"/docs/getting-started/choosing-travels-33","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#choose-an-archive-mode","content":"**Automatic (`autoArchive: true`)**: each effective `setState()` call is one undo step. This is the default and the right starting point for most apps.","locale":"en"},"2157":{"id":"/docs/getting-started/choosing-travels-34","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#choose-an-archive-mode","content":"**Manual (`autoArchive: false`)**: updates affect current state immediately, while `archive()` groups pending work into an entry. Use it for blur commits, drag gestures, or application-defined transactions.","locale":"en"},"2158":{"id":"/docs/getting-started/choosing-travels-35","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#choose-an-archive-mode","content":"For a single atomic operation with one final observer event, prefer `transaction()` over manually coordinating an archive.","locale":"en"},"2159":{"id":"/docs/getting-started/choosing-travels-36","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#a-practical-decision-checklist","content":"Travels is likely a strong fit when most answers are yes:","locale":"en"},"2160":{"id":"/docs/getting-started/choosing-travels-37","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#a-practical-decision-checklist","content":"Is undo/redo a product feature rather than a debugging convenience?","locale":"en"},"2161":{"id":"/docs/getting-started/choosing-travels-38","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#a-practical-decision-checklist","content":"Are updates usually smaller than the complete state?","locale":"en"},"2162":{"id":"/docs/getting-started/choosing-travels-39","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#a-practical-decision-checklist","content":"Does history need metadata, persistence, or replay?","locale":"en"},"2163":{"id":"/docs/getting-started/choosing-travels-40","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#a-practical-decision-checklist","content":"Would a versioned snapshot simplify local-first storage?","locale":"en"},"2164":{"id":"/docs/getting-started/choosing-travels-41","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#a-practical-decision-checklist","content":"Do you need both immutable and reference-stable reactive integrations?","locale":"en"},"2165":{"id":"/docs/getting-started/choosing-travels-42","page_id":"/docs/getting-started/choosing-travels","tags":[],"type":"text","url":"/docs/getting-started/choosing-travels#a-practical-decision-checklist","content":"If your only requirement is a five-entry counter history in one component, a small local stack is probably enough.","locale":"en"},"2166":{"id":"/docs/getting-started/installation","page_id":"/docs/getting-started/installation","type":"page","content":"Installation","breadcrumbs":["Travels","Getting Started"],"tags":[],"url":"/docs/getting-started/installation","locale":"en"},"2167":{"id":"/docs/getting-started/installation-0","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation","content":"Install Travels 3 and Mutative 2 in a TypeScript or JavaScript application.","locale":"en"},"2168":{"id":"/docs/getting-started/installation-1","page_id":"/docs/getting-started/installation","type":"heading","tags":[],"url":"/docs/getting-started/installation#requirements","content":"Requirements","locale":"en"},"2169":{"id":"/docs/getting-started/installation-2","page_id":"/docs/getting-started/installation","type":"heading","tags":[],"url":"/docs/getting-started/installation#install-the-packages","content":"Install the packages","locale":"en"},"2170":{"id":"/docs/getting-started/installation-3","page_id":"/docs/getting-started/installation","type":"heading","tags":[],"url":"/docs/getting-started/installation#verify-the-installation","content":"Verify the installation","locale":"en"},"2171":{"id":"/docs/getting-started/installation-4","page_id":"/docs/getting-started/installation","type":"heading","tags":[],"url":"/docs/getting-started/installation#optional-official-bindings","content":"Optional official bindings","locale":"en"},"2172":{"id":"/docs/getting-started/installation-5","page_id":"/docs/getting-started/installation","type":"heading","tags":[],"url":"/docs/getting-started/installation#browser-bundling-note","content":"Browser bundling note","locale":"en"},"2173":{"id":"/docs/getting-started/installation-6","page_id":"/docs/getting-started/installation","type":"heading","tags":[],"url":"/docs/getting-started/installation#next-step","content":"Next step","locale":"en"},"2174":{"id":"/docs/getting-started/installation-7","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#requirements","content":"**Node.js 22 or newer** for server-side use and repository tooling.","locale":"en"},"2175":{"id":"/docs/getting-started/installation-8","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#requirements","content":"A **modern browser** with standard JavaScript and JSON APIs for browser applications.","locale":"en"},"2176":{"id":"/docs/getting-started/installation-9","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#requirements","content":"**Mutative 2** as Travels’ peer dependency.","locale":"en"},"2177":{"id":"/docs/getting-started/installation-10","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#requirements","content":"A bundler that defines `process.env.NODE_ENV`, or an explicit production Mutative browser build when loading ES modules without a bundler.","locale":"en"},"2178":{"id":"/docs/getting-started/installation-11","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#requirements","content":"Travels ships ESM, CommonJS, UMD, and TypeScript declarations. The runtime support policy is documented under Compatibility.","locale":"en"},"2179":{"id":"/docs/getting-started/installation-12","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#install-the-packages","content":"Install matching major versions: `travels@3` requires `mutative@^2.0.0`. Mutative 1 is not supported.","locale":"en"},"2180":{"id":"/docs/getting-started/installation-13","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#verify-the-installation","content":"Create a small timeline and make one reversible edit:","locale":"en"},"2181":{"id":"/docs/getting-started/installation-14","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#verify-the-installation","content":"`createTravels()` is the public factory. The exported `Travels` value is a persistence namespace, not a constructor; use `isTravels()` rather than `instanceof Travels` when detecting timelines.","locale":"en"},"2182":{"id":"/docs/getting-started/installation-15","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#optional-official-bindings","content":"Use the core API directly when you need framework-agnostic ownership, persistence, or custom integration. For a more idiomatic binding, install the matching v3 package:","locale":"en"},"2183":{"id":"/docs/getting-started/installation-16","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#optional-official-bindings","content":"| Binding      | Purpose                                         | Travels compatibility |\n| ------------ | ----------------------------------------------- | --------------------- |\n| `use-travel` | React hooks and shared external-store timelines | `^3.0.0`              |","locale":"en","table":"table-0"},"2184":{"id":"/docs/getting-started/installation-17","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#optional-official-bindings","content":"| Binding          | Purpose                        | Travels compatibility |\n| ---------------- | ------------------------------ | --------------------- |\n| `zustand-travel` | Zustand time-travel middleware | `^3.0.1`              |","locale":"en","table":"table-0"},"2185":{"id":"/docs/getting-started/installation-18","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#browser-bundling-note","content":"Mutative 2 targets ES2018 and selects development or production code through `process.env.NODE_ENV`. Vite, webpack, and comparable bundlers normally handle this. Without a bundler, use `mutative/dist/mutative.esm.production.min.mjs` or Mutative’s UMD build so the browser does not need a `process` global.","locale":"en"},"2186":{"id":"/docs/getting-started/installation-19","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#browser-bundling-note","content":"Load the UMD scripts in this order to use Travels directly in a browser page.","locale":"en"},"2187":{"id":"/docs/getting-started/installation-20","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#browser-bundling-note","content":"With these 3.0.1 scripts, validate a stored snapshot before restoring it with `Travels.restoreTravels(Travels.Travels.deserialize(stored, { validation: 'semantic' }))`.","locale":"en"},"2188":{"id":"/docs/getting-started/installation-21","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#browser-bundling-note","content":"Plain objects, dense arrays, strings, finite numbers other than `-0`, booleans, and `null` form the durable state contract. Map and Set are rejected. Normalize dates, class instances, non-JSON numbers, functions, refs, and other runtime-only values before persistence. See State Requirements.","locale":"en"},"2189":{"id":"/docs/getting-started/installation-22","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#next-step","content":"Follow the Quick Start to add subscriptions, metadata, undo/redo controls, and persistence.","locale":"en"},"2190":{"id":"/docs/getting-started/quick-start","page_id":"/docs/getting-started/quick-start","type":"page","content":"Quick Start","breadcrumbs":["Travels","Getting Started"],"tags":[],"url":"/docs/getting-started/quick-start","locale":"en"},"2191":{"id":"/docs/getting-started/quick-start-0","page_id":"/docs/getting-started/quick-start","tags":[],"type":"text","url":"/docs/getting-started/quick-start","content":"Create a timeline, record edits, navigate history, and restore a snapshot.","locale":"en"},"2192":{"id":"/docs/getting-started/quick-start-1","page_id":"/docs/getting-started/quick-start","type":"heading","tags":[],"url":"/docs/getting-started/quick-start#1-create-a-timeline","content":"1. Create a timeline","locale":"en"},"2193":{"id":"/docs/getting-started/quick-start-2","page_id":"/docs/getting-started/quick-start","type":"heading","tags":[],"url":"/docs/getting-started/quick-start#2-record-an-edit","content":"2. Record an edit","locale":"en"},"2194":{"id":"/docs/getting-started/quick-start-3","page_id":"/docs/getting-started/quick-start","type":"heading","tags":[],"url":"/docs/getting-started/quick-start#3-observe-committed-changes","content":"3. Observe committed changes","locale":"en"},"2195":{"id":"/docs/getting-started/quick-start-4","page_id":"/docs/getting-started/quick-start","type":"heading","tags":[],"url":"/docs/getting-started/quick-start#4-add-undo-redo-and-navigation","content":"4. Add undo, redo, and navigation","locale":"en"},"2196":{"id":"/docs/getting-started/quick-start-5","page_id":"/docs/getting-started/quick-start","type":"heading","tags":[],"url":"/docs/getting-started/quick-start#5-group-one-logical-operation","content":"5. Group one logical operation","locale":"en"},"2197":{"id":"/docs/getting-started/quick-start-6","page_id":"/docs/getting-started/quick-start","type":"heading","tags":[],"url":"/docs/getting-started/quick-start#6-save-and-restore-the-timeline","content":"6. Save and restore the timeline","locale":"en"},"2198":{"id":"/docs/getting-started/quick-start-7","page_id":"/docs/getting-started/quick-start","type":"heading","tags":[],"url":"/docs/getting-started/quick-start#7-keep-exploring","content":"7. Keep exploring","locale":"en"},"2199":{"id":"/docs/getting-started/quick-start-8","page_id":"/docs/getting-started/quick-start","tags":[],"type":"text","url":"/docs/getting-started/quick-start","content":"This guide builds a small document editor history. The same API works in vanilla JavaScript, TypeScript, and framework integrations.","locale":"en"},"2200":{"id":"/docs/getting-started/quick-start-9","page_id":"/docs/getting-started/quick-start","tags":[],"type":"text","url":"/docs/getting-started/quick-start#1-create-a-timeline","content":"Pass the initial state and, optionally, the maximum number of retained patch entries:","locale":"en"},"2201":{"id":"/docs/getting-started/quick-start-10","page_id":"/docs/getting-started/quick-start","tags":[],"type":"text","url":"/docs/getting-started/quick-start#1-create-a-timeline","content":"The initial state is the baseline at position `0`. `maxHistory` limits retained transitions, not the number of states returned by `getHistory()`; a window of 100 patches can expose 101 states.","locale":"en"},"2202":{"id":"/docs/getting-started/quick-start-11","page_id":"/docs/getting-started/quick-start","tags":[],"type":"text","url":"/docs/getting-started/quick-start#2-record-an-edit","content":"Use a draft recipe for the most natural update style:","locale":"en"},"2203":{"id":"/docs/getting-started/quick-start-12","page_id":"/docs/getting-started/quick-start","tags":[],"type":"text","url":"/docs/getting-started/quick-start#2-record-an-edit","content":"Travels commits one immutable state, stores forward and inverse patches, advances the cursor, and notifies subscribers. Metadata is attached to the history entry and included in persistence snapshots.","locale":"en"},"2204":{"id":"/docs/getting-started/quick-start-13","page_id":"/docs/getting-started/quick-start","tags":[],"type":"text","url":"/docs/getting-started/quick-start#2-record-an-edit","content":"You can also provide a direct value or return a new state. Updaters must be synchronous:","locale":"en"},"2205":{"id":"/docs/getting-started/quick-start-14","page_id":"/docs/getting-started/quick-start","tags":[],"type":"text","url":"/docs/getting-started/quick-start#2-record-an-edit","content":"No-op updates that produce no patches do not create an entry or publish an event.","locale":"en"},"2206":{"id":"/docs/getting-started/quick-start-15","page_id":"/docs/getting-started/quick-start","tags":[],"type":"text","url":"/docs/getting-started/quick-start#3-observe-committed-changes","content":"Subscribe once and clean up when the owner is disposed:","locale":"en"},"2207":{"id":"/docs/getting-started/quick-start-16","page_id":"/docs/getting-started/quick-start","tags":[],"type":"text","url":"/docs/getting-started/quick-start#3-observe-committed-changes","content":"Events are published after the timeline commits. Treat `event.state`, `event.patches`, and `event.metadata` as read-only. Do not synchronously call mutating Travels APIs from an observer; schedule follow-up work for a later task.","locale":"en"},"2208":{"id":"/docs/getting-started/quick-start-17","page_id":"/docs/getting-started/quick-start","tags":[],"type":"text","url":"/docs/getting-started/quick-start#4-add-undo-redo-and-navigation","content":"For UI components that need navigation but should not receive the full state-owning instance, use the cached controls facade:","locale":"en"},"2209":{"id":"/docs/getting-started/quick-start-18","page_id":"/docs/getting-started/quick-start","tags":[],"type":"text","url":"/docs/getting-started/quick-start#4-add-undo-redo-and-navigation","content":"A committed edit after undo discards the redo branch. Use `onBranchDiscard` when the application needs to observe that cleanup.","locale":"en"},"2210":{"id":"/docs/getting-started/quick-start-19","page_id":"/docs/getting-started/quick-start","tags":[],"type":"text","url":"/docs/getting-started/quick-start#5-group-one-logical-operation","content":"Use a transaction when several updates should become one undo step and observers should see only the settled result:","locale":"en"},"2211":{"id":"/docs/getting-started/quick-start-20","page_id":"/docs/getting-started/quick-start","tags":[],"type":"text","url":"/docs/getting-started/quick-start#5-group-one-logical-operation","content":"`batch()` is an alias for `transaction()`. Transaction callbacks must be synchronous; failures roll back changes made through Travels APIs. Learn more in Transactions.","locale":"en"},"2212":{"id":"/docs/getting-started/quick-start-21","page_id":"/docs/getting-started/quick-start","tags":[],"type":"text","url":"/docs/getting-started/quick-start#6-save-and-restore-the-timeline","content":"The snapshot contains current state, retained forward and inverse patches, position, schema version, and optional metadata. `serialize()` returns detached data; it does not write to storage or call `JSON.stringify()` itself.","locale":"en"},"2213":{"id":"/docs/getting-started/quick-start-22","page_id":"/docs/getting-started/quick-start","tags":[],"type":"text","url":"/docs/getting-started/quick-start#6-save-and-restore-the-timeline","content":"Structural validation is the fast default and checks schema and patch shape. Semantic validation additionally replays the reachable history in both directions. Use it for browser storage or other input that has not crossed a trusted verification boundary.","locale":"en"},"2214":{"id":"/docs/getting-started/quick-start-23","page_id":"/docs/getting-started/quick-start","tags":[],"type":"text","url":"/docs/getting-started/quick-start#7-keep-exploring","content":"<Card title=\"Connect React or another framework\" href=\"/docs/integrations\" />","locale":"en"},"2215":{"id":"/docs/getting-started/quick-start-24","page_id":"/docs/getting-started/quick-start","tags":[],"type":"text","url":"/docs/getting-started/quick-start#7-keep-exploring","content":"<Card title=\"Choose automatic or manual archives\" href=\"/docs/guides/archive-mode\" />","locale":"en"},"2216":{"id":"/docs/getting-started/quick-start-25","page_id":"/docs/getting-started/quick-start","tags":[],"type":"text","url":"/docs/getting-started/quick-start#7-keep-exploring","content":"<Card title=\"Build a production persistence adapter\" href=\"/docs/persistence/storage-adapters\" />","locale":"en"},"2217":{"id":"/docs/getting-started/quick-start-26","page_id":"/docs/getting-started/quick-start","tags":[],"type":"text","url":"/docs/getting-started/quick-start#7-keep-exploring","content":"<Card title=\"Review every instance method\" href=\"/docs/reference/instance-methods\" />","locale":"en"},"2218":{"id":"/docs/guides/advanced-patterns","page_id":"/docs/guides/advanced-patterns","type":"page","content":"Advanced Patterns","breadcrumbs":["Travels","Guides"],"tags":[],"url":"/docs/guides/advanced-patterns","locale":"en"},"2219":{"id":"/docs/guides/advanced-patterns-0","page_id":"/docs/guides/advanced-patterns","tags":[],"type":"text","url":"/docs/guides/advanced-patterns","content":"Extend Travels with validation, permissions, metadata, logging, and composable wrappers.","locale":"en"},"2220":{"id":"/docs/guides/advanced-patterns-1","page_id":"/docs/guides/advanced-patterns","type":"heading","tags":[],"url":"/docs/guides/advanced-patterns#table-of-contents","content":"Table of Contents","locale":"en"},"2221":{"id":"/docs/guides/advanced-patterns-2","page_id":"/docs/guides/advanced-patterns","type":"heading","tags":[],"url":"/docs/guides/advanced-patterns#intercepting-and-modifying-operations","content":"Intercepting and Modifying Operations","locale":"en"},"2222":{"id":"/docs/guides/advanced-patterns-3","page_id":"/docs/guides/advanced-patterns","type":"heading","tags":[],"url":"/docs/guides/advanced-patterns#adding-validation","content":"Adding validation:","locale":"en"},"2223":{"id":"/docs/guides/advanced-patterns-4","page_id":"/docs/guides/advanced-patterns","type":"heading","tags":[],"url":"/docs/guides/advanced-patterns#adding-permission-checks","content":"Adding Permission Checks","locale":"en"},"2224":{"id":"/docs/guides/advanced-patterns-5","page_id":"/docs/guides/advanced-patterns","type":"heading","tags":[],"url":"/docs/guides/advanced-patterns#automatically-adding-metadata-to-state-changes","content":"Automatically Adding Metadata to State Changes","locale":"en"},"2225":{"id":"/docs/guides/advanced-patterns-6","page_id":"/docs/guides/advanced-patterns","type":"heading","tags":[],"url":"/docs/guides/advanced-patterns#implementing-operation-logging-and-auditing","content":"Implementing Operation Logging and Auditing","locale":"en"},"2226":{"id":"/docs/guides/advanced-patterns-7","page_id":"/docs/guides/advanced-patterns","type":"heading","tags":[],"url":"/docs/guides/advanced-patterns#implementing-rate-limiting-and-throttling","content":"Implementing Rate Limiting and Throttling","locale":"en"},"2227":{"id":"/docs/guides/advanced-patterns-8","page_id":"/docs/guides/advanced-patterns","type":"heading","tags":[],"url":"/docs/guides/advanced-patterns#composing-multiple-wrappers","content":"Composing Multiple Wrappers","locale":"en"},"2228":{"id":"/docs/guides/advanced-patterns-9","page_id":"/docs/guides/advanced-patterns","type":"heading","tags":[],"url":"/docs/guides/advanced-patterns#detecting-history-overflow","content":"Detecting History Overflow","locale":"en"},"2229":{"id":"/docs/guides/advanced-patterns-10","page_id":"/docs/guides/advanced-patterns","type":"heading","tags":[],"url":"/docs/guides/advanced-patterns#common-patterns","content":"Common Patterns","locale":"en"},"2230":{"id":"/docs/guides/advanced-patterns-11","page_id":"/docs/guides/advanced-patterns","type":"heading","tags":[],"url":"/docs/guides/advanced-patterns#back-to-main-documentation","content":"Back to Main Documentation","locale":"en"},"2231":{"id":"/docs/guides/advanced-patterns-12","page_id":"/docs/guides/advanced-patterns","tags":[],"type":"text","url":"/docs/guides/advanced-patterns","content":"You can enhance Travels by wrapping its methods to add validation, permissions, logging, or other custom behavior.","locale":"en"},"2232":{"id":"/docs/guides/advanced-patterns-13","page_id":"/docs/guides/advanced-patterns","tags":[],"type":"text","url":"/docs/guides/advanced-patterns#table-of-contents","content":"Intercepting and Modifying Operations","locale":"en"},"2233":{"id":"/docs/guides/advanced-patterns-14","page_id":"/docs/guides/advanced-patterns","tags":[],"type":"text","url":"/docs/guides/advanced-patterns#table-of-contents","content":"Adding Permission Checks","locale":"en"},"2234":{"id":"/docs/guides/advanced-patterns-15","page_id":"/docs/guides/advanced-patterns","tags":[],"type":"text","url":"/docs/guides/advanced-patterns#table-of-contents","content":"Automatically Adding Metadata","locale":"en"},"2235":{"id":"/docs/guides/advanced-patterns-16","page_id":"/docs/guides/advanced-patterns","tags":[],"type":"text","url":"/docs/guides/advanced-patterns#table-of-contents","content":"Implementing Operation Logging and Auditing","locale":"en"},"2236":{"id":"/docs/guides/advanced-patterns-17","page_id":"/docs/guides/advanced-patterns","tags":[],"type":"text","url":"/docs/guides/advanced-patterns#table-of-contents","content":"Implementing Rate Limiting and Throttling","locale":"en"},"2237":{"id":"/docs/guides/advanced-patterns-18","page_id":"/docs/guides/advanced-patterns","tags":[],"type":"text","url":"/docs/guides/advanced-patterns#table-of-contents","content":"Composing Multiple Wrappers","locale":"en"},"2238":{"id":"/docs/guides/advanced-patterns-19","page_id":"/docs/guides/advanced-patterns","tags":[],"type":"text","url":"/docs/guides/advanced-patterns#table-of-contents","content":"Detecting History Overflow","locale":"en"},"2239":{"id":"/docs/guides/advanced-patterns-20","page_id":"/docs/guides/advanced-patterns","tags":[],"type":"text","url":"/docs/guides/advanced-patterns#table-of-contents","content":"Common Patterns","locale":"en"},"2240":{"id":"/docs/guides/advanced-patterns-21","page_id":"/docs/guides/advanced-patterns","tags":[],"type":"text","url":"/docs/guides/advanced-patterns#intercepting-and-modifying-operations","content":"While `subscribe()` lets you observe state changes, it cannot prevent or modify operations. To add validation, permissions, or transform data before execution, wrap the Travels methods.","locale":"en"},"2241":{"id":"/docs/guides/advanced-patterns-22","page_id":"/docs/guides/advanced-patterns","tags":[],"type":"text","url":"/docs/guides/advanced-patterns#intercepting-and-modifying-operations","content":"A `setState()` wrapper must keep both halves of the contract it replaces: pass the optional second `metadata` argument on, or the labels callers attach to history entries are lost, and let a function updater either mutate the draft or return a new state. Every example below does both.","locale":"en"},"2242":{"id":"/docs/guides/advanced-patterns-23","page_id":"/docs/guides/advanced-patterns","tags":[],"type":"text","url":"/docs/guides/advanced-patterns#intercepting-and-modifying-operations","content":"`replaceStateWithoutHistory()` applies its update through `setState()`, so a `setState()` wrapper runs for it too. It clears the history unless that call throws, so a wrapper that blocks an update by returning early, as the validation and throttling examples do, keeps the old state but leaves nothing to undo. To block a replacement and keep the history, throw instead, as `withValidation()` under Common Patterns does; `replaceStateWithoutHistory()` then throws the same error.","locale":"en"},"2243":{"id":"/docs/guides/advanced-patterns-24","page_id":"/docs/guides/advanced-patterns","tags":[],"type":"text","url":"/docs/guides/advanced-patterns#adding-permission-checks","content":"Wrap methods to verify permissions before allowing execution:","locale":"en"},"2244":{"id":"/docs/guides/advanced-patterns-25","page_id":"/docs/guides/advanced-patterns","tags":[],"type":"text","url":"/docs/guides/advanced-patterns#automatically-adding-metadata-to-state-changes","content":"Wrap `setState` to inject metadata like timestamps or user IDs into the state. To label the history entry instead, add your fields to the `metadata` argument the wrapper forwards, which `getMetadata()` returns for each entry.","locale":"en"},"2245":{"id":"/docs/guides/advanced-patterns-26","page_id":"/docs/guides/advanced-patterns","tags":[],"type":"text","url":"/docs/guides/advanced-patterns#implementing-operation-logging-and-auditing","content":"Wrap methods to record all operations before and after execution:","locale":"en"},"2246":{"id":"/docs/guides/advanced-patterns-27","page_id":"/docs/guides/advanced-patterns","tags":[],"type":"text","url":"/docs/guides/advanced-patterns#implementing-rate-limiting-and-throttling","content":"Wrap methods to control how frequently they can be called:","locale":"en"},"2247":{"id":"/docs/guides/advanced-patterns-28","page_id":"/docs/guides/advanced-patterns","tags":[],"type":"text","url":"/docs/guides/advanced-patterns#composing-multiple-wrappers","content":"Create a reusable function that applies multiple enhancements:","locale":"en"},"2248":{"id":"/docs/guides/advanced-patterns-29","page_id":"/docs/guides/advanced-patterns","tags":[],"type":"text","url":"/docs/guides/advanced-patterns#detecting-history-overflow","content":"Use `subscribe()` to detect when history reaches the maximum limit:","locale":"en"},"2249":{"id":"/docs/guides/advanced-patterns-30","page_id":"/docs/guides/advanced-patterns","tags":[],"type":"text","url":"/docs/guides/advanced-patterns#common-patterns","content":"Here are some reusable wrapper patterns:","locale":"en"},"2250":{"id":"/docs/guides/advanced-patterns-31","page_id":"/docs/guides/advanced-patterns","tags":[],"type":"text","url":"/docs/guides/advanced-patterns#back-to-main-documentation","content":"See the main README for basic usage, API reference, and getting started guide.","locale":"en"},"2251":{"id":"/docs/guides/archive-mode","page_id":"/docs/guides/archive-mode","type":"page","content":"Archive Mode","breadcrumbs":["Travels","Guides"],"tags":[],"url":"/docs/guides/archive-mode","locale":"en"},"2252":{"id":"/docs/guides/archive-mode-0","page_id":"/docs/guides/archive-mode","tags":[],"type":"text","url":"/docs/guides/archive-mode","content":"Choose automatic entries or explicitly group pending updates with manual archives.","locale":"en"},"2253":{"id":"/docs/guides/archive-mode-1","page_id":"/docs/guides/archive-mode","type":"heading","tags":[],"url":"/docs/guides/archive-mode#automatic-archive--the-default","content":"Automatic archive — the default","locale":"en"},"2254":{"id":"/docs/guides/archive-mode-2","page_id":"/docs/guides/archive-mode","type":"heading","tags":[],"url":"/docs/guides/archive-mode#manual-archive","content":"Manual archive","locale":"en"},"2255":{"id":"/docs/guides/archive-mode-3","page_id":"/docs/guides/archive-mode","type":"heading","tags":[],"url":"/docs/guides/archive-mode#metadata-selection","content":"Metadata selection","locale":"en"},"2256":{"id":"/docs/guides/archive-mode-4","page_id":"/docs/guides/archive-mode","type":"heading","tags":[],"url":"/docs/guides/archive-mode#navigation-implicitly-archives-pending-work","content":"Navigation implicitly archives pending work","locale":"en"},"2257":{"id":"/docs/guides/archive-mode-5","page_id":"/docs/guides/archive-mode","type":"heading","tags":[],"url":"/docs/guides/archive-mode#transactions-in-manual-mode","content":"Transactions in manual mode","locale":"en"},"2258":{"id":"/docs/guides/archive-mode-6","page_id":"/docs/guides/archive-mode","type":"heading","tags":[],"url":"/docs/guides/archive-mode#cancelled-pending-changes","content":"Cancelled pending changes","locale":"en"},"2259":{"id":"/docs/guides/archive-mode-7","page_id":"/docs/guides/archive-mode","type":"heading","tags":[],"url":"/docs/guides/archive-mode#automatic-versus-manual","content":"Automatic versus manual","locale":"en"},"2260":{"id":"/docs/guides/archive-mode-8","page_id":"/docs/guides/archive-mode","tags":[],"type":"text","url":"/docs/guides/archive-mode","content":"The archive mode defines when effective state changes become undoable history entries. It does not change when current state updates: pending manual edits are already visible in current state.","locale":"en"},"2261":{"id":"/docs/guides/archive-mode-9","page_id":"/docs/guides/archive-mode","tags":[],"type":"text","url":"/docs/guides/archive-mode#automatic-archive--the-default","content":"Use automatic mode when each call represents one complete user action. No-op updates do not create entries. Automatic timelines omit `archive()` and `canArchive()` at runtime and in TypeScript.","locale":"en"},"2262":{"id":"/docs/guides/archive-mode-10","page_id":"/docs/guides/archive-mode","tags":[],"type":"text","url":"/docs/guides/archive-mode#manual-archive","content":"Manual mode is useful for:","locale":"en"},"2263":{"id":"/docs/guides/archive-mode-11","page_id":"/docs/guides/archive-mode","tags":[],"type":"text","url":"/docs/guides/archive-mode#manual-archive","content":"committing a field group on blur or save;","locale":"en"},"2264":{"id":"/docs/guides/archive-mode-12","page_id":"/docs/guides/archive-mode","tags":[],"type":"text","url":"/docs/guides/archive-mode#manual-archive","content":"treating a drag gesture as one step;","locale":"en"},"2265":{"id":"/docs/guides/archive-mode-13","page_id":"/docs/guides/archive-mode","tags":[],"type":"text","url":"/docs/guides/archive-mode#manual-archive","content":"letting an external form manager define the undo boundary;","locale":"en"},"2266":{"id":"/docs/guides/archive-mode-14","page_id":"/docs/guides/archive-mode","tags":[],"type":"text","url":"/docs/guides/archive-mode#manual-archive","content":"composing updates without immediately exposing separate undo entries.","locale":"en"},"2267":{"id":"/docs/guides/archive-mode-15","page_id":"/docs/guides/archive-mode","tags":[],"type":"text","url":"/docs/guides/archive-mode#metadata-selection","content":"`archive(metadata?)` accepts the entry’s final metadata. If omitted, Travels uses the latest metadata supplied to pending `setState()` calls.","locale":"en"},"2268":{"id":"/docs/guides/archive-mode-16","page_id":"/docs/guides/archive-mode","tags":[],"type":"text","url":"/docs/guides/archive-mode#metadata-selection","content":"Keep metadata durable when persisting history.","locale":"en"},"2269":{"id":"/docs/guides/archive-mode-17","page_id":"/docs/guides/archive-mode","tags":[],"type":"text","url":"/docs/guides/archive-mode#navigation-implicitly-archives-pending-work","content":"Calling `back()`, `forward()`, or `go()` with pending manual changes archives them as part of navigation so cursor positions remain meaningful. The archive and movement commit as one observable transition.","locale":"en"},"2270":{"id":"/docs/guides/archive-mode-18","page_id":"/docs/guides/archive-mode","tags":[],"type":"text","url":"/docs/guides/archive-mode#navigation-implicitly-archives-pending-work","content":"In Travels 3 this publishes one `go` event and advances `getRevision()` once. Persist from every committed event, not only from `archive` events.","locale":"en"},"2271":{"id":"/docs/guides/archive-mode-19","page_id":"/docs/guides/archive-mode","tags":[],"type":"text","url":"/docs/guides/archive-mode#transactions-in-manual-mode","content":"A root `transaction()` archives when it commits. Changes already pending before the transaction join its entry, so undo reverts them together. Transaction metadata takes precedence; without it, the latest pending update metadata is used.","locale":"en"},"2272":{"id":"/docs/guides/archive-mode-20","page_id":"/docs/guides/archive-mode","tags":[],"type":"text","url":"/docs/guides/archive-mode#transactions-in-manual-mode","content":"A transaction whose own updates cancel out can leave earlier pending work pending. For the full matrix, see Transactions.","locale":"en"},"2273":{"id":"/docs/guides/archive-mode-21","page_id":"/docs/guides/archive-mode","tags":[],"type":"text","url":"/docs/guides/archive-mode#cancelled-pending-changes","content":"Pending changes that cancel each other out are dropped instead of retained as a meaningful undo entry. `archive()` can still publish an `archive` event for the archive operation even when no net state change remains. Navigation counts positions with the pending entry in place, so its behavior follows the navigation contract rather than simply deleting the entry.","locale":"en"},"2274":{"id":"/docs/guides/archive-mode-22","page_id":"/docs/guides/archive-mode","tags":[],"type":"text","url":"/docs/guides/archive-mode#automatic-versus-manual","content":"| Behavior                                | Automatic   | Manual             |\n| --------------------------------------- | ----------- | ------------------ |\n| Effective `setState()` creates an entry | Immediately | Only when archived |","locale":"en","table":"table-0"},"2275":{"id":"/docs/guides/archive-mode-23","page_id":"/docs/guides/archive-mode","tags":[],"type":"text","url":"/docs/guides/archive-mode#automatic-versus-manual","content":"| Behavior              | Automatic   | Manual      |\n| --------------------- | ----------- | ----------- |\n| Current state updates | Immediately | Immediately |","locale":"en","table":"table-0"},"2276":{"id":"/docs/guides/archive-mode-24","page_id":"/docs/guides/archive-mode","tags":[],"type":"text","url":"/docs/guides/archive-mode#automatic-versus-manual","content":"| Behavior                     | Automatic | Manual    |\n| ---------------------------- | --------- | --------- |\n| `archive()` / `canArchive()` | Absent    | Available |","locale":"en","table":"table-0"},"2277":{"id":"/docs/guides/archive-mode-25","page_id":"/docs/guides/archive-mode","tags":[],"type":"text","url":"/docs/guides/archive-mode#automatic-versus-manual","content":"| Behavior         | Automatic       | Manual                                |\n| ---------------- | --------------- | ------------------------------------- |\n| Typical boundary | One update call | Application-defined gesture or commit |","locale":"en","table":"table-0"},"2278":{"id":"/docs/guides/archive-mode-26","page_id":"/docs/guides/archive-mode","tags":[],"type":"text","url":"/docs/guides/archive-mode#automatic-versus-manual","content":"| Behavior         | Automatic         | Manual                             |\n| ---------------- | ----------------- | ---------------------------------- |\n| Root transaction | One grouped entry | Also archives earlier pending work |","locale":"en","table":"table-0"},"2279":{"id":"/docs/guides/archive-mode-27","page_id":"/docs/guides/archive-mode","tags":[],"type":"text","url":"/docs/guides/archive-mode#automatic-versus-manual","content":"Start with automatic mode. Choose manual mode only when the application has a clear commit boundary; an update that is never archived cannot be navigated as an independent completed step.","locale":"en"},"2280":{"id":"/docs/guides/controlled-journal","page_id":"/docs/guides/controlled-journal","type":"page","content":"Controlled Journal","breadcrumbs":["Travels","Guides"],"tags":[],"url":"/docs/guides/controlled-journal","locale":"en"},"2281":{"id":"/docs/guides/controlled-journal-0","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal","content":"Connect Travels history to a runtime that already owns state and commits.","locale":"en"},"2282":{"id":"/docs/guides/controlled-journal-1","page_id":"/docs/guides/controlled-journal","type":"heading","tags":[],"url":"/docs/guides/controlled-journal#data-flow","content":"Data flow","locale":"en"},"2283":{"id":"/docs/guides/controlled-journal-2","page_id":"/docs/guides/controlled-journal","type":"heading","tags":[],"url":"/docs/guides/controlled-journal#navigation-and-reset-contract","content":"Navigation and reset contract","locale":"en"},"2284":{"id":"/docs/guides/controlled-journal-3","page_id":"/docs/guides/controlled-journal","type":"heading","tags":[],"url":"/docs/guides/controlled-journal#public-surface","content":"Public surface","locale":"en"},"2285":{"id":"/docs/guides/controlled-journal-4","page_id":"/docs/guides/controlled-journal","type":"heading","tags":[],"url":"/docs/guides/controlled-journal#failure-boundaries","content":"Failure boundaries","locale":"en"},"2286":{"id":"/docs/guides/controlled-journal-5","page_id":"/docs/guides/controlled-journal","type":"heading","tags":[],"url":"/docs/guides/controlled-journal#event-compatibility","content":"Event compatibility","locale":"en"},"2287":{"id":"/docs/guides/controlled-journal-6","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal","content":"`createTravelJournal()` is the adapter API for a runtime that already owns and commits state. It lets that runtime hand an existing forward/inverse patch pair to Travels without rerunning the update recipe or routing navigation around the owner's validation and subscription pipeline.","locale":"en"},"2288":{"id":"/docs/guides/controlled-journal-7","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal","content":"Use `createTravels()` instead when Travels itself should own state updates. Restore serialized journal history with `restoreTravelJournal(snapshot, { apply })`; the snapshot state and timeline are accepted as one atomic input.","locale":"en"},"2289":{"id":"/docs/guides/controlled-journal-8","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#data-flow","content":"An external commit has one authoritative path:","locale":"en"},"2290":{"id":"/docs/guides/controlled-journal-9","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#data-flow","content":"The owner produces `nextState`, `patches`, and `inversePatches` for one transition.","locale":"en"},"2291":{"id":"/docs/guides/controlled-journal-10","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#data-flow","content":"The owner commits `nextState` through its normal state path.","locale":"en"},"2292":{"id":"/docs/guides/controlled-journal-11","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#data-flow","content":"In the same synchronous commit boundary, the adapter calls `journal.recordPatches(nextState, { patches, inversePatches, metadata })`.","locale":"en"},"2293":{"id":"/docs/guides/controlled-journal-12","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#data-flow","content":"Travels detaches the patch pair and metadata, updates its cursor and retained history, then publishes one `recordPatches` event.","locale":"en"},"2294":{"id":"/docs/guides/controlled-journal-13","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#data-flow","content":"`recordPatches()` requires a non-empty patch pair when the supplied state reference changes. It validates patch structure and supported patch values, but does not replay the pair to prove that it transforms the previous state into the supplied state. That relationship is the adapter's responsibility; replay validation here would duplicate the external runtime's work and defeat the single-generation integration path.","locale":"en"},"2295":{"id":"/docs/guides/controlled-journal-14","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#data-flow","content":"Owners that cannot roll back a published commit can call `assertTravelHistoryEntryRecordable({ patches, inversePatches })` before step 2. The preflight uses the same structural validation and detached-value rules as `recordPatches()` without changing journal state.","locale":"en"},"2296":{"id":"/docs/guides/controlled-journal-15","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#data-flow","content":"Patch groups and metadata are cloned before Travels retains them. The supplied state remains the external owner's state reference and is not cloned.","locale":"en"},"2297":{"id":"/docs/guides/controlled-journal-16","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#navigation-and-reset-contract","content":"`back()`, `forward()`, `go()`, and `reset()` compose the necessary patches and invoke the required `apply` callback:","locale":"en"},"2298":{"id":"/docs/guides/controlled-journal-17","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#navigation-and-reset-contract","content":"The callback receives:","locale":"en"},"2299":{"id":"/docs/guides/controlled-journal-18","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#navigation-and-reset-contract","content":"`state`: the state Travels knew before navigation;","locale":"en"},"2300":{"id":"/docs/guides/controlled-journal-19","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#navigation-and-reset-contract","content":"`patches`: the composed forward transition to commit;","locale":"en"},"2301":{"id":"/docs/guides/controlled-journal-20","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#navigation-and-reset-contract","content":"`inversePatches`: the composed rollback transition;","locale":"en"},"2302":{"id":"/docs/guides/controlled-journal-21","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#navigation-and-reset-contract","content":"`fromPosition` and `toPosition`: the cursor movement.","locale":"en"},"2303":{"id":"/docs/guides/controlled-journal-22","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#navigation-and-reset-contract","content":"`reset()` also describes its return to the baseline as patches. When the current state and the baseline are both plain objects, or both arrays, those patches overwrite the root's entries and keep the root itself, so an owner can apply them in place, for example with Mutative's `apply(state, patches, { mutable: true })`. When the root kinds differ, the state is not an object, or either root has an own `__proto__` key, which no patch path can name, the transition replaces the root with one `{ op: 'replace', path: [] }` patch. An owner that applies transitions in place must handle that patch itself, as it must for root replacements it recorded through `recordPatches()`: Mutative 2 throws for a root replacement applied in place, and Mutative 1 skipped it, which left the owner's state unchanged while the journal moved.","locale":"en"},"2304":{"id":"/docs/guides/controlled-journal-23","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#navigation-and-reset-contract","content":"The transition contains detached patch operations and values, so accidental callback mutation cannot rewrite retained history. The callback should still treat them as read-only because changing them before the owner commits would change the requested navigation. Patch values that contain functions, accessors, `WeakMap`/`WeakSet`, custom class instances, array subclasses, or another value that cannot be cloned without changing its runtime type are rejected with `UNCLONEABLE_PATCH_VALUE`; controlled journals should retain primitives, plain objects, plain arrays, or `Date` values. `apply` must finish synchronously and return the state actually committed by the owner. A thrown error, uncloneable transition, or Promise-like result does not advance the cursor, replace the retained state reference, or change history.","locale":"en"},"2305":{"id":"/docs/guides/controlled-journal-24","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#navigation-and-reset-contract","content":"In development builds Travels also scans the returned state for `Map` and `Set`, and an unsupported state is rejected with the same atomicity: the cursor, retained state reference, and history are unchanged. That scan is proportional to the whole state, so production builds skip it and pay nothing per navigation. It is a diagnostic that tells an owner early which transition introduced an unsupported value, not the guarantee that keeps persistence sound: `serialize()`, `rebase()`, and `getHistorySnapshot()` validate the state in every build, and controlled patch values are validated in every build, so an unsupported value can never reach retained history or a persisted snapshot. Develop against a development build to keep the early signal. Travels cannot undo mutations or other side effects the external owner already performed before failing.","locale":"en"},"2306":{"id":"/docs/guides/controlled-journal-25","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#navigation-and-reset-contract","content":"The owner must suppress normal commit recording while applying delegated navigation or reset. Feeding those changes back into `recordPatches()` would create a new entry instead of moving or clearing the existing timeline. Travels rejects every journal mutation attempted synchronously from `apply` with `REENTRANT_MUTATION`; reads remain available to the owner callback.","locale":"en"},"2307":{"id":"/docs/guides/controlled-journal-26","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#navigation-and-reset-contract","content":"Set `autoArchive: false` when several external commits should become one undo step. Each `recordPatches()` call updates the pending current state; `archive(metadata?)` composes the pending patch groups, and `canArchive()` reports whether any work is pending. Archiving changes only journal history and does not invoke `apply` because the external owner already committed the state. When navigation implicitly archives pending work, the archive and cursor move commit as one observable navigation transition; a failed `apply` leaves the pending archive, revision, and subscriptions untouched.","locale":"en"},"2308":{"id":"/docs/guides/controlled-journal-27","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#public-surface","content":"The returned `TravelJournal` exposes only journal-safe operations:","locale":"en"},"2309":{"id":"/docs/guides/controlled-journal-28","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#public-surface","content":"external commit ingress: `recordPatches()`;","locale":"en"},"2310":{"id":"/docs/guides/controlled-journal-29","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#public-surface","content":"navigation: `back()`, `forward()`, `go()`, `reset()`, `canBack()`, and `canForward()`;","locale":"en"},"2311":{"id":"/docs/guides/controlled-journal-30","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#public-surface","content":"reads: `getState()`, `getHistory()`, `getHistorySnapshot()`, `getPosition()`, `getPatches()`, `getMetadata()`, `getHistoryEntries()`, `assertPersistenceCompatible()`, and `serialize()`;","locale":"en"},"2312":{"id":"/docs/guides/controlled-journal-31","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#public-surface","content":"lifecycle: `subscribe()` and `rebase()`;","locale":"en"},"2313":{"id":"/docs/guides/controlled-journal-32","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#public-surface","content":"manual journals only: `archive()` and `canArchive()`.","locale":"en"},"2314":{"id":"/docs/guides/controlled-journal-33","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#public-surface","content":"The facade is a frozen read-only capability object in every build; its methods cannot be replaced at runtime.","locale":"en"},"2315":{"id":"/docs/guides/controlled-journal-34","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#public-surface","content":"State-owning operations (`setState()`, transactions, `replaceStateWithoutHistory()`, tracking controls, and `getControls()`) are absent from both the public type and the runtime facade. `rebase()` is the safe way to clear retained history while keeping the current external state as the new baseline; `reset()` instead asks the external owner to restore the existing baseline.","locale":"en"},"2316":{"id":"/docs/guides/controlled-journal-35","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#failure-boundaries","content":"Travels makes each journal mutation internally atomic: malformed, empty, or one-sided patch pairs, unsafe paths, unsupported patch/state values, metadata cloning failures, and controlled navigation failures do not partially change journal state or history. Controlled patch ingress uses the same accessor-safe structural normalization as persisted history.","locale":"en"},"2317":{"id":"/docs/guides/controlled-journal-36","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#failure-boundaries","content":"The external owner and Travels are still two components. If the owner has already published a commit and `recordPatches()` then fails, Travels cannot roll that external commit back automatically. Generate patches through a trusted producer, keep metadata cloneable, and call `recordPatches()` before publishing external notifications when the owner supports that ordering. An adapter that cannot roll back should recover explicitly, for example by rebasing the journal at the authoritative state or switching to its documented compatibility fallback.","locale":"en"},"2318":{"id":"/docs/guides/controlled-journal-37","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#failure-boundaries","content":"Observer failures happen after a successful journal commit and follow the normal `onObserverError` contract; they do not roll the transition back.","locale":"en"},"2319":{"id":"/docs/guides/controlled-journal-38","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#event-compatibility","content":"A successful external commit emits `TravelsEvent` with type `recordPatches`. Navigation emits `go`, including calls made through `back()` or `forward()`. The event patch groups describe only that event's transition.","locale":"en"},"2320":{"id":"/docs/guides/controlled-journal-39","page_id":"/docs/guides/controlled-journal","tags":[],"type":"text","url":"/docs/guides/controlled-journal#event-compatibility","content":"`TravelsEvent['type']` intentionally remains open to future minor-release event names. Consumers should handle known operations and keep a `default` branch instead of asserting exhaustiveness with `never`. Applications using only `createTravels()` do not receive `recordPatches` at runtime.","locale":"en"},"2321":{"id":"/docs/guides/error-handling","page_id":"/docs/guides/error-handling","type":"page","content":"Error Handling","breadcrumbs":["Travels","Guides"],"tags":[],"url":"/docs/guides/error-handling","locale":"en"},"2322":{"id":"/docs/guides/error-handling-0","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling","content":"Handle typed operation errors, persistence failures, warnings, and observer errors without corrupting history.","locale":"en"},"2323":{"id":"/docs/guides/error-handling-1","page_id":"/docs/guides/error-handling","type":"heading","tags":[],"url":"/docs/guides/error-handling#operation-errors","content":"Operation errors","locale":"en"},"2324":{"id":"/docs/guides/error-handling-2","page_id":"/docs/guides/error-handling","type":"heading","tags":[],"url":"/docs/guides/error-handling#persistence-errors","content":"Persistence errors","locale":"en"},"2325":{"id":"/docs/guides/error-handling-3","page_id":"/docs/guides/error-handling","type":"heading","tags":[],"url":"/docs/guides/error-handling#warnings","content":"Warnings","locale":"en"},"2326":{"id":"/docs/guides/error-handling-4","page_id":"/docs/guides/error-handling","type":"heading","tags":[],"url":"/docs/guides/error-handling#observer-failures","content":"Observer failures","locale":"en"},"2327":{"id":"/docs/guides/error-handling-5","page_id":"/docs/guides/error-handling","type":"heading","tags":[],"url":"/docs/guides/error-handling#recovery-by-boundary","content":"Recovery by boundary","locale":"en"},"2328":{"id":"/docs/guides/error-handling-6","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling","content":"Travels separates operation errors, persistence decoding errors, non-fatal warnings, and observer failures. Match stable `code` values rather than production error message text.","locale":"en"},"2329":{"id":"/docs/guides/error-handling-7","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#operation-errors","content":"`TravelsError` extends `Error`; `TravelsTypeError` extends `TypeError`. Both expose a stable `code` and optional `cause`.","locale":"en"},"2330":{"id":"/docs/guides/error-handling-8","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#operation-errors","content":"Common codes include:","locale":"en"},"2331":{"id":"/docs/guides/error-handling-9","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#operation-errors","content":"| Code             | Typical meaning                                       |\n| ---------------- | ----------------------------------------------------- |\n| `ASYNC_CALLBACK` | An updater or transaction returned asynchronous work. |","locale":"en","table":"table-0"},"2332":{"id":"/docs/guides/error-handling-10","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#operation-errors","content":"| Code             | Typical meaning                                           |\n| ---------------- | --------------------------------------------------------- |\n| `INVALID_OPTION` | Factory or restore options are incompatible or malformed. |","locale":"en","table":"table-0"},"2333":{"id":"/docs/guides/error-handling-11","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#operation-errors","content":"| Code                | Typical meaning                                                      |\n| ------------------- | -------------------------------------------------------------------- |\n| `INVALID_OPERATION` | The requested operation is not allowed for that capability or state. |","locale":"en","table":"table-0"},"2334":{"id":"/docs/guides/error-handling-12","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#operation-errors","content":"| Code                | Typical meaning                                            |\n| ------------------- | ---------------------------------------------------------- |\n| `UNSUPPORTED_STATE` | State or a patch path violates the runtime state contract. |","locale":"en","table":"table-0"},"2335":{"id":"/docs/guides/error-handling-13","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#operation-errors","content":"| Code                       | Typical meaning                                     |\n| -------------------------- | --------------------------------------------------- |\n| `PERSISTENCE_INCOMPATIBLE` | State, patches, paths, or metadata are not durable. |","locale":"en","table":"table-0"},"2336":{"id":"/docs/guides/error-handling-14","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#operation-errors","content":"| Code                    | Typical meaning                                                            |\n| ----------------------- | -------------------------------------------------------------------------- |\n| `HISTORY_REPLAY_FAILED` | A retained patch could not be applied during navigation or reconstruction. |","locale":"en","table":"table-0"},"2337":{"id":"/docs/guides/error-handling-15","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#operation-errors","content":"| Code                 | Typical meaning                               |\n| -------------------- | --------------------------------------------- |\n| `TRANSACTION_FAILED` | The atomic operation failed; inspect `cause`. |","locale":"en","table":"table-0"},"2338":{"id":"/docs/guides/error-handling-16","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#operation-errors","content":"| Code                 | Typical meaning                                                            |\n| -------------------- | -------------------------------------------------------------------------- |\n| `REENTRANT_MUTATION` | A synchronous observer or controlled callback attempted a nested mutation. |","locale":"en","table":"table-0"},"2339":{"id":"/docs/guides/error-handling-17","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#operation-errors","content":"| Code                                        | Typical meaning                                                      |\n| ------------------------------------------- | -------------------------------------------------------------------- |\n| `INVALID_PATCH_ENTRY` / `EMPTY_PATCH_ENTRY` | A controlled patch pair is malformed or missing required operations. |","locale":"en","table":"table-0"},"2340":{"id":"/docs/guides/error-handling-18","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#operation-errors","content":"| Code                      | Typical meaning                                     |\n| ------------------------- | --------------------------------------------------- |\n| `UNCLONEABLE_PATCH_VALUE` | A controlled patch value cannot be detached safely. |","locale":"en","table":"table-0"},"2341":{"id":"/docs/guides/error-handling-19","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#operation-errors","content":"| Code                          | Typical meaning                             |\n| ----------------------------- | ------------------------------------------- |\n| `CONTROLLED_JOURNAL_REQUIRED` | An operation requires a controlled journal. |","locale":"en","table":"table-0"},"2342":{"id":"/docs/guides/error-handling-20","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#operation-errors","content":"| Code                               | Typical meaning                                         |\n| ---------------------------------- | ------------------------------------------------------- |\n| `CONTROLLED_OPERATION_UNAVAILABLE` | A state-owning capability was requested from a journal. |","locale":"en","table":"table-0"},"2343":{"id":"/docs/guides/error-handling-21","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#operation-errors","content":"For asynchronous transaction callbacks, catch `TravelsError` with code `TRANSACTION_FAILED`. Its `cause` is a `TravelsTypeError` with code `ASYNC_CALLBACK` for both native async functions and callbacks that return a promise.","locale":"en"},"2344":{"id":"/docs/guides/error-handling-22","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#operation-errors","content":"Use `onError` for wrapped core operation failures, especially when coordinating nested transactions. Keep local `try/catch` around actions whose errors the UI must handle synchronously; do not assume a hook replaces the thrown error.","locale":"en"},"2345":{"id":"/docs/guides/error-handling-23","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#persistence-errors","content":"`TravelsPersistenceError` covers decoding, migration, and validation:","locale":"en"},"2346":{"id":"/docs/guides/error-handling-24","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#persistence-errors","content":"| Code          | Meaning                         |\n| ------------- | ------------------------------- |\n| `PARSE_ERROR` | JSON input could not be parsed. |","locale":"en","table":"table-1"},"2347":{"id":"/docs/guides/error-handling-25","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#persistence-errors","content":"| Code                  | Meaning                                       |\n| --------------------- | --------------------------------------------- |\n| `UNSUPPORTED_VERSION` | The snapshot schema version is not supported. |","locale":"en","table":"table-1"},"2348":{"id":"/docs/guides/error-handling-26","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#persistence-errors","content":"| Code             | Meaning                                               |\n| ---------------- | ----------------------------------------------------- |\n| `INVALID_SCHEMA` | Snapshot fields, metadata, or position are malformed. |","locale":"en","table":"table-1"},"2349":{"id":"/docs/guides/error-handling-27","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#persistence-errors","content":"| Code              | Meaning                                                     |\n| ----------------- | ----------------------------------------------------------- |\n| `INVALID_PATCHES` | Patch containers, operations, paths, or values are invalid. |","locale":"en","table":"table-1"},"2350":{"id":"/docs/guides/error-handling-28","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#persistence-errors","content":"| Code              | Meaning                                  |\n| ----------------- | ---------------------------------------- |\n| `INVALID_HISTORY` | Semantic replay or reversibility failed. |","locale":"en","table":"table-1"},"2351":{"id":"/docs/guides/error-handling-29","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#persistence-errors","content":"| Code               | Meaning                                                                   |\n| ------------------ | ------------------------------------------------------------------------- |\n| `MIGRATION_FAILED` | The migration callback failed or returned an invalid/asynchronous result. |","locale":"en","table":"table-1"},"2352":{"id":"/docs/guides/error-handling-30","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#persistence-errors","content":"| Code              | Meaning                                                     |\n| ----------------- | ----------------------------------------------------------- |\n| `FALLBACK_FAILED` | Recovery failed or produced an invalid/asynchronous result. |","locale":"en","table":"table-1"},"2353":{"id":"/docs/guides/error-handling-31","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#persistence-errors","content":"Entry-specific semantic failures can also expose `entryIndex` and `direction`. See Migration and Recovery.","locale":"en"},"2354":{"id":"/docs/guides/error-handling-32","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#warnings","content":"`onWarning` receives non-fatal diagnostics with stable codes:","locale":"en"},"2355":{"id":"/docs/guides/error-handling-33","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#warnings","content":"Warning codes include `HISTORY_DISABLED`, `HISTORY_DISCARDED`, `HISTORY_TRIMMED`, `INVALID_POSITION`, `MUTABLE_FALLBACK`, `MUTABLE_ROOT_REPLACEMENT`, `PERSISTENCE_COMPATIBILITY`, and `POSITION_CLAMPED`.","locale":"en"},"2356":{"id":"/docs/guides/error-handling-34","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#warnings","content":"Without the hook, warnings are written to the console only in development. Disabling compatibility warnings does not disable runtime correctness checks.","locale":"en"},"2357":{"id":"/docs/guides/error-handling-35","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#observer-failures","content":"Errors thrown by listeners, devtools, branch-discard hooks, error/warning hooks, or compatibility checks after commit are routed to `onObserverError` when configured. They do not interrupt other observers or roll back an already committed transition. Without the hook, development builds log the observer source and the original error to `console.error`.","locale":"en"},"2358":{"id":"/docs/guides/error-handling-36","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#observer-failures","content":"Observer Promises are not awaited, but rejected Promises are isolated and reported. The application remains responsible for actual asynchronous side-effect recovery.","locale":"en"},"2359":{"id":"/docs/guides/error-handling-37","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#recovery-by-boundary","content":"**Invalid caller input:** fix options or state before constructing the timeline; do not continue with a partially initialized owner.","locale":"en"},"2360":{"id":"/docs/guides/error-handling-38","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#recovery-by-boundary","content":"**Failed transaction:** Travels rolls back writes made through its APIs. Application side effects and direct mutable-store writes need separate handling.","locale":"en"},"2361":{"id":"/docs/guides/error-handling-39","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#recovery-by-boundary","content":"**Unverified persisted history:** use `validation: 'semantic'` and a known-safe `fallback` before restore.","locale":"en"},"2362":{"id":"/docs/guides/error-handling-40","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#recovery-by-boundary","content":"**Controlled ingress:** call `assertTravelHistoryEntryRecordable()` before an external commit when the owner cannot roll back a published change.","locale":"en"},"2363":{"id":"/docs/guides/error-handling-41","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#recovery-by-boundary","content":"**Failed controlled `apply`:** Travels does not advance its own cursor, but cannot undo side effects already performed by the external owner.","locale":"en"},"2364":{"id":"/docs/guides/error-handling-42","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#recovery-by-boundary","content":"**Replay failure in mutable mode:** writes made before the failing patch can remain. Prefer semantic validation before restoring unverified snapshots.","locale":"en"},"2365":{"id":"/docs/guides/error-handling-43","page_id":"/docs/guides/error-handling","tags":[],"type":"text","url":"/docs/guides/error-handling#recovery-by-boundary","content":"For integrity and tamper resistance, verify encoded bytes outside Travels before deserialization; replay consistency alone does not prove provenance.","locale":"en"},"2366":{"id":"/docs/guides","page_id":"/docs/guides","type":"page","content":"History Guides","breadcrumbs":["Travels","Guides"],"tags":[],"url":"/docs/guides","locale":"en"},"2367":{"id":"/docs/guides-0","page_id":"/docs/guides","tags":[],"type":"text","url":"/docs/guides","content":"Practical guidance for updates, navigation, grouping, observers, ownership, and failures.","locale":"en"},"2368":{"id":"/docs/guides-1","page_id":"/docs/guides","type":"heading","tags":[],"url":"/docs/guides#everyday-operations","content":"Everyday operations","locale":"en"},"2369":{"id":"/docs/guides-2","page_id":"/docs/guides","type":"heading","tags":[],"url":"/docs/guides#ownership-and-lifecycle","content":"Ownership and lifecycle","locale":"en"},"2370":{"id":"/docs/guides-3","page_id":"/docs/guides","type":"heading","tags":[],"url":"/docs/guides#production-behavior","content":"Production behavior","locale":"en"},"2371":{"id":"/docs/guides-4","page_id":"/docs/guides","tags":[],"type":"text","url":"/docs/guides","content":"These guides explain the behavior that matters after the first undo button works. Start with updates and navigation, then choose the archive and ownership models that match your application.","locale":"en"},"2372":{"id":"/docs/guides-5","page_id":"/docs/guides","tags":[],"type":"text","url":"/docs/guides#everyday-operations","content":"<Card title=\"Updating State\" href=\"/docs/guides/updating-state\" description=\"Draft recipes, replacement values, metadata, synchronous boundaries, and no-op updates.\" />","locale":"en"},"2373":{"id":"/docs/guides-6","page_id":"/docs/guides","tags":[],"type":"text","url":"/docs/guides#everyday-operations","content":"<Card title=\"Navigation and Controls\" href=\"/docs/guides/navigation-and-controls\" description=\"Undo, redo, jumps, revisions, history views, and narrow UI controls.\" />","locale":"en"},"2374":{"id":"/docs/guides-7","page_id":"/docs/guides","tags":[],"type":"text","url":"/docs/guides#everyday-operations","content":"<Card title=\"Archive Mode\" href=\"/docs/guides/archive-mode\" description=\"Choose when pending changes become undoable entries.\" />","locale":"en"},"2375":{"id":"/docs/guides-8","page_id":"/docs/guides","tags":[],"type":"text","url":"/docs/guides#everyday-operations","content":"<Card title=\"Transactions\" href=\"/docs/guides/transactions\" description=\"Atomic multi-step edits, nesting, rollback, and observer semantics.\" />","locale":"en"},"2376":{"id":"/docs/guides-9","page_id":"/docs/guides","tags":[],"type":"text","url":"/docs/guides#ownership-and-lifecycle","content":"<Card title=\"Tracking and Replacement\" href=\"/docs/guides/tracking-and-replacement\" description=\"Pause history, accept remote state, and establish a new baseline.\" />","locale":"en"},"2377":{"id":"/docs/guides-10","page_id":"/docs/guides","tags":[],"type":"text","url":"/docs/guides#ownership-and-lifecycle","content":"<Card title=\"Mutable Mode\" href=\"/docs/guides/mutable-mode\" description=\"Keep reactive object references stable without losing patches.\" />","locale":"en"},"2378":{"id":"/docs/guides-11","page_id":"/docs/guides","tags":[],"type":"text","url":"/docs/guides#ownership-and-lifecycle","content":"<Card title=\"Controlled Journal\" href=\"/docs/guides/controlled-journal\" description=\"Record history for an external state owner through its commit path.\" />","locale":"en"},"2379":{"id":"/docs/guides-12","page_id":"/docs/guides","tags":[],"type":"text","url":"/docs/guides#production-behavior","content":"<Card title=\"Observers and Events\" href=\"/docs/guides/observers-and-events\" description=\"Committed event envelopes, read-only views, devtools, and error isolation.\" />","locale":"en"},"2380":{"id":"/docs/guides-13","page_id":"/docs/guides","tags":[],"type":"text","url":"/docs/guides#production-behavior","content":"<Card title=\"Error Handling\" href=\"/docs/guides/error-handling\" description=\"Stable error codes, warnings, observer failures, and recovery boundaries.\" />","locale":"en"},"2381":{"id":"/docs/guides-14","page_id":"/docs/guides","tags":[],"type":"text","url":"/docs/guides#production-behavior","content":"<Card title=\"Advanced Patterns\" href=\"/docs/guides/advanced-patterns\" description=\"Validation, permissions, metadata, logging, and composable wrappers.\" />","locale":"en"},"2382":{"id":"/docs/guides/mutable-mode","page_id":"/docs/guides/mutable-mode","type":"page","content":"Mutable Mode","breadcrumbs":["Travels","Guides"],"tags":[],"url":"/docs/guides/mutable-mode","locale":"en"},"2383":{"id":"/docs/guides/mutable-mode-0","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode","content":"Preserve reactive object identity while recording reversible patches.","locale":"en"},"2384":{"id":"/docs/guides/mutable-mode-1","page_id":"/docs/guides/mutable-mode","type":"heading","tags":[],"url":"/docs/guides/mutable-mode#when-you-should-enable-mutable-mode","content":"When You Should Enable Mutable Mode","locale":"en"},"2385":{"id":"/docs/guides/mutable-mode-2","page_id":"/docs/guides/mutable-mode","type":"heading","tags":[],"url":"/docs/guides/mutable-mode#enabling-mutable-mode","content":"Enabling Mutable Mode","locale":"en"},"2386":{"id":"/docs/guides/mutable-mode-3","page_id":"/docs/guides/mutable-mode","type":"heading","tags":[],"url":"/docs/guides/mutable-mode#how-it-works-under-the-hood","content":"How It Works Under the Hood","locale":"en"},"2387":{"id":"/docs/guides/mutable-mode-4","page_id":"/docs/guides/mutable-mode","type":"heading","tags":[],"url":"/docs/guides/mutable-mode#restoring-persisted-history-into-a-live-store","content":"Restoring Persisted History Into a Live Store","locale":"en"},"2388":{"id":"/docs/guides/mutable-mode-5","page_id":"/docs/guides/mutable-mode","type":"heading","tags":[],"url":"/docs/guides/mutable-mode#behavior-by-operation","content":"Behavior by Operation","locale":"en"},"2389":{"id":"/docs/guides/mutable-mode-6","page_id":"/docs/guides/mutable-mode","type":"heading","tags":[],"url":"/docs/guides/mutable-mode#fallback--safety-rails","content":"Fallback & Safety Rails","locale":"en"},"2390":{"id":"/docs/guides/mutable-mode-7","page_id":"/docs/guides/mutable-mode","type":"heading","tags":[],"url":"/docs/guides/mutable-mode#integration-patterns","content":"Integration Patterns","locale":"en"},"2391":{"id":"/docs/guides/mutable-mode-8","page_id":"/docs/guides/mutable-mode","type":"heading","tags":[],"url":"/docs/guides/mutable-mode#mobx-simplified-observable","content":"MobX (simplified observable)","locale":"en"},"2392":{"id":"/docs/guides/mutable-mode-9","page_id":"/docs/guides/mutable-mode","type":"heading","tags":[],"url":"/docs/guides/mutable-mode#vue--pinia","content":"Vue / Pinia","locale":"en"},"2393":{"id":"/docs/guides/mutable-mode-10","page_id":"/docs/guides/mutable-mode","type":"heading","tags":[],"url":"/docs/guides/mutable-mode#manual-archive--mutable","content":"Manual Archive + Mutable","locale":"en"},"2394":{"id":"/docs/guides/mutable-mode-11","page_id":"/docs/guides/mutable-mode","type":"heading","tags":[],"url":"/docs/guides/mutable-mode#transactions--mutable-state","content":"Transactions + Mutable State","locale":"en"},"2395":{"id":"/docs/guides/mutable-mode-12","page_id":"/docs/guides/mutable-mode","type":"heading","tags":[],"url":"/docs/guides/mutable-mode#performance--testing-notes","content":"Performance & Testing Notes","locale":"en"},"2396":{"id":"/docs/guides/mutable-mode-13","page_id":"/docs/guides/mutable-mode","type":"heading","tags":[],"url":"/docs/guides/mutable-mode#troubleshooting-checklist","content":"Troubleshooting Checklist","locale":"en"},"2397":{"id":"/docs/guides/mutable-mode-14","page_id":"/docs/guides/mutable-mode","type":"heading","tags":[],"url":"/docs/guides/mutable-mode#summary","content":"Summary","locale":"en"},"2398":{"id":"/docs/guides/mutable-mode-15","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode","content":"Mutable mode makes Travels play nicely with observable state libraries (MobX, Vue's `reactive`, Pinia stores, etc.) that rely on **stable object references** to notify subscribers. Instead of replacing the entire state object on every update, Travels mutates the original object in place while still recording JSON Patches for undo/redo.","locale":"en"},"2399":{"id":"/docs/guides/mutable-mode-16","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode","content":"Use this guide to decide when to enable `mutable: true`, understand how it works internally, and apply it safely in production apps.","locale":"en"},"2400":{"id":"/docs/guides/mutable-mode-17","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#when-you-should-enable-mutable-mode","content":"You hand Travels the same object that your UI library observes and you cannot replace that reference without breaking reactivity (MobX stores, Vue/Pinia stores, custom proxies).","locale":"en"},"2401":{"id":"/docs/guides/mutable-mode-18","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#when-you-should-enable-mutable-mode","content":"You want undo/redo without extra `setState({...state})` copies or garbage-collection churn.","locale":"en"},"2402":{"id":"/docs/guides/mutable-mode-19","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#when-you-should-enable-mutable-mode","content":"You batch updates with `autoArchive: false` but still expect the live store reference to update immediately.","locale":"en"},"2403":{"id":"/docs/guides/mutable-mode-20","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#when-you-should-enable-mutable-mode","content":"Stick with the default immutable mode when you already replace references (React/Redux style reducers, Zustand, etc.) or when you prefer structural sharing for diffing.","locale":"en"},"2404":{"id":"/docs/guides/mutable-mode-21","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#enabling-mutable-mode","content":"After this ordinary draft update, `travels.getState()` still returns `store`. Effective changes still produce patches, but explicit root replacements and primitive roots can change the root reference as described below.","locale":"en"},"2405":{"id":"/docs/guides/mutable-mode-22","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#how-it-works-under-the-hood","content":"`createTravels` keeps the object you pass as the live state and stores a detached baseline copy for `reset()`, using `structuredClone()` when possible and a custom deep-clone fallback otherwise.","locale":"en"},"2406":{"id":"/docs/guides/mutable-mode-23","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#how-it-works-under-the-hood","content":"Each ordinary object-root draft update runs through Mutative's `create(...)` to generate patches/inverse patches. Those patches are immediately applied back to the live object via `apply(..., { mutable: true })`, preserving its reference. Explicit root replacements instead use an immutable fallback.","locale":"en"},"2407":{"id":"/docs/guides/mutable-mode-24","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#how-it-works-under-the-hood","content":"Navigation commands (`back`, `forward`, `go`) reuse the stored patches. `reset()` instead computes a fresh diff back to that baseline copy so it can restore the original data without replaying every history step.","locale":"en"},"2408":{"id":"/docs/guides/mutable-mode-25","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#how-it-works-under-the-hood","content":"If a history step replaces the entire root (patch path `[]` with `op: 'replace'`), Travels falls back to immutable assignment for that jump to guarantee correctness.","locale":"en"},"2409":{"id":"/docs/guides/mutable-mode-26","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#how-it-works-under-the-hood","content":"The full implementation lives in `src/travels.ts` and is exercised by `test/mutable-mode.test.ts` and `test/primitive-edge-cases.test.ts`.","locale":"en"},"2410":{"id":"/docs/guides/mutable-mode-27","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#restoring-persisted-history-into-a-live-store","content":"`restoreTravels(snapshot)` restores a detached copy of the snapshot state, which would break reactivity for a store that is already observed. Pass the observed object as `target` instead:","locale":"en"},"2411":{"id":"/docs/guides/mutable-mode-28","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#restoring-persisted-history-into-a-live-store","content":"Travels overwrites `target` in place with a copy of `snapshot.state` before it records anything, so the live object and the restored patch history always start from the same data. The snapshot itself is never mutated. `target` requires `mutable: true` and must have the same root kind (plain object or array) as the snapshot state, and neither root may have an own `__proto__` key; it is rejected with `INVALID_OPTION` otherwise.","locale":"en"},"2412":{"id":"/docs/guides/mutable-mode-29","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#behavior-by-operation","content":"| Operation  | Reference preserved? | Notes                                                                                                                      |\n| ---------- | -------------------- | -------------------------------------------------------------------------------------------------------------------------- |\n| `setState` | Usually              | Localized draft updates preserve object/array roots; primitive roots and explicit root replacements use immutable fallback |","locale":"en","table":"table-0"},"2413":{"id":"/docs/guides/mutable-mode-30","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#behavior-by-operation","content":"| Operation          | Reference preserved?                                  | Notes                                                                       |\n| ------------------ | ----------------------------------------------------- | --------------------------------------------------------------------------- |\n| `back` / `forward` | Yes, unless the step applies a root-level replacement | Happens when you undo a change that swapped the entire state object or type |","locale":"en","table":"table-0"},"2414":{"id":"/docs/guides/mutable-mode-31","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#behavior-by-operation","content":"| Operation      | Reference preserved?   | Notes                                                                                  |\n| -------------- | ---------------------- | -------------------------------------------------------------------------------------- |\n| `go(position)` | Same as `back/forward` | Travels checks for root-replace patches before deciding whether it can mutate in place |","locale":"en","table":"table-0"},"2415":{"id":"/docs/guides/mutable-mode-32","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#behavior-by-operation","content":"| Operation          | Reference preserved? | Notes                                                            |\n| ------------------ | -------------------- | ---------------------------------------------------------------- |\n| `archive` (manual) | Yes                  | Temporary patches are merged and applied to the same live object |","locale":"en","table":"table-0"},"2416":{"id":"/docs/guides/mutable-mode-33","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#behavior-by-operation","content":"| Operation | Reference preserved? | Notes                                                                                                                                                                                    |\n| --------- | -------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `reset`   | Usually              | Mutates in place only when the current state and the stored initial snapshot are both plain objects or both arrays, neither with an own `__proto__` key; otherwise it reassigns the root |","locale":"en","table":"table-0"},"2417":{"id":"/docs/guides/mutable-mode-34","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#behavior-by-operation","content":"| Operation    | Reference preserved? | Notes                                                                                                                                                                                                         |\n| ------------ | -------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `getHistory` | Mixed                | Includes the live state for the current position. Past and future entries share unchanged objects with it, so in-place updates also change an array returned earlier; keep copies with `getHistorySnapshot()` |","locale":"en","table":"table-0"},"2418":{"id":"/docs/guides/mutable-mode-35","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#behavior-by-operation","content":"| Operation   | Reference preserved?           | Notes                                                                                     |\n| ----------- | ------------------------------ | ----------------------------------------------------------------------------------------- |\n| `subscribe` | Receives the current live root | In-place operations preserve its reference; root-replacement steps can provide a new root |","locale":"en","table":"table-0"},"2419":{"id":"/docs/guides/mutable-mode-36","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#fallback--safety-rails","content":"**No auto-freeze**: `enableAutoFreeze` cannot be combined with `mutable: true`. TypeScript reports the pair when `enableAutoFreeze` is the literal `true`, and the factories reject it with `INVALID_OPTION` at runtime. Freezing each produced state would also freeze the parts it shares with the live object, so the next update that writes to them would throw.","locale":"en"},"2420":{"id":"/docs/guides/mutable-mode-37","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#fallback--safety-rails","content":"**Non-object roots**: If the current state is a primitive or `null`, Travels logs a dev warning and behaves immutably for that update. Undo/redo still works—it just cannot mutate a primitive in place.","locale":"en"},"2421":{"id":"/docs/guides/mutable-mode-38","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#fallback--safety-rails","content":"**Root replacements in history**: Navigating to a step that replaces the entire root (e.g., switching from `{...}` to `[]` or a primitive) forces a new reference for that jump only.","locale":"en"},"2422":{"id":"/docs/guides/mutable-mode-39","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#fallback--safety-rails","content":"**Unreplayable history**: Navigation applies retained patches to the live object in place. If one cannot be applied, as in a corrupt snapshot that passed the default structural validation, `go()` throws `HISTORY_REPLAY_FAILED` and the writes made before it remain. Inside a transaction the rollback undoes what it can and, if some change cannot be undone, throws `TRANSACTION_FAILED` with that error as its `cause`. Validate untrusted snapshots with `Travels.deserialize(snapshot, { validation: 'semantic' })` before restoring them.","locale":"en"},"2423":{"id":"/docs/guides/mutable-mode-40","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#fallback--safety-rails","content":"**Function updaters returning a new root**: In mutable mode, `setState(() => newState)` that replaces the root falls back to immutable assignment for that update (dev warning emitted).","locale":"en"},"2424":{"id":"/docs/guides/mutable-mode-41","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#fallback--safety-rails","content":"**Own `__proto__` keys at the root**: `JSON.parse` turns a `\"__proto__\"` member into an own key. A Mutative draft cannot receive that key by assignment, and Mutative will not apply a patch path naming it, so a value update or `reset()` whose current or new root has one replaces the root instead of overwriting it in place.","locale":"en"},"2425":{"id":"/docs/guides/mutable-mode-42","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#fallback--safety-rails","content":"**Reset baseline is a copy**: `reset()` returns to a copy of the state taken at creation or restore, or by the last `rebase()`, `replaceStateWithoutHistory()`, or update while tracking is paused. The copy uses `structuredClone()` when possible and a deep-clone fallback otherwise, so `Date`, `undefined`, `NaN`, `-0`, and `bigint` survive. Structured-cloneable class instances lose their prototypes; values that cannot be cloned, such as functions and unsupported runtime objects, can be retained by reference through the fallback. Both modes reset to the same data.","locale":"en"},"2426":{"id":"/docs/guides/mutable-mode-43","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#fallback--safety-rails","content":"**Detached history values**: Mutable timelines detach object values in their patches with structured cloning plus a fallback, so later in-place writes to cloned data cannot rewrite history. A class instance drafted through `mark` that structured cloning handles returns as a plain object when undo or redo inserts it; fallback-only values can instead retain their reference and runtime type. Edits to fields of an instance that stays in place keep the instance, and immutable timelines keep instances throughout.","locale":"en"},"2427":{"id":"/docs/guides/mutable-mode-44","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#fallback--safety-rails","content":"**Draft best practices**: Prefer mutating the provided draft (`draft.count++`) instead of returning a brand new object. Mutating drafts lets Travels keep using in-place patches during navigation.","locale":"en"},"2428":{"id":"/docs/guides/mutable-mode-45","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#vue--pinia","content":"The reactive `state` reference is the same object that Vue components bind to, so they instantly see mutations while retaining undo/redo controls.","locale":"en"},"2429":{"id":"/docs/guides/mutable-mode-46","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#manual-archive--mutable","content":"Because the state is mutated in place, your UI keeps updating while the grouped changes run. This helper defines a manual archive boundary, not an atomic transaction; use `travels.transaction()` when you need rollback and one settled observer event.","locale":"en"},"2430":{"id":"/docs/guides/mutable-mode-47","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#transactions--mutable-state","content":"`travels.transaction(...)` journals the inverse patches produced by Travels operations. If the callback fails, those recorded changes are reversed while the live state object keeps its identity. A direct write to that object does not produce a Travels patch, so it is outside the journal and survives rollback:","locale":"en"},"2431":{"id":"/docs/guides/mutable-mode-48","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#transactions--mutable-state","content":"Use `travels.setState(...)` for every mutation that must share the transaction's rollback boundary. Travels listeners and devtools publish only the settled root transaction, but MobX, Vue, Pinia, or other observers attached directly to the live object can see provisional in-place mutations as they happen.","locale":"en"},"2432":{"id":"/docs/guides/mutable-mode-49","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#performance--testing-notes","content":"Mutable mode still generates JSON patches, so you can persist or inspect diffs just like immutable mode.","locale":"en"},"2433":{"id":"/docs/guides/mutable-mode-50","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#performance--testing-notes","content":"The dedicated `test/mutable-mode.test.ts` suite verifies reference stability across `setState`, `back`, `forward`, `go`, `reset`, `archive`, and `subscribe`.","locale":"en"},"2434":{"id":"/docs/guides/mutable-mode-51","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#performance--testing-notes","content":"`test/bug-fixes.test.ts` and `test/coverage-improvements.test.ts` include regression tests for resetting nested objects, deleting extra properties, and handling sparse arrays (mutable value updates fall back to immutable to preserve holes).","locale":"en"},"2435":{"id":"/docs/guides/mutable-mode-52","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#troubleshooting-checklist","content":"**Did the root reference change unexpectedly?** Check whether that history step replaced the entire state (e.g., `setState(() => newState)` returning a fresh object). Prefer draft mutations to avoid this.","locale":"en"},"2436":{"id":"/docs/guides/mutable-mode-53","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#troubleshooting-checklist","content":"**Not seeing updates in manual archive mode?** Remember that `travels.setState` still mutates the object immediately; `archive()` merely decides what becomes undoable.","locale":"en"},"2437":{"id":"/docs/guides/mutable-mode-54","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#troubleshooting-checklist","content":"**Seeing a warning about primitives?** Ensure your root state is an object. You can wrap primitives (`{ value: 0 }`) if you need mutable semantics.","locale":"en"},"2438":{"id":"/docs/guides/mutable-mode-55","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#troubleshooting-checklist","content":"**Need to confirm mode at runtime?** Inspect `travels.mutable`. It returns the current mode, which is handy for writing integration tests.","locale":"en"},"2439":{"id":"/docs/guides/mutable-mode-56","page_id":"/docs/guides/mutable-mode","tags":[],"type":"text","url":"/docs/guides/mutable-mode#summary","content":"Mutable mode gives Travels the ergonomics of reactive stores without giving up its patch-based history. Enable it when ordinary operations need reference stability, follow the durable-data contract when persisting, and prefer draft mutations. Check the operation table whenever strict root identity matters.","locale":"en"},"2440":{"id":"/docs/guides/navigation-and-controls","page_id":"/docs/guides/navigation-and-controls","type":"page","content":"Navigation and Controls","breadcrumbs":["Travels","Guides"],"tags":[],"url":"/docs/guides/navigation-and-controls","locale":"en"},"2441":{"id":"/docs/guides/navigation-and-controls-0","page_id":"/docs/guides/navigation-and-controls","tags":[],"type":"text","url":"/docs/guides/navigation-and-controls","content":"Move through history and expose the right read-only capabilities to UI components.","locale":"en"},"2442":{"id":"/docs/guides/navigation-and-controls-1","page_id":"/docs/guides/navigation-and-controls","type":"heading","tags":[],"url":"/docs/guides/navigation-and-controls#undo-redo-and-jumps","content":"Undo, redo, and jumps","locale":"en"},"2443":{"id":"/docs/guides/navigation-and-controls-2","page_id":"/docs/guides/navigation-and-controls","type":"heading","tags":[],"url":"/docs/guides/navigation-and-controls#reset-and-rebase-are-different","content":"Reset and rebase are different","locale":"en"},"2444":{"id":"/docs/guides/navigation-and-controls-3","page_id":"/docs/guides/navigation-and-controls","type":"heading","tags":[],"url":"/docs/guides/navigation-and-controls#narrow-controls-for-components","content":"Narrow controls for components","locale":"en"},"2445":{"id":"/docs/guides/navigation-and-controls-4","page_id":"/docs/guides/navigation-and-controls","type":"heading","tags":[],"url":"/docs/guides/navigation-and-controls#shared-views-versus-owned-snapshots","content":"Shared views versus owned snapshots","locale":"en"},"2446":{"id":"/docs/guides/navigation-and-controls-5","page_id":"/docs/guides/navigation-and-controls","type":"heading","tags":[],"url":"/docs/guides/navigation-and-controls#metadata-driven-undo-menus","content":"Metadata-driven undo menus","locale":"en"},"2447":{"id":"/docs/guides/navigation-and-controls-6","page_id":"/docs/guides/navigation-and-controls","tags":[],"type":"text","url":"/docs/guides/navigation-and-controls#undo-redo-and-jumps","content":"Use `canBack()` and `canForward()` for button availability. `getPosition()` gives the cursor and each subscriber event carries the retained step count in `historyLength`.","locale":"en"},"2448":{"id":"/docs/guides/navigation-and-controls-7","page_id":"/docs/guides/navigation-and-controls","tags":[],"type":"text","url":"/docs/guides/navigation-and-controls#undo-redo-and-jumps","content":"`back()` and `forward()` publish navigation as `go` events. Manual pending changes are implicitly archived as part of a successful navigation; Travels 3 publishes one settled `go` event rather than separate `archive` and `go` events.","locale":"en"},"2449":{"id":"/docs/guides/navigation-and-controls-8","page_id":"/docs/guides/navigation-and-controls","tags":[],"type":"text","url":"/docs/guides/navigation-and-controls#reset-and-rebase-are-different","content":"`reset()` returns to the current instance baseline.","locale":"en"},"2450":{"id":"/docs/guides/navigation-and-controls-9","page_id":"/docs/guides/navigation-and-controls","tags":[],"type":"text","url":"/docs/guides/navigation-and-controls#reset-and-rebase-are-different","content":"`rebase()` discards all history and makes current state the new baseline.","locale":"en"},"2451":{"id":"/docs/guides/navigation-and-controls-10","page_id":"/docs/guides/navigation-and-controls","tags":[],"type":"text","url":"/docs/guides/navigation-and-controls#reset-and-rebase-are-different","content":"Both are timeline mutations and notify observers. Neither means “go to the oldest retained patch” in every situation; read History Lifecycle before exposing them as product actions.","locale":"en"},"2452":{"id":"/docs/guides/navigation-and-controls-11","page_id":"/docs/guides/navigation-and-controls","tags":[],"type":"text","url":"/docs/guides/navigation-and-controls#narrow-controls-for-components","content":"`getControls()` returns a cached, frozen facade suitable for buttons, menus, and component props:","locale":"en"},"2453":{"id":"/docs/guides/navigation-and-controls-12","page_id":"/docs/guides/navigation-and-controls","tags":[],"type":"text","url":"/docs/guides/navigation-and-controls#narrow-controls-for-components","content":"The facade includes navigation, current position, read-only patch/history views, and `rebase()`. Manual timelines expose manual-aware control types. State-owning methods such as `setState()` are not included.","locale":"en"},"2454":{"id":"/docs/guides/navigation-and-controls-13","page_id":"/docs/guides/navigation-and-controls","tags":[],"type":"text","url":"/docs/guides/navigation-and-controls#narrow-controls-for-components","content":"`archive()` and `rebase()` can change controls without changing the current state reference. `getRevision()` advances once for every committed subscriber event, making it the correct snapshot for `useSyncExternalStore`.","locale":"en"},"2455":{"id":"/docs/guides/navigation-and-controls-14","page_id":"/docs/guides/navigation-and-controls","tags":[],"type":"text","url":"/docs/guides/navigation-and-controls#shared-views-versus-owned-snapshots","content":"| API            | Ownership                                     | Use it for                             |\n| -------------- | --------------------------------------------- | -------------------------------------- |\n| `getHistory()` | Shared cached read-only array and state views | Immediate timeline rendering and reads |","locale":"en","table":"table-0"},"2456":{"id":"/docs/guides/navigation-and-controls-15","page_id":"/docs/guides/navigation-and-controls","tags":[],"type":"text","url":"/docs/guides/navigation-and-controls#shared-views-versus-owned-snapshots","content":"| API                    | Ownership                    | Use it for                                 |\n| ---------------------- | ---------------------------- | ------------------------------------------ |\n| `getHistorySnapshot()` | Detached caller-owned states | Keeping, sorting, editing, worker transfer |","locale":"en","table":"table-0"},"2457":{"id":"/docs/guides/navigation-and-controls-16","page_id":"/docs/guides/navigation-and-controls","tags":[],"type":"text","url":"/docs/guides/navigation-and-controls#shared-views-versus-owned-snapshots","content":"| API            | Ownership                    | Use it for                                   |\n| -------------- | ---------------------------- | -------------------------------------------- |\n| `getPatches()` | Detached retained patch data | Owned copies, custom serialization, analysis |","locale":"en","table":"table-0"},"2458":{"id":"/docs/guides/navigation-and-controls-17","page_id":"/docs/guides/navigation-and-controls","tags":[],"type":"text","url":"/docs/guides/navigation-and-controls#shared-views-versus-owned-snapshots","content":"| API                | Ownership                    | Use it for                              |\n| ------------------ | ---------------------------- | --------------------------------------- |\n| `controls.patches` | Shared cached read-only view | Render-time reads and memo dependencies |","locale":"en","table":"table-0"},"2459":{"id":"/docs/guides/navigation-and-controls-18","page_id":"/docs/guides/navigation-and-controls","tags":[],"type":"text","url":"/docs/guides/navigation-and-controls#shared-views-versus-owned-snapshots","content":"| API                   | Ownership                                       | Use it for                        |\n| --------------------- | ----------------------------------------------- | --------------------------------- |\n| `getHistoryEntries()` | Patch entries with inverse patches and metadata | Undo menus, devtools, audit views |","locale":"en","table":"table-0"},"2460":{"id":"/docs/guides/navigation-and-controls-19","page_id":"/docs/guides/navigation-and-controls","tags":[],"type":"text","url":"/docs/guides/navigation-and-controls#shared-views-versus-owned-snapshots","content":"Never cast away read-only types to modify a shared cache. Mutable timelines can also update an old shared history view in place; use detached snapshots when a historical value must remain unchanged.","locale":"en"},"2461":{"id":"/docs/guides/navigation-and-controls-20","page_id":"/docs/guides/navigation-and-controls","tags":[],"type":"text","url":"/docs/guides/navigation-and-controls#metadata-driven-undo-menus","content":"Metadata indexes align with retained patch entries. When old history is trimmed, labels for trimmed entries disappear with them; derive menu text from the current retained entries rather than a separate unbounded UI list.","locale":"en"},"2462":{"id":"/docs/guides/observers-and-events","page_id":"/docs/guides/observers-and-events","type":"page","content":"Observers and Events","breadcrumbs":["Travels","Guides"],"tags":[],"url":"/docs/guides/observers-and-events","locale":"en"},"2463":{"id":"/docs/guides/observers-and-events-0","page_id":"/docs/guides/observers-and-events","tags":[],"type":"text","url":"/docs/guides/observers-and-events","content":"Subscribe to committed transitions and consume shared read-only event data safely.","locale":"en"},"2464":{"id":"/docs/guides/observers-and-events-1","page_id":"/docs/guides/observers-and-events","type":"heading","tags":[],"url":"/docs/guides/observers-and-events#event-shape","content":"Event shape","locale":"en"},"2465":{"id":"/docs/guides/observers-and-events-2","page_id":"/docs/guides/observers-and-events","type":"heading","tags":[],"url":"/docs/guides/observers-and-events#event-local-patches","content":"Event-local patches","locale":"en"},"2466":{"id":"/docs/guides/observers-and-events-3","page_id":"/docs/guides/observers-and-events","type":"heading","tags":[],"url":"/docs/guides/observers-and-events#shared-envelope-and-borrowed-state","content":"Shared envelope and borrowed state","locale":"en"},"2467":{"id":"/docs/guides/observers-and-events-4","page_id":"/docs/guides/observers-and-events","type":"heading","tags":[],"url":"/docs/guides/observers-and-events#reentrant-mutations","content":"Reentrant mutations","locale":"en"},"2468":{"id":"/docs/guides/observers-and-events-5","page_id":"/docs/guides/observers-and-events","type":"heading","tags":[],"url":"/docs/guides/observers-and-events#observer-failures","content":"Observer failures","locale":"en"},"2469":{"id":"/docs/guides/observers-and-events-6","page_id":"/docs/guides/observers-and-events","type":"heading","tags":[],"url":"/docs/guides/observers-and-events#external-store-revisions","content":"External-store revisions","locale":"en"},"2470":{"id":"/docs/guides/observers-and-events-7","page_id":"/docs/guides/observers-and-events","type":"heading","tags":[],"url":"/docs/guides/observers-and-events#devtools","content":"Devtools","locale":"en"},"2471":{"id":"/docs/guides/observers-and-events-8","page_id":"/docs/guides/observers-and-events","tags":[],"type":"text","url":"/docs/guides/observers-and-events","content":"`subscribe()` and the `devtools` option receive the same `TravelsEvent` envelope for a committed notification. Observers run after state, cursor, and history have settled.","locale":"en"},"2472":{"id":"/docs/guides/observers-and-events-9","page_id":"/docs/guides/observers-and-events","tags":[],"type":"text","url":"/docs/guides/observers-and-events#event-shape","content":"| Field  | Meaning                       |\n| ------ | ----------------------------- |\n| `type` | The committed operation name. |","locale":"en","table":"table-0"},"2473":{"id":"/docs/guides/observers-and-events-10","page_id":"/docs/guides/observers-and-events","tags":[],"type":"text","url":"/docs/guides/observers-and-events#event-shape","content":"| Field   | Meaning                          |\n| ------- | -------------------------------- |\n| `state` | The borrowed current state view. |","locale":"en","table":"table-0"},"2474":{"id":"/docs/guides/observers-and-events-11","page_id":"/docs/guides/observers-and-events","tags":[],"type":"text","url":"/docs/guides/observers-and-events#event-shape","content":"| Field     | Meaning                                                                    |\n| --------- | -------------------------------------------------------------------------- |\n| `patches` | The event-local forward/inverse delta from the previously published state. |","locale":"en","table":"table-0"},"2475":{"id":"/docs/guides/observers-and-events-12","page_id":"/docs/guides/observers-and-events","tags":[],"type":"text","url":"/docs/guides/observers-and-events#event-shape","content":"| Field      | Meaning               |\n| ---------- | --------------------- |\n| `position` | The committed cursor. |","locale":"en","table":"table-0"},"2476":{"id":"/docs/guides/observers-and-events-13","page_id":"/docs/guides/observers-and-events","tags":[],"type":"text","url":"/docs/guides/observers-and-events#event-shape","content":"| Field           | Meaning                         |\n| --------------- | ------------------------------- |\n| `historyLength` | The number of retained entries. |","locale":"en","table":"table-0"},"2477":{"id":"/docs/guides/observers-and-events-14","page_id":"/docs/guides/observers-and-events","tags":[],"type":"text","url":"/docs/guides/observers-and-events#event-shape","content":"| Field      | Meaning                                          |\n| ---------- | ------------------------------------------------ |\n| `metadata` | Optional metadata associated with the operation. |","locale":"en","table":"table-0"},"2478":{"id":"/docs/guides/observers-and-events-15","page_id":"/docs/guides/observers-and-events","tags":[],"type":"text","url":"/docs/guides/observers-and-events#event-shape","content":"Known types include `setState`, `recordPatches`, `archive`, `transaction`, `go`, `reset`, `rebase`, and `replaceStateWithoutHistory`. `back()` and `forward()` publish `go`; controlled external commits publish `recordPatches`.","locale":"en"},"2479":{"id":"/docs/guides/observers-and-events-16","page_id":"/docs/guides/observers-and-events","tags":[],"type":"text","url":"/docs/guides/observers-and-events#event-shape","content":"The event type is intentionally open so a minor release can add operations. Keep a `default` branch rather than asserting exhaustive `never` in application switches.","locale":"en"},"2480":{"id":"/docs/guides/observers-and-events-17","page_id":"/docs/guides/observers-and-events","tags":[],"type":"text","url":"/docs/guides/observers-and-events#event-local-patches","content":"`event.patches` describes only that notification’s transition. It is not the complete retained history returned by `getPatches()`.","locale":"en"},"2481":{"id":"/docs/guides/observers-and-events-18","page_id":"/docs/guides/observers-and-events","tags":[],"type":"text","url":"/docs/guides/observers-and-events#event-local-patches","content":"Root transactions compose internal steps into one final delta.","locale":"en"},"2482":{"id":"/docs/guides/observers-and-events-19","page_id":"/docs/guides/observers-and-events","tags":[],"type":"text","url":"/docs/guides/observers-and-events#event-local-patches","content":"`archive()` and `rebase()` can publish empty state patches while changing timeline controls.","locale":"en"},"2483":{"id":"/docs/guides/observers-and-events-20","page_id":"/docs/guides/observers-and-events","tags":[],"type":"text","url":"/docs/guides/observers-and-events#event-local-patches","content":"Patch data is materialized lazily.","locale":"en"},"2484":{"id":"/docs/guides/observers-and-events-21","page_id":"/docs/guides/observers-and-events","tags":[],"type":"text","url":"/docs/guides/observers-and-events#event-local-patches","content":"Patch containers, groups, operations, and array paths are frozen.","locale":"en"},"2485":{"id":"/docs/guides/observers-and-events-22","page_id":"/docs/guides/observers-and-events","tags":[],"type":"text","url":"/docs/guides/observers-and-events#event-local-patches","content":"Forward and inverse directions are independent clones.","locale":"en"},"2486":{"id":"/docs/guides/observers-and-events-23","page_id":"/docs/guides/observers-and-events","tags":[],"type":"text","url":"/docs/guides/observers-and-events#event-local-patches","content":"Nested values and metadata are detached from state and retained history but can be shared by observers handling the same event. Treat the complete event as read-only; one observer must not change what a later observer sees.","locale":"en"},"2487":{"id":"/docs/guides/observers-and-events-24","page_id":"/docs/guides/observers-and-events","tags":[],"type":"text","url":"/docs/guides/observers-and-events#shared-envelope-and-borrowed-state","content":"Each notification creates one shallow-frozen envelope shared by listeners and devtools. `event.state` is the live state used by the timeline and is typed as `ReadonlyState<S>`.","locale":"en"},"2488":{"id":"/docs/guides/observers-and-events-25","page_id":"/docs/guides/observers-and-events","tags":[],"type":"text","url":"/docs/guides/observers-and-events#shared-envelope-and-borrowed-state","content":"Do not write through it. In immutable mode, direct mutation can both bypass recording and alter an object referenced by retained patches. In mutable mode, write through Travels so the patch pair and transaction journal remain correct.","locale":"en"},"2489":{"id":"/docs/guides/observers-and-events-26","page_id":"/docs/guides/observers-and-events","tags":[],"type":"text","url":"/docs/guides/observers-and-events#shared-envelope-and-borrowed-state","content":"Use `getPatches()` for a detached full retained-history snapshot, or `structuredClone()` when an observer needs an owned state value.","locale":"en"},"2490":{"id":"/docs/guides/observers-and-events-27","page_id":"/docs/guides/observers-and-events","tags":[],"type":"text","url":"/docs/guides/observers-and-events#reentrant-mutations","content":"Synchronous calls to mutating Travels APIs from an observer are rejected to prevent nested transitions from mixing event versions:","locale":"en"},"2491":{"id":"/docs/guides/observers-and-events-28","page_id":"/docs/guides/observers-and-events","tags":[],"type":"text","url":"/docs/guides/observers-and-events#reentrant-mutations","content":"Reads remain available. Design derived state carefully so a follow-up update does not create an endless notification cycle.","locale":"en"},"2492":{"id":"/docs/guides/observers-and-events-29","page_id":"/docs/guides/observers-and-events","tags":[],"type":"text","url":"/docs/guides/observers-and-events#observer-failures","content":"A listener exception is isolated from other observers and does not roll back the committed transition. Configure `onObserverError` to receive structured failures:","locale":"en"},"2493":{"id":"/docs/guides/observers-and-events-30","page_id":"/docs/guides/observers-and-events","tags":[],"type":"text","url":"/docs/guides/observers-and-events#observer-failures","content":"Sources include `listener`, `devtools`, `onBranchDiscard`, `onError`, `onWarning`, and `compatibilityCheck`. Observer Promises are not awaited; rejected Promises are isolated and reported through the same path. Do not use an observer as a transactional validator—validate before commit instead.","locale":"en"},"2494":{"id":"/docs/guides/observers-and-events-31","page_id":"/docs/guides/observers-and-events","tags":[],"type":"text","url":"/docs/guides/observers-and-events#external-store-revisions","content":"`getRevision()` is an O(1), monotonically increasing token. It advances once for every committed subscriber event, including manual `archive()` and `rebase()` when state identity stays unchanged. No-op updates and failed transactions do not advance it.","locale":"en"},"2495":{"id":"/docs/guides/observers-and-events-32","page_id":"/docs/guides/observers-and-events","tags":[],"type":"text","url":"/docs/guides/observers-and-events#external-store-revisions","content":"This makes revision the correct invalidation signal for React and other external-store bindings.","locale":"en"},"2496":{"id":"/docs/guides/observers-and-events-33","page_id":"/docs/guides/observers-and-events","tags":[],"type":"text","url":"/docs/guides/observers-and-events#devtools","content":"Devtools follows the same post-commit, shared-view, and error-isolation rules as a subscriber. Keep devtools work light, avoid synchronous timeline mutations, and copy data that must outlive the event.","locale":"en"},"2497":{"id":"/docs/guides/tracking-and-replacement","page_id":"/docs/guides/tracking-and-replacement","type":"page","content":"Tracking and Replacement","breadcrumbs":["Travels","Guides"],"tags":[],"url":"/docs/guides/tracking-and-replacement","locale":"en"},"2498":{"id":"/docs/guides/tracking-and-replacement-0","page_id":"/docs/guides/tracking-and-replacement","tags":[],"type":"text","url":"/docs/guides/tracking-and-replacement","content":"Apply untracked updates, replace authoritative state, and deliberately reset the history baseline.","locale":"en"},"2499":{"id":"/docs/guides/tracking-and-replacement-1","page_id":"/docs/guides/tracking-and-replacement","type":"heading","tags":[],"url":"/docs/guides/tracking-and-replacement#pause-and-resume-tracking","content":"Pause and resume tracking","locale":"en"},"2500":{"id":"/docs/guides/tracking-and-replacement-2","page_id":"/docs/guides/tracking-and-replacement","type":"heading","tags":[],"url":"/docs/guides/tracking-and-replacement#replace-state-without-history","content":"Replace state without history","locale":"en"},"2501":{"id":"/docs/guides/tracking-and-replacement-3","page_id":"/docs/guides/tracking-and-replacement","type":"heading","tags":[],"url":"/docs/guides/tracking-and-replacement#rebase-current-state","content":"Rebase current state","locale":"en"},"2502":{"id":"/docs/guides/tracking-and-replacement-4","page_id":"/docs/guides/tracking-and-replacement","type":"heading","tags":[],"url":"/docs/guides/tracking-and-replacement#reset-to-the-existing-baseline","content":"Reset to the existing baseline","locale":"en"},"2503":{"id":"/docs/guides/tracking-and-replacement-5","page_id":"/docs/guides/tracking-and-replacement","type":"heading","tags":[],"url":"/docs/guides/tracking-and-replacement#remote-synchronization-caution","content":"Remote synchronization caution","locale":"en"},"2504":{"id":"/docs/guides/tracking-and-replacement-6","page_id":"/docs/guides/tracking-and-replacement","tags":[],"type":"text","url":"/docs/guides/tracking-and-replacement","content":"Not every state change should become an undo step. Travels provides separate tools for suspending tracking, replacing a document, and clearing history around current state.","locale":"en"},"2505":{"id":"/docs/guides/tracking-and-replacement-7","page_id":"/docs/guides/tracking-and-replacement","tags":[],"type":"text","url":"/docs/guides/tracking-and-replacement#pause-and-resume-tracking","content":"Each state-changing update while paused discards past, future, and pending entries. The updated state becomes position 0 and the new target for `reset()`. Outside a transaction, subscribers receive `replaceStateWithoutHistory`. Pausing and resuming without a change preserves history.","locale":"en"},"2506":{"id":"/docs/guides/tracking-and-replacement-8","page_id":"/docs/guides/tracking-and-replacement","tags":[],"type":"text","url":"/docs/guides/tracking-and-replacement#pause-and-resume-tracking","content":"Use `pauseTracking()` when subsequent updates should not create history entries, then `resumeTracking()` to return to normal recording:","locale":"en"},"2507":{"id":"/docs/guides/tracking-and-replacement-9","page_id":"/docs/guides/tracking-and-replacement","tags":[],"type":"text","url":"/docs/guides/tracking-and-replacement#pause-and-resume-tracking","content":"Paused updates become part of a new baseline so later undo/redo cannot replay retained patches against mismatched state. Always resume in `finally`; leaving tracking paused silently changes the meaning of later edits.","locale":"en"},"2508":{"id":"/docs/guides/tracking-and-replacement-10","page_id":"/docs/guides/tracking-and-replacement","tags":[],"type":"text","url":"/docs/guides/tracking-and-replacement#pause-and-resume-tracking","content":"Use this sparingly for synchronization or hydration that should be invisible to history. For a normal user edit, use `setState()` without pausing.","locale":"en"},"2509":{"id":"/docs/guides/tracking-and-replacement-11","page_id":"/docs/guides/tracking-and-replacement","tags":[],"type":"text","url":"/docs/guides/tracking-and-replacement#replace-state-without-history","content":"`replaceStateWithoutHistory(updater)` applies a direct value or recipe, clears retained history, and makes the result the new baseline:","locale":"en"},"2510":{"id":"/docs/guides/tracking-and-replacement-12","page_id":"/docs/guides/tracking-and-replacement","tags":[],"type":"text","url":"/docs/guides/tracking-and-replacement#replace-state-without-history","content":"It is a good fit for switching documents, accepting an authoritative server snapshot, or resetting external store data. It is intentionally destructive to the old timeline.","locale":"en"},"2511":{"id":"/docs/guides/tracking-and-replacement-13","page_id":"/docs/guides/tracking-and-replacement","tags":[],"type":"text","url":"/docs/guides/tracking-and-replacement#replace-state-without-history","content":"If the update throws, the replacement and history clearing do not commit. Wrappers that intercept `setState()` also run for this operation because replacement applies its update through that path. A wrapper that silently returns can leave a cleared timeline with unchanged state; throw when a blocked replacement must preserve history.","locale":"en"},"2512":{"id":"/docs/guides/tracking-and-replacement-14","page_id":"/docs/guides/tracking-and-replacement","tags":[],"type":"text","url":"/docs/guides/tracking-and-replacement#rebase-current-state","content":"Unlike replacement, `rebase()` does not load a new state. It keeps the current state, including unarchived temp patches, and discards all retained past and future history:","locale":"en"},"2513":{"id":"/docs/guides/tracking-and-replacement-15","page_id":"/docs/guides/tracking-and-replacement","tags":[],"type":"text","url":"/docs/guides/tracking-and-replacement#rebase-current-state","content":"Use it when current state becomes the clean starting point. Controlled journals expose `rebase()` as the safe way to clear history while preserving externally owned state.","locale":"en"},"2514":{"id":"/docs/guides/tracking-and-replacement-16","page_id":"/docs/guides/tracking-and-replacement","tags":[],"type":"text","url":"/docs/guides/tracking-and-replacement#reset-to-the-existing-baseline","content":"`reset()` returns to the baseline rather than creating a new one. The baseline may be the original creation state, the validated restore baseline, or the result of a later rebase/replacement/paused update.","locale":"en"},"2515":{"id":"/docs/guides/tracking-and-replacement-17","page_id":"/docs/guides/tracking-and-replacement","tags":[],"type":"text","url":"/docs/guides/tracking-and-replacement#reset-to-the-existing-baseline","content":"| Operation                  | Changes current state | Clears history         | Establishes a new baseline |\n| -------------------------- | --------------------- | ---------------------- | -------------------------- |\n| `pauseTracking()` + update | Yes, through updater  | Yes, on a state change | Yes                        |","locale":"en","table":"table-0"},"2516":{"id":"/docs/guides/tracking-and-replacement-18","page_id":"/docs/guides/tracking-and-replacement","tags":[],"type":"text","url":"/docs/guides/tracking-and-replacement#reset-to-the-existing-baseline","content":"| Operation                      | Changes current state | Clears history | Establishes a new baseline |\n| ------------------------------ | --------------------- | -------------- | -------------------------- |\n| `replaceStateWithoutHistory()` | Yes, through updater  | Yes            | Yes                        |","locale":"en","table":"table-0"},"2517":{"id":"/docs/guides/tracking-and-replacement-19","page_id":"/docs/guides/tracking-and-replacement","tags":[],"type":"text","url":"/docs/guides/tracking-and-replacement#reset-to-the-existing-baseline","content":"| Operation  | Changes current state | Clears history | Establishes a new baseline |\n| ---------- | --------------------- | -------------- | -------------------------- |\n| `rebase()` | No                    | Yes            | Yes, current state         |","locale":"en","table":"table-0"},"2518":{"id":"/docs/guides/tracking-and-replacement-20","page_id":"/docs/guides/tracking-and-replacement","tags":[],"type":"text","url":"/docs/guides/tracking-and-replacement#reset-to-the-existing-baseline","content":"| Operation | Changes current state | Clears history | Establishes a new baseline |\n| --------- | --------------------- | -------------- | -------------------------- |\n| `reset()` | Yes, to baseline      | Yes            | No, uses existing baseline |","locale":"en","table":"table-0"},"2519":{"id":"/docs/guides/tracking-and-replacement-21","page_id":"/docs/guides/tracking-and-replacement","tags":[],"type":"text","url":"/docs/guides/tracking-and-replacement#remote-synchronization-caution","content":"Travels does not merge concurrent edits or resolve conflicts. Decide document identity, revision ordering, and conflict handling before replacing or rebasing local state. When history provenance matters, verify the remote snapshot outside Travels before deserialization or replacement. See Security and Integrity.","locale":"en"},"2520":{"id":"/docs/guides/transactions","page_id":"/docs/guides/transactions","type":"page","content":"Transactions","breadcrumbs":["Travels","Guides"],"tags":[],"url":"/docs/guides/transactions","locale":"en"},"2521":{"id":"/docs/guides/transactions-0","page_id":"/docs/guides/transactions","tags":[],"type":"text","url":"/docs/guides/transactions","content":"Group synchronous updates into one atomic history entry and one settled observer event.","locale":"en"},"2522":{"id":"/docs/guides/transactions-1","page_id":"/docs/guides/transactions","type":"heading","tags":[],"url":"/docs/guides/transactions#one-logical-undo-step","content":"One logical undo step","locale":"en"},"2523":{"id":"/docs/guides/transactions-2","page_id":"/docs/guides/transactions","type":"heading","tags":[],"url":"/docs/guides/transactions#atomic-rollback","content":"Atomic rollback","locale":"en"},"2524":{"id":"/docs/guides/transactions-3","page_id":"/docs/guides/transactions","type":"heading","tags":[],"url":"/docs/guides/transactions#synchronous-callbacks-only","content":"Synchronous callbacks only","locale":"en"},"2525":{"id":"/docs/guides/transactions-4","page_id":"/docs/guides/transactions","type":"heading","tags":[],"url":"/docs/guides/transactions#nesting","content":"Nesting","locale":"en"},"2526":{"id":"/docs/guides/transactions-5","page_id":"/docs/guides/transactions","type":"heading","tags":[],"url":"/docs/guides/transactions#updates-that-cancel-out","content":"Updates that cancel out","locale":"en"},"2527":{"id":"/docs/guides/transactions-6","page_id":"/docs/guides/transactions","type":"heading","tags":[],"url":"/docs/guides/transactions#mutable-mode-boundary","content":"Mutable-mode boundary","locale":"en"},"2528":{"id":"/docs/guides/transactions-7","page_id":"/docs/guides/transactions","type":"heading","tags":[],"url":"/docs/guides/transactions#choosing-transactions-or-manual-archives","content":"Choosing transactions or manual archives","locale":"en"},"2529":{"id":"/docs/guides/transactions-8","page_id":"/docs/guides/transactions","tags":[],"type":"text","url":"/docs/guides/transactions","content":"Use `transaction()` when several Travels operations form one logical edit. `batch()` is an alias with the same overloads and behavior.","locale":"en"},"2530":{"id":"/docs/guides/transactions-9","page_id":"/docs/guides/transactions","tags":[],"type":"text","url":"/docs/guides/transactions#one-logical-undo-step","content":"The root transaction composes its updates into one history entry. State listeners and devtools receive one final `transaction` event after commit, not provisional `setState` events for each internal step.","locale":"en"},"2531":{"id":"/docs/guides/transactions-10","page_id":"/docs/guides/transactions","tags":[],"type":"text","url":"/docs/guides/transactions#one-logical-undo-step","content":"You can omit metadata or pass it as the first argument:","locale":"en"},"2532":{"id":"/docs/guides/transactions-11","page_id":"/docs/guides/transactions","tags":[],"type":"text","url":"/docs/guides/transactions#atomic-rollback","content":"If the callback throws, Travels rolls back changes made through its APIs and publishes neither provisional states nor rollback compensation events.","locale":"en"},"2533":{"id":"/docs/guides/transactions-12","page_id":"/docs/guides/transactions","tags":[],"type":"text","url":"/docs/guides/transactions#atomic-rollback","content":"A failure is reported as `TRANSACTION_FAILED` where appropriate, with the underlying error available as `cause`. `onError` observes errors after the root settles, so it never sees an unsettled nested transaction state.","locale":"en"},"2534":{"id":"/docs/guides/transactions-13","page_id":"/docs/guides/transactions","tags":[],"type":"text","url":"/docs/guides/transactions#synchronous-callbacks-only","content":"Do not pass an async function or return a Promise from the callback. Await network and storage work before starting the transaction:","locale":"en"},"2535":{"id":"/docs/guides/transactions-14","page_id":"/docs/guides/transactions","tags":[],"type":"text","url":"/docs/guides/transactions#synchronous-callbacks-only","content":"A rejected asynchronous callback is rolled back and reported as an async callback failure. Keeping the transaction synchronous is what makes its atomic history and observer boundaries possible.","locale":"en"},"2536":{"id":"/docs/guides/transactions-15","page_id":"/docs/guides/transactions","tags":[],"type":"text","url":"/docs/guides/transactions#nesting","content":"Nested transactions remain private until the root commits. Observer events, devtools, branch-discard notifications, and `onError` follow the settled root result.","locale":"en"},"2537":{"id":"/docs/guides/transactions-16","page_id":"/docs/guides/transactions","tags":[],"type":"text","url":"/docs/guides/transactions#nesting","content":"Successful nested work joins the root operation.","locale":"en"},"2538":{"id":"/docs/guides/transactions-17","page_id":"/docs/guides/transactions","tags":[],"type":"text","url":"/docs/guides/transactions#nesting","content":"A failure bubbling through nested scopes is reported once.","locale":"en"},"2539":{"id":"/docs/guides/transactions-18","page_id":"/docs/guides/transactions","tags":[],"type":"text","url":"/docs/guides/transactions#nesting","content":"Redo branches created and discarded entirely inside provisional work are not reported as externally visible discarded history.","locale":"en"},"2540":{"id":"/docs/guides/transactions-19","page_id":"/docs/guides/transactions","tags":[],"type":"text","url":"/docs/guides/transactions#nesting","content":"Do not synchronously mutate the timeline from observers after commit; schedule follow-up work instead.","locale":"en"},"2541":{"id":"/docs/guides/transactions-20","page_id":"/docs/guides/transactions","tags":[],"type":"text","url":"/docs/guides/transactions#updates-that-cancel-out","content":"A transaction that changes a field and restores its original value can be a no-op: no entry, no event, no revision advance, and the redo branch remains intact. This mirrors a single no-op `setState()`.","locale":"en"},"2542":{"id":"/docs/guides/transactions-21","page_id":"/docs/guides/transactions","tags":[],"type":"text","url":"/docs/guides/transactions#updates-that-cancel-out","content":"If the transaction also navigates, archives, or resets, that timeline operation can still publish even when state updates cancel out. In manual mode, a transaction whose own updates cancel out can leave earlier pending changes pending; other successful root transactions archive earlier pending work into their entry.","locale":"en"},"2543":{"id":"/docs/guides/transactions-22","page_id":"/docs/guides/transactions","tags":[],"type":"text","url":"/docs/guides/transactions#mutable-mode-boundary","content":"Mutable rollback replays inverse patches only for writes made through Travels APIs. Direct writes to the live object are outside the journal and survive rollback:","locale":"en"},"2544":{"id":"/docs/guides/transactions-23","page_id":"/docs/guides/transactions","tags":[],"type":"text","url":"/docs/guides/transactions#mutable-mode-boundary","content":"Route every write that must share the transaction boundary through `setState()`. MobX, Vue, or Pinia observers attached directly to the live object can see provisional in-place writes even though Travels observers only see the settled root event.","locale":"en"},"2545":{"id":"/docs/guides/transactions-24","page_id":"/docs/guides/transactions","tags":[],"type":"text","url":"/docs/guides/transactions#choosing-transactions-or-manual-archives","content":"Use a **transaction** for a synchronous, atomic operation with one final event and rollback. Use **manual archive mode** when updates happen over time—during a drag, across several field events, or until an application-defined commit—and immediate current-state visibility is desired.","locale":"en"},"2546":{"id":"/docs/guides/updating-state","page_id":"/docs/guides/updating-state","type":"page","content":"Updating State","breadcrumbs":["Travels","Guides"],"tags":[],"url":"/docs/guides/updating-state","locale":"en"},"2547":{"id":"/docs/guides/updating-state-0","page_id":"/docs/guides/updating-state","tags":[],"type":"text","url":"/docs/guides/updating-state","content":"Use draft mutations, replacement values, metadata, and synchronous updates correctly.","locale":"en"},"2548":{"id":"/docs/guides/updating-state-1","page_id":"/docs/guides/updating-state","type":"heading","tags":[],"url":"/docs/guides/updating-state#draft-mutation--recommended","content":"Draft mutation — recommended","locale":"en"},"2549":{"id":"/docs/guides/updating-state-2","page_id":"/docs/guides/updating-state","type":"heading","tags":[],"url":"/docs/guides/updating-state#direct-replacement","content":"Direct replacement","locale":"en"},"2550":{"id":"/docs/guides/updating-state-3","page_id":"/docs/guides/updating-state","type":"heading","tags":[],"url":"/docs/guides/updating-state#function-returning-a-new-state","content":"Function returning a new state","locale":"en"},"2551":{"id":"/docs/guides/updating-state-4","page_id":"/docs/guides/updating-state","type":"heading","tags":[],"url":"/docs/guides/updating-state#synchronous-boundary","content":"Synchronous boundary","locale":"en"},"2552":{"id":"/docs/guides/updating-state-5","page_id":"/docs/guides/updating-state","type":"heading","tags":[],"url":"/docs/guides/updating-state#metadata","content":"Metadata","locale":"en"},"2553":{"id":"/docs/guides/updating-state-6","page_id":"/docs/guides/updating-state","type":"heading","tags":[],"url":"/docs/guides/updating-state#no-op-updates","content":"No-op updates","locale":"en"},"2554":{"id":"/docs/guides/updating-state-7","page_id":"/docs/guides/updating-state","type":"heading","tags":[],"url":"/docs/guides/updating-state#read-state-write-through-travels","content":"Read state, write through Travels","locale":"en"},"2555":{"id":"/docs/guides/updating-state-8","page_id":"/docs/guides/updating-state","type":"heading","tags":[],"url":"/docs/guides/updating-state#validate-before-commit","content":"Validate before commit","locale":"en"},"2556":{"id":"/docs/guides/updating-state-9","page_id":"/docs/guides/updating-state","tags":[],"type":"text","url":"/docs/guides/updating-state","content":"State-owning timelines accept updates through `setState(updater, metadata?)`. External journals intentionally do not expose this method; their owner records an already-produced patch pair instead.","locale":"en"},"2557":{"id":"/docs/guides/updating-state-10","page_id":"/docs/guides/updating-state","tags":[],"type":"text","url":"/docs/guides/updating-state#draft-mutation--recommended","content":"Mutative turns the recipe into an immutable result by default and gives Travels the forward/inverse patches. Draft mutation usually produces the most precise operations and preserves in-place behavior in mutable mode.","locale":"en"},"2558":{"id":"/docs/guides/updating-state-11","page_id":"/docs/guides/updating-state","tags":[],"type":"text","url":"/docs/guides/updating-state#direct-replacement","content":"Use a direct value when replacing the root is intentional. In mutable mode, replacing the root can require an immutable fallback, so prefer drafting localized changes for reference-stable stores.","locale":"en"},"2559":{"id":"/docs/guides/updating-state-12","page_id":"/docs/guides/updating-state","tags":[],"type":"text","url":"/docs/guides/updating-state#function-returning-a-new-state","content":"A function returning `undefined` is treated as a draft recipe, not as a request to set state to `undefined`. Pass `undefined` directly when `undefined` is genuinely the next state, provided your application accepts the persistence consequences.","locale":"en"},"2560":{"id":"/docs/guides/updating-state-13","page_id":"/docs/guides/updating-state","tags":[],"type":"text","url":"/docs/guides/updating-state#synchronous-boundary","content":"Updater callbacks must finish synchronously. Async functions and Promise-like results are rejected so a later continuation cannot mutate state outside the history transition.","locale":"en"},"2561":{"id":"/docs/guides/updating-state-14","page_id":"/docs/guides/updating-state","tags":[],"type":"text","url":"/docs/guides/updating-state#metadata","content":"Metadata labels an entry without mixing product concerns into document state:","locale":"en"},"2562":{"id":"/docs/guides/updating-state-15","page_id":"/docs/guides/updating-state","tags":[],"type":"text","url":"/docs/guides/updating-state#metadata","content":"Read aligned metadata with `getMetadata()` or entries with `getHistoryEntries()`. Observer events expose the current operation’s metadata. Custom values must obey the same durable contract as state when the timeline will be serialized.","locale":"en"},"2563":{"id":"/docs/guides/updating-state-16","page_id":"/docs/guides/updating-state","tags":[],"type":"text","url":"/docs/guides/updating-state#no-op-updates","content":"An update that produces no patches creates no history entry, publishes no subscriber event, and does not advance `getRevision()`:","locale":"en"},"2564":{"id":"/docs/guides/updating-state-17","page_id":"/docs/guides/updating-state","tags":[],"type":"text","url":"/docs/guides/updating-state#no-op-updates","content":"This keeps repeated form notifications and idempotent actions from bloating history. Mutative’s value semantics determine whether a replacement counts as a change; replacing a value with an equal but distinct object can still produce patches.","locale":"en"},"2565":{"id":"/docs/guides/updating-state-18","page_id":"/docs/guides/updating-state","tags":[],"type":"text","url":"/docs/guides/updating-state#read-state-write-through-travels","content":"`getState()` returns the live state used by history, typed as `S` for store interoperability. Treat it as read-only:","locale":"en"},"2566":{"id":"/docs/guides/updating-state-19","page_id":"/docs/guides/updating-state","tags":[],"type":"text","url":"/docs/guides/updating-state#read-state-write-through-travels","content":"Enable `enableAutoFreeze` in immutable mode to make accidental mutation fail. Copy a value with `structuredClone()` before handing it to code that must mutate it.","locale":"en"},"2567":{"id":"/docs/guides/updating-state-20","page_id":"/docs/guides/updating-state","tags":[],"type":"text","url":"/docs/guides/updating-state#validate-before-commit","content":"The simplest validation boundary is inside the update recipe or before calling it. Throwing prevents the operation from committing. If you wrap `setState()` to add shared validation, forward both the updater and optional metadata, preserve draft versus returned-state behavior, and throw rather than silently returning when history must remain unchanged. Complete wrapper examples are in Advanced Patterns.","locale":"en"},"2568":{"id":"/docs","page_id":"/docs","type":"page","content":"Travels Documentation","breadcrumbs":["Travels"],"tags":[],"url":"/docs","locale":"en"},"2569":{"id":"/docs-0","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"Learn, integrate, and operate patch-based undo/redo with Travels 3.","locale":"en"},"2570":{"id":"/docs-1","page_id":"/docs","type":"heading","tags":[],"url":"/docs#start-with-your-goal","content":"Start with your goal","locale":"en"},"2571":{"id":"/docs-2","page_id":"/docs","type":"heading","tags":[],"url":"/docs#a-complete-example-in-one-minute","content":"A complete example in one minute","locale":"en"},"2572":{"id":"/docs-3","page_id":"/docs","type":"heading","tags":[],"url":"/docs#when-travels-is-a-good-fit","content":"When Travels is a good fit","locale":"en"},"2573":{"id":"/docs-4","page_id":"/docs","type":"heading","tags":[],"url":"/docs#the-public-building-blocks","content":"The public building blocks","locale":"en"},"2574":{"id":"/docs-5","page_id":"/docs","type":"heading","tags":[],"url":"/docs#project-resources","content":"Project resources","locale":"en"},"2575":{"id":"/docs-6","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"Travels is a framework-agnostic state history engine for durable undo/redo. It records forward and inverse JSON Patches, so applications with large state and small, frequent edits can retain compact timelines, persist them, and restore them later.","locale":"en"},"2576":{"id":"/docs-7","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"Write updates with familiar mutation syntax. Travels uses Mutative to produce immutable state by default, while mutable mode and controlled journals support reactive stores and externally owned state.","locale":"en"},"2577":{"id":"/docs-8","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"Version 3 uses explicit factories, one atomic persistence restore path, read-only shared views, and separate capabilities for state-owning timelines and external journals. Upgrading? Start with the Migration Guide.","locale":"en"},"2578":{"id":"/docs-9","page_id":"/docs","tags":[],"type":"text","url":"/docs#start-with-your-goal","content":"<Card title=\"Install and build a timeline\" href=\"/docs/getting-started/installation\" description=\"Requirements, package installation, and a minimal working example.\" />","locale":"en"},"2579":{"id":"/docs-10","page_id":"/docs","tags":[],"type":"text","url":"/docs#start-with-your-goal","content":"<Card title=\"Understand the history model\" href=\"/docs/concepts/how-it-works\" description=\"State, patches, positions, archives, branches, and baselines.\" />","locale":"en"},"2580":{"id":"/docs-11","page_id":"/docs","tags":[],"type":"text","url":"/docs#start-with-your-goal","content":"<Card title=\"Connect your framework\" href=\"/docs/integrations\" description=\"React, Vue, Zustand, MobX, Pinia, forms, and external stores.\" />","locale":"en"},"2581":{"id":"/docs-12","page_id":"/docs","tags":[],"type":"text","url":"/docs#start-with-your-goal","content":"<Card title=\"Persist complete histories\" href=\"/docs/persistence\" description=\"Serialize, validate, restore, migrate, and recover timeline snapshots.\" />","locale":"en"},"2582":{"id":"/docs-13","page_id":"/docs","tags":[],"type":"text","url":"/docs#start-with-your-goal","content":"<Card title=\"Learn advanced behavior\" href=\"/docs/guides\" description=\"Transactions, manual archives, events, mutable state, and journals.\" />","locale":"en"},"2583":{"id":"/docs-14","page_id":"/docs","tags":[],"type":"text","url":"/docs#start-with-your-goal","content":"<Card title=\"Look up an exact API\" href=\"/docs/api-reference\" description=\"Every exported function, class, interface, type alias, and variable.\" />","locale":"en"},"2584":{"id":"/docs-15","page_id":"/docs","tags":[],"type":"text","url":"/docs#a-complete-example-in-one-minute","content":"The next step is the Quick Start, which explains each part of this flow.","locale":"en"},"2585":{"id":"/docs-16","page_id":"/docs","tags":[],"type":"text","url":"/docs#when-travels-is-a-good-fit","content":"Travels is optimized for history size, persistence, and replayable operation logs. It is especially useful for visual editors, form builders, local-first applications, workflow designers, and other editing experiences where users need a safe way to explore.","locale":"en"},"2586":{"id":"/docs-17","page_id":"/docs","tags":[],"type":"text","url":"/docs#when-travels-is-a-good-fit","content":"| Your priority                                     | Recommended approach |\n| ------------------------------------------------- | -------------------- |\n| Large state, small updates, long retained history | Travels              |","locale":"en","table":"table-0"},"2587":{"id":"/docs-18","page_id":"/docs","tags":[],"type":"text","url":"/docs#when-travels-is-a-good-fit","content":"| Your priority                         | Recommended approach |\n| ------------------------------------- | -------------------- |\n| Persist or transmit undo/redo history | Travels              |","locale":"en","table":"table-0"},"2588":{"id":"/docs-19","page_id":"/docs","tags":[],"type":"text","url":"/docs#when-travels-is-a-good-fit","content":"| Your priority                                                | Recommended approach                       |\n| ------------------------------------------------------------ | ------------------------------------------ |\n| Small state, short local-only history, lowest update latency | A snapshot stack may be simpler and faster |","locale":"en","table":"table-0"},"2589":{"id":"/docs-20","page_id":"/docs","tags":[],"type":"text","url":"/docs#when-travels-is-a-good-fit","content":"| Your priority                             | Recommended approach                                           |\n| ----------------------------------------- | -------------------------------------------------------------- |\n| Concurrent multi-user conflict resolution | Use a CRDT/OT system; Travels alone does not resolve conflicts |","locale":"en","table":"table-0"},"2590":{"id":"/docs-21","page_id":"/docs","tags":[],"type":"text","url":"/docs#when-travels-is-a-good-fit","content":"| Your priority                          | Recommended approach                               |\n| -------------------------------------- | -------------------------------------------------- |\n| Full-state replacement on every update | Compare snapshot and patch costs for your workload |","locale":"en","table":"table-0"},"2591":{"id":"/docs-22","page_id":"/docs","tags":[],"type":"text","url":"/docs#when-travels-is-a-good-fit","content":"See Choosing Travels for the full trade-off discussion.","locale":"en"},"2592":{"id":"/docs-23","page_id":"/docs","tags":[],"type":"text","url":"/docs#the-public-building-blocks","content":"`createTravels()` creates a timeline that owns state updates.","locale":"en"},"2593":{"id":"/docs-24","page_id":"/docs","tags":[],"type":"text","url":"/docs#the-public-building-blocks","content":"`createPatchableTravels()` adds compile-time and immediate runtime checks for durable state.","locale":"en"},"2594":{"id":"/docs-25","page_id":"/docs","tags":[],"type":"text","url":"/docs#the-public-building-blocks","content":"`createTravelJournal()` records patch pairs from an external state owner.","locale":"en"},"2595":{"id":"/docs-26","page_id":"/docs","tags":[],"type":"text","url":"/docs#the-public-building-blocks","content":"`restoreTravels()` and `restoreTravelJournal()` restore complete validated snapshots.","locale":"en"},"2596":{"id":"/docs-27","page_id":"/docs","tags":[],"type":"text","url":"/docs#the-public-building-blocks","content":"`Travels.deserialize()` decodes, migrates, and validates persisted input.","locale":"en"},"2597":{"id":"/docs-28","page_id":"/docs","tags":[],"type":"text","url":"/docs#the-public-building-blocks","content":"`getControls()` exposes a narrow, read-only navigation surface for UI components.","locale":"en"},"2598":{"id":"/docs-29","page_id":"/docs","tags":[],"type":"text","url":"/docs#the-public-building-blocks","content":"All exports are documented in the API Reference.","locale":"en"},"2599":{"id":"/docs-30","page_id":"/docs","tags":[],"type":"text","url":"/docs#project-resources","content":"Travels is MIT licensed and written in TypeScript. Find runnable examples in the documentation’s Examples page, or browse the GitHub repository. The official bindings are use-travel for React and zustand-travel for Zustand.","locale":"en"},"2600":{"id":"/docs/integrations/external-stores","page_id":"/docs/integrations/external-stores","type":"page","content":"Forms and External Stores","breadcrumbs":["Travels","Integrations"],"tags":[],"url":"/docs/integrations/external-stores","locale":"en"},"2601":{"id":"/docs/integrations/external-stores-0","page_id":"/docs/integrations/external-stores","tags":[],"type":"text","url":"/docs/integrations/external-stores","content":"Keep a form manager or state runtime authoritative while adding reliable undo/redo history.","locale":"en"},"2602":{"id":"/docs/integrations/external-stores-1","page_id":"/docs/integrations/external-stores","type":"heading","tags":[],"url":"/docs/integrations/external-stores#detached-form-values-with-manual-archive","content":"Detached form values with manual archive","locale":"en"},"2603":{"id":"/docs/integrations/external-stores-2","page_id":"/docs/integrations/external-stores","type":"heading","tags":[],"url":"/docs/integrations/external-stores#keyboard-shortcuts","content":"Keyboard shortcuts","locale":"en"},"2604":{"id":"/docs/integrations/external-stores-3","page_id":"/docs/integrations/external-stores","type":"heading","tags":[],"url":"/docs/integrations/external-stores#when-to-use-a-controlled-journal","content":"When to use a controlled journal","locale":"en"},"2605":{"id":"/docs/integrations/external-stores-4","page_id":"/docs/integrations/external-stores","type":"heading","tags":[],"url":"/docs/integrations/external-stores#decision-guide","content":"Decision guide","locale":"en"},"2606":{"id":"/docs/integrations/external-stores-5","page_id":"/docs/integrations/external-stores","tags":[],"type":"text","url":"/docs/integrations/external-stores","content":"When another library owns state, avoid creating two independent reactive sources of truth. Choose either detached synchronization into a state-owning timeline or a controlled journal fed by the owner’s real patch commits.","locale":"en"},"2607":{"id":"/docs/integrations/external-stores-6","page_id":"/docs/integrations/external-stores","tags":[],"type":"text","url":"/docs/integrations/external-stores#detached-form-values-with-manual-archive","content":"This pattern works well when a form manager exposes `getValues()` and a reset/set-values API but does not already produce JSON Patches.","locale":"en"},"2608":{"id":"/docs/integrations/external-stores-7","page_id":"/docs/integrations/external-stores","tags":[],"type":"text","url":"/docs/integrations/external-stores#detached-form-values-with-manual-archive","content":"Call `syncToHistory()` when form values change and `commitHistoryStep()` at a meaningful product boundary such as blur, save, or a debounced commit. Clone live values in both directions so the form manager cannot later mutate a state object retained by Travels, and Travels does not retain a live form object.","locale":"en"},"2609":{"id":"/docs/integrations/external-stores-8","page_id":"/docs/integrations/external-stores","tags":[],"type":"text","url":"/docs/integrations/external-stores#detached-form-values-with-manual-archive","content":"For `react-hook-form`, `getValues()` maps naturally to the form API and `reset()` can implement `setValues()`.","locale":"en"},"2610":{"id":"/docs/integrations/external-stores-9","page_id":"/docs/integrations/external-stores","tags":[],"type":"text","url":"/docs/integrations/external-stores#keyboard-shortcuts","content":"The returned `handleHistoryKeyDown` supports both macOS and Windows modifiers, normalizes letter casing, and prevents the browser default only when Travels can handle the action. Ignore editable-event targets only when your product’s shortcut policy requires it:","locale":"en"},"2611":{"id":"/docs/integrations/external-stores-10","page_id":"/docs/integrations/external-stores","tags":[],"type":"text","url":"/docs/integrations/external-stores#keyboard-shortcuts","content":"Scope the listener to the active editor rather than registering duplicate global handlers for every mounted form.","locale":"en"},"2612":{"id":"/docs/integrations/external-stores-11","page_id":"/docs/integrations/external-stores","tags":[],"type":"text","url":"/docs/integrations/external-stores#when-to-use-a-controlled-journal","content":"Use `createTravelJournal()` when the external owner already produces the exact `nextState`, `patches`, and `inversePatches` for each commit. This avoids running the update recipe twice and keeps validation/subscription behavior in the owner’s normal commit path.","locale":"en"},"2613":{"id":"/docs/integrations/external-stores-12","page_id":"/docs/integrations/external-stores","tags":[],"type":"text","url":"/docs/integrations/external-stores#when-to-use-a-controlled-journal","content":"The owner must not record delegated navigation again as a new edit. `apply` is synchronous, and Travels cannot roll back external side effects if the owner fails after partially committing. Read the full Controlled Journal contract before choosing this path.","locale":"en"},"2614":{"id":"/docs/integrations/external-stores-13","page_id":"/docs/integrations/external-stores","tags":[],"type":"text","url":"/docs/integrations/external-stores#decision-guide","content":"The form/store returns plain values but no patches: use detached `setState()` synchronization.","locale":"en"},"2615":{"id":"/docs/integrations/external-stores-14","page_id":"/docs/integrations/external-stores","tags":[],"type":"text","url":"/docs/integrations/external-stores#decision-guide","content":"Several change notifications should form one undo step: use manual archive.","locale":"en"},"2616":{"id":"/docs/integrations/external-stores-15","page_id":"/docs/integrations/external-stores","tags":[],"type":"text","url":"/docs/integrations/external-stores#decision-guide","content":"The owner already generates exact forward/inverse patches: use a controlled journal.","locale":"en"},"2617":{"id":"/docs/integrations/external-stores-16","page_id":"/docs/integrations/external-stores","tags":[],"type":"text","url":"/docs/integrations/external-stores#decision-guide","content":"You need provisional changes hidden from Travels observers and automatic rollback: use a synchronous transaction around Travels-owned updates.","locale":"en"},"2618":{"id":"/docs/integrations/external-stores-17","page_id":"/docs/integrations/external-stores","tags":[],"type":"text","url":"/docs/integrations/external-stores#decision-guide","content":"The owner cannot roll back published commits: preflight patch entries with `assertTravelHistoryEntryRecordable()` before publishing when possible.","locale":"en"},"2619":{"id":"/docs/integrations","page_id":"/docs/integrations","type":"page","content":"Framework Integrations","breadcrumbs":["Travels","Integrations"],"tags":[],"url":"/docs/integrations","locale":"en"},"2620":{"id":"/docs/integrations-0","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations","content":"Choose immutable, mutable, official-binding, or externally owned history for your state architecture.","locale":"en"},"2621":{"id":"/docs/integrations-1","page_id":"/docs/integrations","type":"heading","tags":[],"url":"/docs/integrations#choose-an-integration","content":"Choose an integration","locale":"en"},"2622":{"id":"/docs/integrations-2","page_id":"/docs/integrations","type":"heading","tags":[],"url":"/docs/integrations#official-v3-bindings","content":"Official v3 bindings","locale":"en"},"2623":{"id":"/docs/integrations-3","page_id":"/docs/integrations","type":"heading","tags":[],"url":"/docs/integrations#integration-invariants","content":"Integration invariants","locale":"en"},"2624":{"id":"/docs/integrations-4","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations","content":"Travels’ core does not depend on a UI framework. The right integration depends on who owns state and whether your reactive system expects a new reference or stable object identity.","locale":"en"},"2625":{"id":"/docs/integrations-5","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#choose-an-integration","content":"| Framework or owner | Recommended starting point               | History mode |\n| ------------------ | ---------------------------------------- | ------------ |\n| React              | `useSyncExternalStore` or `use-travel@3` | Immutable    |","locale":"en","table":"table-0"},"2626":{"id":"/docs/integrations-6","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#choose-an-integration","content":"| Framework or owner | Recommended starting point      | History mode |\n| ------------------ | ------------------------------- | ------------ |\n| Vue composable     | `shallowRef`/`ref` subscription | Immutable    |","locale":"en","table":"table-0"},"2627":{"id":"/docs/integrations-7","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#choose-an-integration","content":"| Framework or owner         | Recommended starting point        | History mode    |\n| -------------------------- | --------------------------------- | --------------- |\n| Vue reactive store / Pinia | Pass the observed object directly | `mutable: true` |","locale":"en","table":"table-0"},"2628":{"id":"/docs/integrations-8","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#choose-an-integration","content":"| Framework or owner | Recommended starting point                       | History mode              |\n| ------------------ | ------------------------------------------------ | ------------------------- |\n| Zustand            | `zustand-travel@3` or manual external-store sync | Immutable / binding-owned |","locale":"en","table":"table-0"},"2629":{"id":"/docs/integrations-9","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#choose-an-integration","content":"| Framework or owner | Recommended starting point     | History mode    |\n| ------------------ | ------------------------------ | --------------- |\n| MobX               | Pass observable state directly | `mutable: true` |","locale":"en","table":"table-0"},"2630":{"id":"/docs/integrations-10","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#choose-an-integration","content":"| Framework or owner | Recommended starting point                                  | History mode     |\n| ------------------ | ----------------------------------------------------------- | ---------------- |\n| Form manager       | Detached values with manual archive, or an external journal | Depends on owner |","locale":"en","table":"table-0"},"2631":{"id":"/docs/integrations-11","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#choose-an-integration","content":"| Framework or owner                      | Recommended starting point | History mode     |\n| --------------------------------------- | -------------------------- | ---------------- |\n| State machine / existing patch producer | `createTravelJournal()`    | Externally owned |","locale":"en","table":"table-0"},"2632":{"id":"/docs/integrations-12","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#choose-an-integration","content":"<Card title=\"React\" href=\"/docs/integrations/react\" description=\"External-store subscriptions, controls, and component ownership.\" />","locale":"en"},"2633":{"id":"/docs/integrations-13","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#choose-an-integration","content":"<Card title=\"Vue\" href=\"/docs/integrations/vue\" description=\"Immutable composables and reference-stable reactive state.\" />","locale":"en"},"2634":{"id":"/docs/integrations-14","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#choose-an-integration","content":"<Card title=\"Zustand\" href=\"/docs/integrations/zustand\" description=\"Official middleware and direct core integration.\" />","locale":"en"},"2635":{"id":"/docs/integrations-15","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#choose-an-integration","content":"<Card title=\"MobX and Pinia\" href=\"/docs/integrations/mobx-pinia\" description=\"Mutable timelines for identity-sensitive stores.\" />","locale":"en"},"2636":{"id":"/docs/integrations-16","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#choose-an-integration","content":"<Card title=\"Forms and External Stores\" href=\"/docs/integrations/external-stores\" description=\"Single-owner synchronization and delegated navigation.\" />","locale":"en"},"2637":{"id":"/docs/integrations-17","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#official-v3-bindings","content":"`use-travel` provides React hooks and shared-store integration.","locale":"en"},"2638":{"id":"/docs/integrations-18","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#official-v3-bindings","content":"`zustand-travel` provides Zustand middleware.","locale":"en"},"2639":{"id":"/docs/integrations-19","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#official-v3-bindings","content":"Use `travels@^3.0.1` with either v3 binding: `use-travel@3` accepts `travels@^3.0.0`, and `zustand-travel@3` requires `travels@^3.0.1`. Both bindings support `mutative@^2.0.0`. Use matching majors so factory overloads, read-only views, and snapshot restoration share one contract.","locale":"en"},"2640":{"id":"/docs/integrations-20","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#integration-invariants","content":"Regardless of framework:","locale":"en"},"2641":{"id":"/docs/integrations-21","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#integration-invariants","content":"Create one timeline per logical document or editing session.","locale":"en"},"2642":{"id":"/docs/integrations-22","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#integration-invariants","content":"Keep its identity stable for as long as subscribers depend on it.","locale":"en"},"2643":{"id":"/docs/integrations-23","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#integration-invariants","content":"Update through exactly one authoritative state path.","locale":"en"},"2644":{"id":"/docs/integrations-24","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#integration-invariants","content":"Re-render on timeline revision as well as state changes.","locale":"en"},"2645":{"id":"/docs/integrations-25","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#integration-invariants","content":"Unsubscribe when the owner is disposed.","locale":"en"},"2646":{"id":"/docs/integrations-26","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#integration-invariants","content":"Flush pending persistence before controlled shutdown points.","locale":"en"},"2647":{"id":"/docs/integrations-27","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#integration-invariants","content":"Runnable source examples are linked from Examples.","locale":"en"},"2648":{"id":"/docs/integrations/mobx-pinia","page_id":"/docs/integrations/mobx-pinia","type":"page","content":"MobX and Pinia","breadcrumbs":["Travels","Integrations"],"tags":[],"url":"/docs/integrations/mobx-pinia","locale":"en"},"2649":{"id":"/docs/integrations/mobx-pinia-0","page_id":"/docs/integrations/mobx-pinia","tags":[],"type":"text","url":"/docs/integrations/mobx-pinia","content":"Preserve observable store identity with mutable timelines and explicit undoable writes.","locale":"en"},"2650":{"id":"/docs/integrations/mobx-pinia-1","page_id":"/docs/integrations/mobx-pinia","type":"heading","tags":[],"url":"/docs/integrations/mobx-pinia#mobx","content":"MobX","locale":"en"},"2651":{"id":"/docs/integrations/mobx-pinia-2","page_id":"/docs/integrations/mobx-pinia","type":"heading","tags":[],"url":"/docs/integrations/mobx-pinia#pinia-setup-store","content":"Pinia setup store","locale":"en"},"2652":{"id":"/docs/integrations/mobx-pinia-3","page_id":"/docs/integrations/mobx-pinia","type":"heading","tags":[],"url":"/docs/integrations/mobx-pinia#restore-into-the-live-store","content":"Restore into the live store","locale":"en"},"2653":{"id":"/docs/integrations/mobx-pinia-4","page_id":"/docs/integrations/mobx-pinia","type":"heading","tags":[],"url":"/docs/integrations/mobx-pinia#identity-and-root-replacement","content":"Identity and root replacement","locale":"en"},"2654":{"id":"/docs/integrations/mobx-pinia-5","page_id":"/docs/integrations/mobx-pinia","type":"heading","tags":[],"url":"/docs/integrations/mobx-pinia#transactions-and-observers","content":"Transactions and observers","locale":"en"},"2655":{"id":"/docs/integrations/mobx-pinia-6","page_id":"/docs/integrations/mobx-pinia","tags":[],"type":"text","url":"/docs/integrations/mobx-pinia","content":"MobX and Pinia commonly observe a stable object rather than expecting immutable root replacement. Create Travels with `mutable: true` and pass the same object your components observe.","locale":"en"},"2656":{"id":"/docs/integrations/mobx-pinia-7","page_id":"/docs/integrations/mobx-pinia","tags":[],"type":"text","url":"/docs/integrations/mobx-pinia#mobx","content":"`store` and `travels.getState()` remain the same reference for ordinary draft updates. `back()` and `forward()` apply patches to that object so MobX reactions continue to run.","locale":"en"},"2657":{"id":"/docs/integrations/mobx-pinia-8","page_id":"/docs/integrations/mobx-pinia","tags":[],"type":"text","url":"/docs/integrations/mobx-pinia#pinia-setup-store","content":"Expose actions rather than inviting components to assign directly to `state`. Direct Pinia or MobX writes can be appropriate for non-history fields, but they are invisible to undo and transaction rollback.","locale":"en"},"2658":{"id":"/docs/integrations/mobx-pinia-9","page_id":"/docs/integrations/mobx-pinia","tags":[],"type":"text","url":"/docs/integrations/mobx-pinia#restore-into-the-live-store","content":"The restore target is overwritten in place with detached snapshot state. The snapshot remains reusable and is never used as the live store object itself.","locale":"en"},"2659":{"id":"/docs/integrations/mobx-pinia-10","page_id":"/docs/integrations/mobx-pinia","tags":[],"type":"text","url":"/docs/integrations/mobx-pinia#identity-and-root-replacement","content":"Prefer localized draft mutations. Primitive roots, explicit root replacements, and some reset/navigation cases can require immutable fallback. Review the Mutable Mode operation table if your integration depends on strict reference equality.","locale":"en"},"2660":{"id":"/docs/integrations/mobx-pinia-11","page_id":"/docs/integrations/mobx-pinia","tags":[],"type":"text","url":"/docs/integrations/mobx-pinia#identity-and-root-replacement","content":"Do not enable `enableAutoFreeze` with mutable mode. Map and Set remain unsupported even when MobX or Vue can observe them; normalize collections before passing them to Travels.","locale":"en"},"2661":{"id":"/docs/integrations/mobx-pinia-12","page_id":"/docs/integrations/mobx-pinia","tags":[],"type":"text","url":"/docs/integrations/mobx-pinia#transactions-and-observers","content":"A transaction only journals writes made through Travels. Direct `store` mutations survive rollback. Framework observers attached directly to the object can see provisional changes, whereas Travels listeners see one settled root event. Keep side effects and direct writes outside the atomic document update or give them a separate recovery strategy.","locale":"en"},"2662":{"id":"/docs/integrations/react","page_id":"/docs/integrations/react","type":"page","content":"React Integration","breadcrumbs":["Travels","Integrations"],"tags":[],"url":"/docs/integrations/react","locale":"en"},"2663":{"id":"/docs/integrations/react-0","page_id":"/docs/integrations/react","tags":[],"type":"text","url":"/docs/integrations/react","content":"Bind a Travels timeline to React with useSyncExternalStore and revision-based invalidation.","locale":"en"},"2664":{"id":"/docs/integrations/react-1","page_id":"/docs/integrations/react","type":"heading","tags":[],"url":"/docs/integrations/react#a-reusable-external-store-hook","content":"A reusable external-store hook","locale":"en"},"2665":{"id":"/docs/integrations/react-2","page_id":"/docs/integrations/react","type":"heading","tags":[],"url":"/docs/integrations/react#component-owned-timelines","content":"Component-owned timelines","locale":"en"},"2666":{"id":"/docs/integrations/react-3","page_id":"/docs/integrations/react","type":"heading","tags":[],"url":"/docs/integrations/react#restored-shared-timelines","content":"Restored shared timelines","locale":"en"},"2667":{"id":"/docs/integrations/react-4","page_id":"/docs/integrations/react","type":"heading","tags":[],"url":"/docs/integrations/react#side-effects-and-persistence","content":"Side effects and persistence","locale":"en"},"2668":{"id":"/docs/integrations/react-5","page_id":"/docs/integrations/react","type":"heading","tags":[],"url":"/docs/integrations/react#server-rendering","content":"Server rendering","locale":"en"},"2669":{"id":"/docs/integrations/react-6","page_id":"/docs/integrations/react","tags":[],"type":"text","url":"/docs/integrations/react","content":"React works naturally with Travels’ default immutable mode. Subscribe with `useSyncExternalStore`, use `getRevision()` as the invalidation snapshot, and read current state or controls during render.","locale":"en"},"2670":{"id":"/docs/integrations/react-7","page_id":"/docs/integrations/react","tags":[],"type":"text","url":"/docs/integrations/react","content":"For a retained step count, read `event.historyLength` in the subscription. Calling `getHistory().length` after a change reconstructs historical states. Reading `controls.patches` for the first time after a change copies the forward and inverse patches, including their values. Use `controls.patches.patches.length` when the component already reads those patches.","locale":"en"},"2671":{"id":"/docs/integrations/react-8","page_id":"/docs/integrations/react","tags":[],"type":"text","url":"/docs/integrations/react#a-reusable-external-store-hook","content":"`getRevision()` matters because `archive()` and `rebase()` can change timeline controls without changing the state reference. Subscribing only to object identity would leave buttons stale.","locale":"en"},"2672":{"id":"/docs/integrations/react-9","page_id":"/docs/integrations/react","tags":[],"type":"text","url":"/docs/integrations/react#component-owned-timelines","content":"The example above creates a module-level shared timeline. If each component instance should own a different document history, create the timeline once per mounted owner and keep it stable:","locale":"en"},"2673":{"id":"/docs/integrations/react-10","page_id":"/docs/integrations/react","tags":[],"type":"text","url":"/docs/integrations/react#component-owned-timelines","content":"Do not call `createTravels()` unconditionally on every render. Treat `initialState` as initialization input; to load a different document, explicitly replace state or create a new keyed editor owner rather than silently resetting history during render.","locale":"en"},"2674":{"id":"/docs/integrations/react-11","page_id":"/docs/integrations/react","tags":[],"type":"text","url":"/docs/integrations/react#restored-shared-timelines","content":"Restore outside React, then subscribe to the restored instance:","locale":"en"},"2675":{"id":"/docs/integrations/react-12","page_id":"/docs/integrations/react","tags":[],"type":"text","url":"/docs/integrations/react#restored-shared-timelines","content":"For the official hook-based API and restored shared timelines, use `use-travel@3`. Its `useTravelStore` path accepts a restored Travels instance.","locale":"en"},"2676":{"id":"/docs/integrations/react-13","page_id":"/docs/integrations/react","tags":[],"type":"text","url":"/docs/integrations/react#side-effects-and-persistence","content":"Subscribe to persistence outside the render path. Debounce asynchronous writes and flush them at application-controlled shutdown points:","locale":"en"},"2677":{"id":"/docs/integrations/react-14","page_id":"/docs/integrations/react","tags":[],"type":"text","url":"/docs/integrations/react#side-effects-and-persistence","content":"Do not call `setState()`, `back()`, or other timeline mutations during render or synchronously from a Travels observer. Event handlers and appropriately scheduled effects/tasks keep transitions ordered.","locale":"en"},"2678":{"id":"/docs/integrations/react-15","page_id":"/docs/integrations/react","tags":[],"type":"text","url":"/docs/integrations/react#server-rendering","content":"The third `useSyncExternalStore` argument provides the server snapshot. Keep server and initial client timeline data consistent to avoid hydration mismatches. A module-level timeline is application-global on the server; for request-specific data, create ownership at the appropriate request/client boundary instead of sharing documents across users.","locale":"en"},"2679":{"id":"/docs/integrations/vue","page_id":"/docs/integrations/vue","type":"page","content":"Vue Integration","breadcrumbs":["Travels","Integrations"],"tags":[],"url":"/docs/integrations/vue","locale":"en"},"2680":{"id":"/docs/integrations/vue-0","page_id":"/docs/integrations/vue","tags":[],"type":"text","url":"/docs/integrations/vue","content":"Use immutable refs or preserve a reactive store reference with mutable mode.","locale":"en"},"2681":{"id":"/docs/integrations/vue-1","page_id":"/docs/integrations/vue","type":"heading","tags":[],"url":"/docs/integrations/vue#immutable-composable","content":"Immutable composable","locale":"en"},"2682":{"id":"/docs/integrations/vue-2","page_id":"/docs/integrations/vue","type":"heading","tags":[],"url":"/docs/integrations/vue#mutable-reactive-state","content":"Mutable reactive state","locale":"en"},"2683":{"id":"/docs/integrations/vue-3","page_id":"/docs/integrations/vue","type":"heading","tags":[],"url":"/docs/integrations/vue#restoring-into-reactive-state","content":"Restoring into reactive state","locale":"en"},"2684":{"id":"/docs/integrations/vue-4","page_id":"/docs/integrations/vue","type":"heading","tags":[],"url":"/docs/integrations/vue#mutation-and-transaction-caution","content":"Mutation and transaction caution","locale":"en"},"2685":{"id":"/docs/integrations/vue-5","page_id":"/docs/integrations/vue","tags":[],"type":"text","url":"/docs/integrations/vue","content":"Vue supports both Travels ownership styles. Use immutable mode with a ref when replacing state is acceptable, or mutable mode when the timeline must update the same `reactive()` object observed by components.","locale":"en"},"2686":{"id":"/docs/integrations/vue-6","page_id":"/docs/integrations/vue","tags":[],"type":"text","url":"/docs/integrations/vue#immutable-composable","content":"`shallowRef` is appropriate for immutable root replacement and avoids deeply wrapping the state in another reactive layer. `revision` gives components a signal for control-only changes such as `archive()` and `rebase()`.","locale":"en"},"2687":{"id":"/docs/integrations/vue-7","page_id":"/docs/integrations/vue","tags":[],"type":"text","url":"/docs/integrations/vue#immutable-composable","content":"Call `dispose()` from the composable owner’s unmount lifecycle when the timeline is component-scoped. A shared application timeline can instead live in a dedicated store module with an explicit owner.","locale":"en"},"2688":{"id":"/docs/integrations/vue-8","page_id":"/docs/integrations/vue","tags":[],"type":"text","url":"/docs/integrations/vue#mutable-reactive-state","content":"Pass the same reactive object to Travels when replacing its reference would break your store design:","locale":"en"},"2689":{"id":"/docs/integrations/vue-9","page_id":"/docs/integrations/vue","tags":[],"type":"text","url":"/docs/integrations/vue#mutable-reactive-state","content":"Components continue reading `state`; Travels records and applies patches against that same object. Do not combine mutable mode with `enableAutoFreeze`.","locale":"en"},"2690":{"id":"/docs/integrations/vue-10","page_id":"/docs/integrations/vue","tags":[],"type":"text","url":"/docs/integrations/vue#restoring-into-reactive-state","content":"`target` requires mutable mode and a compatible object or array root. Travels overwrites it in place with detached snapshot state, keeping the live object and restored history aligned.","locale":"en"},"2691":{"id":"/docs/integrations/vue-11","page_id":"/docs/integrations/vue","tags":[],"type":"text","url":"/docs/integrations/vue#mutation-and-transaction-caution","content":"Vue watchers attached directly to mutable state can observe provisional writes during a transaction, while Travels subscribers see only the settled root transaction. Direct assignments to `state` bypass Travels and are not rolled back. Route all undoable writes through `travels.setState()`.","locale":"en"},"2692":{"id":"/docs/integrations/vue-12","page_id":"/docs/integrations/vue","tags":[],"type":"text","url":"/docs/integrations/vue#mutation-and-transaction-caution","content":"For a complete store example, continue to MobX and Pinia or browse the Vue source example.","locale":"en"},"2693":{"id":"/docs/integrations/zustand","page_id":"/docs/integrations/zustand","type":"page","content":"Zustand Integration","breadcrumbs":["Travels","Integrations"],"tags":[],"url":"/docs/integrations/zustand","locale":"en"},"2694":{"id":"/docs/integrations/zustand-0","page_id":"/docs/integrations/zustand","tags":[],"type":"text","url":"/docs/integrations/zustand","content":"Use zustand-travel v3 or synchronize a core immutable timeline with a Zustand store.","locale":"en"},"2695":{"id":"/docs/integrations/zustand-1","page_id":"/docs/integrations/zustand","type":"heading","tags":[],"url":"/docs/integrations/zustand#official-middleware","content":"Official middleware","locale":"en"},"2696":{"id":"/docs/integrations/zustand-2","page_id":"/docs/integrations/zustand","type":"heading","tags":[],"url":"/docs/integrations/zustand#direct-core-integration","content":"Direct core integration","locale":"en"},"2697":{"id":"/docs/integrations/zustand-3","page_id":"/docs/integrations/zustand","type":"heading","tags":[],"url":"/docs/integrations/zustand#one-authoritative-update-path","content":"One authoritative update path","locale":"en"},"2698":{"id":"/docs/integrations/zustand-4","page_id":"/docs/integrations/zustand","tags":[],"type":"text","url":"/docs/integrations/zustand","content":"For new Zustand applications, the official `zustand-travel@3` middleware is the most direct integration. The core API remains useful when you need a separate history owner or custom persistence orchestration.","locale":"en"},"2699":{"id":"/docs/integrations/zustand-5","page_id":"/docs/integrations/zustand","tags":[],"type":"text","url":"/docs/integrations/zustand#official-middleware","content":"The optional `snapshot` supplies one complete restored history. Do not also pass a state-owning `Travels` instance; the binding owns the timeline integration. Initializer functions define actions, while snapshot data supplies the restored baseline.","locale":"en"},"2700":{"id":"/docs/integrations/zustand-6","page_id":"/docs/integrations/zustand","tags":[],"type":"text","url":"/docs/integrations/zustand#official-middleware","content":"When no restore is needed, omit `snapshot` and let the initializer define the starting state. Consult the binding’s own documentation for its returned controls and hook API.","locale":"en"},"2701":{"id":"/docs/integrations/zustand-7","page_id":"/docs/integrations/zustand","tags":[],"type":"text","url":"/docs/integrations/zustand#direct-core-integration","content":"A small manual adapter can mirror an immutable Travels state into Zustand:","locale":"en"},"2702":{"id":"/docs/integrations/zustand-8","page_id":"/docs/integrations/zustand","tags":[],"type":"text","url":"/docs/integrations/zustand#direct-core-integration","content":"The subscription also synchronizes undo, redo, reset, and other navigation. Keep the subscription for the store’s lifetime or dispose it with the application store.","locale":"en"},"2703":{"id":"/docs/integrations/zustand-9","page_id":"/docs/integrations/zustand","tags":[],"type":"text","url":"/docs/integrations/zustand#direct-core-integration","content":"For control-only updates such as manual `archive()` and `rebase()`, mirror `getRevision()` into the store as well if components read `controls.canBack()` or `controls.position` and do not otherwise re-render.","locale":"en"},"2704":{"id":"/docs/integrations/zustand-10","page_id":"/docs/integrations/zustand","tags":[],"type":"text","url":"/docs/integrations/zustand#one-authoritative-update-path","content":"Do not let an action write independently to both stores in a way that creates divergent states. Either route updates through Travels and mirror its committed state, or keep Zustand authoritative and use the official binding or a controlled journal.","locale":"en"},"2705":{"id":"/docs/integrations/zustand-11","page_id":"/docs/integrations/zustand","tags":[],"type":"text","url":"/docs/integrations/zustand#one-authoritative-update-path","content":"Avoid passing live mutable references from a separate form/store into immutable Travels without cloning when that owner can later mutate them. Use detached values at the integration boundary.","locale":"en"},"2706":{"id":"/docs/migration","page_id":"/docs/migration","type":"page","content":"Migration Guide","breadcrumbs":["Travels","Migration"],"tags":[],"url":"/docs/migration","locale":"en"},"2707":{"id":"/docs/migration-0","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration","content":"Upgrade to Travels 3 or migrate from snapshot-based history libraries.","locale":"en"},"2708":{"id":"/docs/migration-1","page_id":"/docs/migration","type":"heading","tags":[],"url":"/docs/migration#from-2x-to-30","content":"From 2.x to 3.0","locale":"en"},"2709":{"id":"/docs/migration-2","page_id":"/docs/migration","type":"heading","tags":[],"url":"/docs/migration#create-timelines-through-factories","content":"Create timelines through factories","locale":"en"},"2710":{"id":"/docs/migration-3","page_id":"/docs/migration","type":"heading","tags":[],"url":"/docs/migration#choose-one-state-owner","content":"Choose one state owner","locale":"en"},"2711":{"id":"/docs/migration-4","page_id":"/docs/migration","type":"heading","tags":[],"url":"/docs/migration#remove-auto-freeze-from-mutable-timelines","content":"Remove auto-freeze from mutable timelines","locale":"en"},"2712":{"id":"/docs/migration-5","page_id":"/docs/migration","type":"heading","tags":[],"url":"/docs/migration#treat-shared-views-as-read-only","content":"Treat shared views as read-only","locale":"en"},"2713":{"id":"/docs/migration-6","page_id":"/docs/migration","type":"heading","tags":[],"url":"/docs/migration#restore-through-one-validated-path","content":"Restore through one validated path","locale":"en"},"2714":{"id":"/docs/migration-7","page_id":"/docs/migration","type":"heading","tags":[],"url":"/docs/migration#upgrade-the-official-bindings","content":"Upgrade the official bindings","locale":"en"},"2715":{"id":"/docs/migration-8","page_id":"/docs/migration","type":"heading","tags":[],"url":"/docs/migration#navigation-archives-pending-work-in-one-event","content":"Navigation archives pending work in one event","locale":"en"},"2716":{"id":"/docs/migration-9","page_id":"/docs/migration","type":"heading","tags":[],"url":"/docs/migration#upgrade-mutative-to-2","content":"Upgrade Mutative to 2","locale":"en"},"2717":{"id":"/docs/migration-10","page_id":"/docs/migration","type":"heading","tags":[],"url":"/docs/migration#update-observer-and-runtime-compatibility","content":"Update observer and runtime compatibility","locale":"en"},"2718":{"id":"/docs/migration-11","page_id":"/docs/migration","type":"heading","tags":[],"url":"/docs/migration#from-redux-undo","content":"From Redux-undo","locale":"en"},"2719":{"id":"/docs/migration-12","page_id":"/docs/migration","type":"heading","tags":[],"url":"/docs/migration#from-zundo","content":"From Zundo","locale":"en"},"2720":{"id":"/docs/migration-13","page_id":"/docs/migration","type":"heading","tags":[],"url":"/docs/migration#from-use-travel","content":"From use-travel","locale":"en"},"2721":{"id":"/docs/migration-14","page_id":"/docs/migration","type":"heading","tags":[],"url":"/docs/migration#from-positional-subscribe-callbacks","content":"From Positional Subscribe Callbacks","locale":"en"},"2722":{"id":"/docs/migration-15","page_id":"/docs/migration","type":"heading","tags":[],"url":"/docs/migration#from-mapset-state","content":"From Map/Set State","locale":"en"},"2723":{"id":"/docs/migration-16","page_id":"/docs/migration","type":"heading","tags":[],"url":"/docs/migration#persistence-migration","content":"Persistence Migration","locale":"en"},"2724":{"id":"/docs/migration-17","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#from-2x-to-30","content":"Travels 3 separates state ownership, external journals, shared views, and persistence restoration into distinct public capabilities.","locale":"en"},"2725":{"id":"/docs/migration-18","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#create-timelines-through-factories","content":"`Travels` is no longer constructible. It remains the namespace for `Travels.deserialize()`.","locale":"en"},"2726":{"id":"/docs/migration-19","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#create-timelines-through-factories","content":"`instanceof Travels` no longer works: the right-hand side is a plain object, so the expression throws `TypeError` at runtime and fails to compile in TypeScript. Detect state-owning timelines with `isTravels()` instead:","locale":"en"},"2727":{"id":"/docs/migration-20","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#create-timelines-through-factories","content":"Timelines remain ordinary extensible objects, so the method-wrapping patterns in the Advanced Patterns Guide keep working, and internal calls such as `back()` still go through a wrapped `go()`. Their constructor is not a public entry point: calling `new travels.constructor(...)` throws `INVALID_OPERATION` instead of bypassing factory validation.","locale":"en"},"2728":{"id":"/docs/migration-21","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#create-timelines-through-factories","content":"Use `createPatchableTravels()` when the initial state should be constrained to the durable JSON-shaped state contract at compile time and checked immediately at runtime.","locale":"en"},"2729":{"id":"/docs/migration-22","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#choose-one-state-owner","content":"A state-owning timeline created with `createTravels()` exposes state updates but no `recordPatches()`. An externally owned timeline created with `createTravelJournal()` exposes `recordPatches()`, navigation, and reset, but none of the state-owning update methods.","locale":"en"},"2730":{"id":"/docs/migration-23","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#choose-one-state-owner","content":"Remove `controlledApply` from ordinary `TravelsOptions`. State-only methods are absent from the returned journal object instead of existing as methods that throw when called. Ownership-specific options now fail closed at runtime: `apply` belongs only to journal factories, while `mutable` belongs only to state-owning factories.","locale":"en"},"2731":{"id":"/docs/migration-24","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#choose-one-state-owner","content":"Manual archive capabilities now follow the same rule. `archive()` and `canArchive()` exist only when the factory receives `autoArchive: false`; an automatic timeline omits both methods at runtime and in TypeScript instead of retaining a warning-only `archive()` method.","locale":"en"},"2732":{"id":"/docs/migration-25","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#choose-one-state-owner","content":"Journal generics now use the same `<S, F, A, P>` order as `Travels`. Most call sites infer these parameters and need no change. If v2 code supplied patch options explicitly as the third parameter, insert the archive mode before them:","locale":"en"},"2733":{"id":"/docs/migration-26","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#choose-one-state-owner","content":"Controls types no longer carry the auto-freeze parameter, which no member used. Drop the second type argument:","locale":"en"},"2734":{"id":"/docs/migration-27","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#choose-one-state-owner","content":"The same applies to `TravelsControls`, `ManualTravelsControls`, and `RebasableManualTravelsControls`. The unused `Value` and `InitialValue` helper types have been removed; use `S` or `ReadonlyState<S>` directly.","locale":"en"},"2735":{"id":"/docs/migration-28","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#remove-auto-freeze-from-mutable-timelines","content":"`createTravels()`, `createPatchableTravels()`, and `restoreTravels()` reject `enableAutoFreeze: true` together with `mutable: true` with `INVALID_OPTION`. Mutable mode updates the live state in place, and in 2.x freezing each produced state also froze the parts it shared with that live state, so the next update that wrote to them threw a `TypeError`. Remove `enableAutoFreeze` from mutable timelines:","locale":"en"},"2736":{"id":"/docs/migration-29","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#remove-auto-freeze-from-mutable-timelines","content":"TypeScript reports the pair when `enableAutoFreeze` is the literal `true`, even with a `mutable` flag typed as `boolean`. A freeze flag computed at runtime is rejected when the timeline is created.","locale":"en"},"2737":{"id":"/docs/migration-30","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#treat-shared-views-as-read-only","content":"`getHistory()` now returns `readonly ReadonlyState<S>[]` through both the instance and controls surfaces, so both the shared array and its entries are read-only in TypeScript. `TravelsControls` properties and methods are read-only and the controls object is frozen in every build. Observer events expose state as a borrowed `ReadonlyState<S>` view and patches as `ReadonlyTravelPatches`; their lazily materialized patch containers, groups, operations, and array paths are also frozen.","locale":"en"},"2738":{"id":"/docs/migration-31","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#treat-shared-views-as-read-only","content":"`controls.patches` is now a cached, frozen `ReadonlyTravelPatches` view instead of a fresh deep clone on every read. It keeps its reference until history changes. Code that edited the returned object must copy it first with `travels.getPatches()`.","locale":"en"},"2739":{"id":"/docs/migration-32","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#treat-shared-views-as-read-only","content":"Patch operation values can contain nested objects, so observers should still treat the complete event as read-only. Use `getPatches()` for a detached, caller-owned retained-history snapshot.","locale":"en"},"2740":{"id":"/docs/migration-33","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#restore-through-one-validated-path","content":"Remove the state-less `TravelsHistory` input type plus `history`, `initialPatches`, `initialPosition`, and `strictInitialPatches`. Decode stored input with `Travels.deserialize()` and restore the complete snapshot atomically:","locale":"en"},"2741":{"id":"/docs/migration-34","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#restore-through-one-validated-path","content":"Malformed snapshots now throw rather than being discarded. Use `Travels.deserialize(..., { fallback })` when recovery is intentional.","locale":"en"},"2742":{"id":"/docs/migration-35","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#restore-through-one-validated-path","content":"The standalone `deserializeTravelsHistory()` export duplicated `Travels.deserialize()` and has been removed; call `Travels.deserialize()` with the same arguments.","locale":"en"},"2743":{"id":"/docs/migration-36","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#restore-through-one-validated-path","content":"`restoreTravels()` keeps a detached copy of `snapshot.state`; it never mutates the snapshot or a reused fallback. Mutable integrations that attached history to a live observable store must name that store as the restore target:","locale":"en"},"2744":{"id":"/docs/migration-37","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#restore-through-one-validated-path","content":"Travels overwrites `target` in place with the snapshot state, so the store no longer has to be pre-populated to match the restored history.","locale":"en"},"2745":{"id":"/docs/migration-38","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#upgrade-the-official-bindings","content":"`use-travel@3` creates component-owned timelines through `createTravels()`. For a restored shared timeline, restore outside React and pass the instance to `useTravelStore()`:","locale":"en"},"2746":{"id":"/docs/migration-39","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#upgrade-the-official-bindings","content":"`zustand-travel@3` restores one complete serialized history through its exclusive `snapshot` option while Zustand remains the state owner. A state-owning `Travels` instance is intentionally rejected. The initializer still defines action functions; the snapshot supplies the data baseline:","locale":"en"},"2747":{"id":"/docs/migration-40","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#upgrade-the-official-bindings","content":"`use-travel@3` requires `travels@^3.0.0`, while `zustand-travel@3` requires `travels@^3.0.1`; installing `travels@^3.0.1` satisfies both. Publish or install the core major first, then upgrade each binding. This keeps the factory overloads, `restoreTravels()` boundary, read-only shared views, and returned controls on one versioned contract instead of making their behavior depend on peer resolution.","locale":"en"},"2748":{"id":"/docs/migration-41","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#navigation-archives-pending-work-in-one-event","content":"With `autoArchive: false`, navigating while changes are pending archives them as part of the navigation. 2.x published an `archive` event followed by a `go` event; 3.0 stages the pending entry until the navigation succeeds and publishes one `go` event, advancing `getRevision()` once, in both immutable and mutable mode. Listeners that persisted only on `archive` should persist on every committed event:","locale":"en"},"2749":{"id":"/docs/migration-42","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#upgrade-mutative-to-2","content":"Travels 3 requires `mutative@^2.0.0` as its peer dependency. Upgrade it together with Travels:","locale":"en"},"2750":{"id":"/docs/migration-43","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#upgrade-mutative-to-2","content":"Mutative 2 keeps the API that Travels uses, and Travels needs no option changes. Mutative 1.x patches could not undo some updates correctly, such as an array shortened and lengthened again in one recipe, which undo restored with holes, or an element changed from `0` to `-0`, which undo left as `-0`. Mutative 2 records both.","locale":"en"},"2751":{"id":"/docs/migration-44","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#upgrade-mutative-to-2","content":"Check your build for the Mutative 2 runtime changes that reach applications through Travels:","locale":"en"},"2752":{"id":"/docs/migration-45","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#upgrade-mutative-to-2","content":"Mutative 2 builds target ES2018. Transpile `mutative` for engines that support `Proxy` but not ES2018 syntax.","locale":"en"},"2753":{"id":"/docs/migration-46","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#upgrade-mutative-to-2","content":"Mutative reads `process.env.NODE_ENV` to select its development or production build. Define it in every bundle, including bundles that target Node.js. To load ES modules without a bundler, map `mutative` to `mutative/dist/mutative.esm.production.min.mjs`, or load its UMD build with Travels' UMD build.","locale":"en"},"2754":{"id":"/docs/migration-47","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#upgrade-mutative-to-2","content":"Mutative 2 patches hold the objects of the next state as their values instead of deep copies. In immutable mode, an object read from `getState()` is therefore also part of the retained history, and mutating it outside Travels rewrites what redo replays. Treat state as read-only, or enable `enableAutoFreeze` to make such mutations throw. Mutable mode is unaffected, because it stores detached patch values.","locale":"en"},"2755":{"id":"/docs/migration-48","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#upgrade-mutative-to-2","content":"Production builds of Mutative throw `Minified Mutative error #<code>` instead of full messages. Match error codes, not message text, in production.","locale":"en"},"2756":{"id":"/docs/migration-49","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#upgrade-mutative-to-2","content":"If your own code calls Mutative, review its v1 to v2 migration guide.","locale":"en"},"2757":{"id":"/docs/migration-50","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#update-observer-and-runtime-compatibility","content":"Use `TravelsEvent` for both subscribers and devtools. The deprecated `TravelsDevtoolsEvent` alias and the listener-arity-based `LEGACY_SUBSCRIBER` warning have been removed. Positional listeners must be rewritten to accept the single event object.","locale":"en"},"2758":{"id":"/docs/migration-51","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#update-observer-and-runtime-compatibility","content":"Travels 3 requires Node.js 22 or newer and is tested on Node.js 22 and 24.","locale":"en"},"2759":{"id":"/docs/migration-52","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#from-redux-undo","content":"Redux-undo stores whole state snapshots. Travels stores JSON Patch entries.","locale":"en"},"2760":{"id":"/docs/migration-53","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#from-redux-undo","content":"Keep your existing reducer or state updater as the source of state changes.","locale":"en"},"2761":{"id":"/docs/migration-54","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#from-redux-undo","content":"Create a Travels instance with the reducer state.","locale":"en"},"2762":{"id":"/docs/migration-55","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#from-redux-undo","content":"Replace `UNDO` / `REDO` dispatches with `travels.back()` / `travels.forward()`.","locale":"en"},"2763":{"id":"/docs/migration-56","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#from-redux-undo","content":"Use `metadata` labels for undo menu text.","locale":"en"},"2764":{"id":"/docs/migration-57","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#from-redux-undo","content":"Persist with `travels.serialize()` instead of storing the whole Redux-undo history object.","locale":"en"},"2765":{"id":"/docs/migration-58","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#from-redux-undo","content":"Snapshot stacks can still be better for small state and short local-only history. Travels is strongest when serialized history size matters.","locale":"en"},"2766":{"id":"/docs/migration-59","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#from-zundo","content":"Zundo integrates directly with Zustand stores. Travels can be used as a separate history engine:","locale":"en"},"2767":{"id":"/docs/migration-60","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#from-zundo","content":"Keep Zustand as the UI store.","locale":"en"},"2768":{"id":"/docs/migration-61","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#from-zundo","content":"Call `travels.setState(...)` inside store actions.","locale":"en"},"2769":{"id":"/docs/migration-62","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#from-zundo","content":"Sync `travels.getState()` back into Zustand after state changes.","locale":"en"},"2770":{"id":"/docs/migration-63","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#from-zundo","content":"Use `Travels.deserialize(...)` and `restoreTravels(...)` for persisted history.","locale":"en"},"2771":{"id":"/docs/migration-64","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#from-zundo","content":"See `examples/zustand.ts`.","locale":"en"},"2772":{"id":"/docs/migration-65","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#from-use-travel","content":"`use-travel` is a React hook wrapper. Use Travels directly when you need framework-agnostic control, persistence adapters, metadata, or custom store integration.","locale":"en"},"2773":{"id":"/docs/migration-66","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#from-use-travel","content":"Create `const travels = createTravels(initialState)`.","locale":"en"},"2774":{"id":"/docs/migration-67","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#from-use-travel","content":"Subscribe with `useSyncExternalStore(travels.subscribe, travels.getRevision)` and read `travels.getState()` while rendering.","locale":"en"},"2775":{"id":"/docs/migration-68","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#from-use-travel","content":"Expose `travels.getControls()` to components.","locale":"en"},"2776":{"id":"/docs/migration-69","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#from-use-travel","content":"Use `serialize()` / `Travels.deserialize()` for reloads.","locale":"en"},"2777":{"id":"/docs/migration-70","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#from-use-travel","content":"See `examples/react-integration.tsx`.","locale":"en"},"2778":{"id":"/docs/migration-71","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#from-positional-subscribe-callbacks","content":"Subscribers now receive the same `TravelsEvent` object as the `devtools` hook. Replace positional callback parameters with event destructuring:","locale":"en"},"2779":{"id":"/docs/migration-72","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#from-positional-subscribe-callbacks","content":"One shallow-frozen event object is shared by all observers for a notification. Its `patches` property remains an event-local delta and is materialized lazily; the patch containers, groups, operations, and array paths are frozen. Top-level metadata is cloned and frozen on first access. Nested patch values and metadata are event-local but shared by its observers; treat them as read-only. Call `travels.getPatches()` when full retained history is required. `TravelsDevtoolsEvent` was a deprecated alias in 2.x and is removed in 3.0. Callbacks that ignore their arguments, such as external store invalidation functions, can remain unchanged.","locale":"en"},"2780":{"id":"/docs/migration-73","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#from-mapset-state","content":"Travels no longer supports Map or Set in either immutable or mutable state. Initial state and updates fail fast, and restored state or patch payloads containing collections are rejected during structural validation. Normalize collections before creating or updating a Travels instance:","locale":"en"},"2781":{"id":"/docs/migration-74","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#from-mapset-state","content":"Use stable string IDs before converting Maps with non-string or object keys. Keep any Map/Set view required by the application outside Travels and derive it from the normalized state.","locale":"en"},"2782":{"id":"/docs/migration-75","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#from-mapset-state","content":"Do not replay old patch history generated from Map/Set mutations. Such history can contain collection-specific values or non-JSON path locators whose reference identity cannot be migrated reliably. Decode the legacy record outside Travels, materialize its authoritative current state, normalize that state, and create a new history baseline. A persistence codec may convert between application-domain collections and storage, but its output passed to Travels must remain in the supported JSON-shaped contract.","locale":"en"},"2783":{"id":"/docs/migration-76","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#persistence-migration","content":"Older hand-rolled persistence usually saved `{ state, patches, position }`. Convert it with `migrate`:","locale":"en"},"2784":{"id":"/docs/migration-77","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#persistence-migration","content":"Travels 3 has one restore path. Pass the complete result of `Travels.deserialize(...)` to `restoreTravels()`; the former `history`, `initialPatches`, `initialPosition`, and `strictInitialPatches` options no longer exist. Malformed snapshots throw instead of silently starting with an empty timeline.","locale":"en"},"2785":{"id":"/docs/migration-78","page_id":"/docs/migration","tags":[],"type":"text","url":"/docs/migration#persistence-migration","content":"Migration and function-valued fallback callbacks must return synchronously. Complete asynchronous storage or network work before calling `Travels.deserialize(...)`; Promise-like callback results are rejected as `MIGRATION_FAILED` or `FALLBACK_FAILED` without leaking an unhandled rejection.","locale":"en"},"2786":{"id":"/docs/persistence","page_id":"/docs/persistence","type":"page","content":"Persistence","breadcrumbs":["Travels","Persistence"],"tags":[],"url":"/docs/persistence","locale":"en"},"2787":{"id":"/docs/persistence-0","page_id":"/docs/persistence","tags":[],"type":"text","url":"/docs/persistence","content":"Serialize, validate, store, restore, and migrate complete Travels timelines.","locale":"en"},"2788":{"id":"/docs/persistence-1","page_id":"/docs/persistence","type":"heading","tags":[],"url":"/docs/persistence#snapshot-contract","content":"Snapshot contract","locale":"en"},"2789":{"id":"/docs/persistence-2","page_id":"/docs/persistence","type":"heading","tags":[],"url":"/docs/persistence#save-a-snapshot","content":"Save a snapshot","locale":"en"},"2790":{"id":"/docs/persistence-3","page_id":"/docs/persistence","type":"heading","tags":[],"url":"/docs/persistence#restore-a-snapshot","content":"Restore a snapshot","locale":"en"},"2791":{"id":"/docs/persistence-4","page_id":"/docs/persistence","type":"heading","tags":[],"url":"/docs/persistence#restore-into-a-reactive-target","content":"Restore into a reactive target","locale":"en"},"2792":{"id":"/docs/persistence-5","page_id":"/docs/persistence","type":"heading","tags":[],"url":"/docs/persistence#controlled-journal-restore","content":"Controlled journal restore","locale":"en"},"2793":{"id":"/docs/persistence-6","page_id":"/docs/persistence","type":"heading","tags":[],"url":"/docs/persistence#structural-versus-semantic-validation","content":"Structural versus semantic validation","locale":"en"},"2794":{"id":"/docs/persistence-7","page_id":"/docs/persistence","type":"heading","tags":[],"url":"/docs/persistence#choose-storage-deliberately","content":"Choose storage deliberately","locale":"en"},"2795":{"id":"/docs/persistence-8","page_id":"/docs/persistence","tags":[],"type":"text","url":"/docs/persistence","content":"`serialize()` returns a versioned snapshot. Your application chooses how to encode and store it. On **3.0.1**, verify a stored object or JSON string with `Travels.deserialize(stored, { validation: 'semantic' })`, then pass the result to `restoreTravels()`. See the example below.","locale":"en"},"2796":{"id":"/docs/persistence-9","page_id":"/docs/persistence","tags":[],"type":"text","url":"/docs/persistence","content":"The next 3.x minor (unreleased) also accepts `restoreTravels<State>(stored, { validation: 'semantic' })`. On 3.0.1, passing `validation` directly to the restore factory skips semantic validation.","locale":"en"},"2797":{"id":"/docs/persistence-10","page_id":"/docs/persistence","tags":[],"type":"text","url":"/docs/persistence#snapshot-contract","content":"A `TravelsSerializedHistory<S>` contains:","locale":"en"},"2798":{"id":"/docs/persistence-11","page_id":"/docs/persistence","tags":[],"type":"text","url":"/docs/persistence#snapshot-contract","content":"State, retained patch values, patch paths, and metadata must satisfy the durable state contract. `serialize()` clones the returned state, patches, and metadata so later edits do not rewrite the snapshot.","locale":"en"},"2799":{"id":"/docs/persistence-12","page_id":"/docs/persistence","tags":[],"type":"text","url":"/docs/persistence#save-a-snapshot","content":"`strict: true` rejects values that cannot round-trip through the documented JSON contract. Plain `serialize()` does not call `JSON.stringify()`, compress data, or normalize runtime-only values. The explicit strict path is recommended when persistence correctness matters.","locale":"en"},"2800":{"id":"/docs/persistence-13","page_id":"/docs/persistence","tags":[],"type":"text","url":"/docs/persistence#save-a-snapshot","content":"The example above writes on every event for clarity. Production applications normally debounce writes, serialize at save time, queue asynchronous writes, and flush before route transitions or owner disposal. The Storage Adapters guide includes a reusable auto-save pattern.","locale":"en"},"2801":{"id":"/docs/persistence-14","page_id":"/docs/persistence","tags":[],"type":"text","url":"/docs/persistence#restore-a-snapshot","content":"`Travels.deserialize()` accepts a parsed object or JSON string. It always performs structural validation; `validation: 'semantic'` additionally checks reachable patch applicability and reversibility on a detached validation graph.","locale":"en"},"2802":{"id":"/docs/persistence-15","page_id":"/docs/persistence","tags":[],"type":"text","url":"/docs/persistence#restore-a-snapshot","content":"The restored timeline owns a detached copy of snapshot state. Neither the decoded snapshot nor a shared fallback constant becomes the live mutable state.","locale":"en"},"2803":{"id":"/docs/persistence-16","page_id":"/docs/persistence","tags":[],"type":"text","url":"/docs/persistence#restore-into-a-reactive-target","content":"For MobX, Vue, or Pinia, restore into the live store object:","locale":"en"},"2804":{"id":"/docs/persistence-17","page_id":"/docs/persistence","tags":[],"type":"text","url":"/docs/persistence#restore-into-a-reactive-target","content":"`target` requires mutable mode and a compatible root kind. Travels overwrites the target in place with detached snapshot state.","locale":"en"},"2805":{"id":"/docs/persistence-18","page_id":"/docs/persistence","tags":[],"type":"text","url":"/docs/persistence#controlled-journal-restore","content":"When another runtime owns state, restore the journal with its synchronous apply callback:","locale":"en"},"2806":{"id":"/docs/persistence-19","page_id":"/docs/persistence","tags":[],"type":"text","url":"/docs/persistence#controlled-journal-restore","content":"The snapshot state and timeline are accepted as one atomic input. The owner still decides how patches are committed during subsequent navigation.","locale":"en"},"2807":{"id":"/docs/persistence-20","page_id":"/docs/persistence","tags":[],"type":"text","url":"/docs/persistence#structural-versus-semantic-validation","content":"| Mode                   | Checks                                                  | Best fit                                                                       |\n| ---------------------- | ------------------------------------------------------- | ------------------------------------------------------------------------------ |\n| `structural` (default) | Schema, versions, patch shapes, paths, values, position | Trusted input or latency-sensitive restore after another verification boundary |","locale":"en","table":"table-0"},"2808":{"id":"/docs/persistence-21","page_id":"/docs/persistence","tags":[],"type":"text","url":"/docs/persistence#structural-versus-semantic-validation","content":"| Mode       | Checks                                                            | Best fit                                                                    |\n| ---------- | ----------------------------------------------------------------- | --------------------------------------------------------------------------- |\n| `semantic` | Structural checks plus forward/inverse replay and graph isolation | Unverified browser storage, imported files, potentially corrupted snapshots |","locale":"en","table":"table-0"},"2809":{"id":"/docs/persistence-22","page_id":"/docs/persistence","tags":[],"type":"text","url":"/docs/persistence#structural-versus-semantic-validation","content":"Semantic validation cost grows with state shape and reachable history. It proves replay consistency, not authenticity or provenance. See Security and Integrity.","locale":"en"},"2810":{"id":"/docs/persistence-23","page_id":"/docs/persistence","tags":[],"type":"text","url":"/docs/persistence#choose-storage-deliberately","content":"Use **localStorage** only for small snapshots and simple synchronous saves.","locale":"en"},"2811":{"id":"/docs/persistence-24","page_id":"/docs/persistence","tags":[],"type":"text","url":"/docs/persistence#choose-storage-deliberately","content":"Use **IndexedDB**, Dexie, or idb for larger histories and asynchronous storage.","locale":"en"},"2812":{"id":"/docs/persistence-25","page_id":"/docs/persistence","tags":[],"type":"text","url":"/docs/persistence#choose-storage-deliberately","content":"Use localForage or localspace when a key-value API and driver fallback are useful.","locale":"en"},"2813":{"id":"/docs/persistence-26","page_id":"/docs/persistence","tags":[],"type":"text","url":"/docs/persistence#choose-storage-deliberately","content":"Namespace keys by application and document, for example `travels:editor:<documentId>`.","locale":"en"},"2814":{"id":"/docs/persistence-27","page_id":"/docs/persistence","tags":[],"type":"text","url":"/docs/persistence#choose-storage-deliberately","content":"Compress the encoded snapshot before storage when size matters; decompress before deserialization.","locale":"en"},"2815":{"id":"/docs/persistence-28","page_id":"/docs/persistence","tags":[],"type":"text","url":"/docs/persistence#choose-storage-deliberately","content":"Retain a last-known-good generation for important drafts.","locale":"en"},"2816":{"id":"/docs/persistence-29","page_id":"/docs/persistence","tags":[],"type":"text","url":"/docs/persistence#choose-storage-deliberately","content":"<Card title=\"Storage Adapters\" href=\"/docs/persistence/storage-adapters\" description=\"Dexie, idb, localForage, localspace, transactions, and auto-save.\" />","locale":"en"},"2817":{"id":"/docs/persistence-30","page_id":"/docs/persistence","tags":[],"type":"text","url":"/docs/persistence#choose-storage-deliberately","content":"<Card title=\"Migration and Recovery\" href=\"/docs/persistence/migration-and-recovery\" description=\"Schema migration, fallbacks, validation modes, and typed errors.\" />","locale":"en"},"2818":{"id":"/docs/persistence-31","page_id":"/docs/persistence","tags":[],"type":"text","url":"/docs/persistence#choose-storage-deliberately","content":"<Card title=\"Security and Integrity\" href=\"/docs/persistence/security-and-integrity\" description=\"Trust boundaries, provenance, revisions, and multi-device concerns.\" />","locale":"en"},"2819":{"id":"/docs/persistence/migration-and-recovery","page_id":"/docs/persistence/migration-and-recovery","type":"page","content":"Migration and Recovery","breadcrumbs":["Travels","Persistence"],"tags":[],"url":"/docs/persistence/migration-and-recovery","locale":"en"},"2820":{"id":"/docs/persistence/migration-and-recovery-0","page_id":"/docs/persistence/migration-and-recovery","tags":[],"type":"text","url":"/docs/persistence/migration-and-recovery","content":"Migrate older snapshots, select validation depth, and recover intentionally from invalid history.","locale":"en"},"2821":{"id":"/docs/persistence/migration-and-recovery-1","page_id":"/docs/persistence/migration-and-recovery","type":"heading","tags":[],"url":"/docs/persistence/migration-and-recovery#migrate-older-snapshots","content":"Migrate older snapshots","locale":"en"},"2822":{"id":"/docs/persistence/migration-and-recovery-2","page_id":"/docs/persistence/migration-and-recovery","type":"heading","tags":[],"url":"/docs/persistence/migration-and-recovery#recover-with-a-known-safe-fallback","content":"Recover with a known-safe fallback","locale":"en"},"2823":{"id":"/docs/persistence/migration-and-recovery-3","page_id":"/docs/persistence/migration-and-recovery","type":"heading","tags":[],"url":"/docs/persistence/migration-and-recovery#match-replay-options","content":"Match replay options","locale":"en"},"2824":{"id":"/docs/persistence/migration-and-recovery-4","page_id":"/docs/persistence/migration-and-recovery","type":"heading","tags":[],"url":"/docs/persistence/migration-and-recovery#interpret-typed-failures","content":"Interpret typed failures","locale":"en"},"2825":{"id":"/docs/persistence/migration-and-recovery-5","page_id":"/docs/persistence/migration-and-recovery","type":"heading","tags":[],"url":"/docs/persistence/migration-and-recovery#design-a-recovery-flow","content":"Design a recovery flow","locale":"en"},"2826":{"id":"/docs/persistence/migration-and-recovery-6","page_id":"/docs/persistence/migration-and-recovery","type":"heading","tags":[],"url":"/docs/persistence/migration-and-recovery#collection-migrations","content":"Collection migrations","locale":"en"},"2827":{"id":"/docs/persistence/migration-and-recovery-7","page_id":"/docs/persistence/migration-and-recovery","type":"heading","tags":[],"url":"/docs/persistence/migration-and-recovery#application-schema-versus-travels-schema","content":"Application schema versus Travels schema","locale":"en"},"2828":{"id":"/docs/persistence/migration-and-recovery-8","page_id":"/docs/persistence/migration-and-recovery","tags":[],"type":"text","url":"/docs/persistence/migration-and-recovery","content":"Persisted history is application data with its own schema and trust boundary. Version the application’s storage envelope, migrate synchronously before validation, and decide what safe recovery means for each document.","locale":"en"},"2829":{"id":"/docs/persistence/migration-and-recovery-9","page_id":"/docs/persistence/migration-and-recovery","tags":[],"type":"text","url":"/docs/persistence/migration-and-recovery#migrate-older-snapshots","content":"Use `migrate` to transform an older shape into the current `TravelsSerializedHistory` before Travels validates it:","locale":"en"},"2830":{"id":"/docs/persistence/migration-and-recovery-10","page_id":"/docs/persistence/migration-and-recovery","tags":[],"type":"text","url":"/docs/persistence/migration-and-recovery#migrate-older-snapshots","content":"Migration and function-valued fallback callbacks are synchronous. Read storage, fetch remote data, decompress bytes, and verify envelopes before calling `deserialize()`. Promise-like callback results fail with `MIGRATION_FAILED` or `FALLBACK_FAILED`; Travels consumes their rejection to avoid an unhandled Promise rejection.","locale":"en"},"2831":{"id":"/docs/persistence/migration-and-recovery-11","page_id":"/docs/persistence/migration-and-recovery","tags":[],"type":"text","url":"/docs/persistence/migration-and-recovery#recover-with-a-known-safe-fallback","content":"Fallback runs after detected parsing, migration, or validation failure. The fallback itself passes through the selected validation mode. A throwing or invalid fallback reports `FALLBACK_FAILED`.","locale":"en"},"2832":{"id":"/docs/persistence/migration-and-recovery-12","page_id":"/docs/persistence/migration-and-recovery","tags":[],"type":"text","url":"/docs/persistence/migration-and-recovery#recover-with-a-known-safe-fallback","content":"Use a function fallback when each recovery needs a fresh object, although restore also detaches accepted snapshot state. Keep fallback construction synchronous.","locale":"en"},"2833":{"id":"/docs/persistence/migration-and-recovery-13","page_id":"/docs/persistence/migration-and-recovery","tags":[],"type":"text","url":"/docs/persistence/migration-and-recovery#recover-with-a-known-safe-fallback","content":"An internally reversible but unauthorized or unintended alternative history is valid input and does not trigger fallback. Verify signatures, revisions, document identity, or checksums outside Travels before deserialization when those properties matter.","locale":"en"},"2834":{"id":"/docs/persistence/migration-and-recovery-14","page_id":"/docs/persistence/migration-and-recovery","tags":[],"type":"text","url":"/docs/persistence/migration-and-recovery#match-replay-options","content":"When history was recorded using custom Mutative `strict` or `mark` behavior, provide the same settings during semantic validation:","locale":"en"},"2835":{"id":"/docs/persistence/migration-and-recovery-15","page_id":"/docs/persistence/migration-and-recovery","tags":[],"type":"text","url":"/docs/persistence/migration-and-recovery#match-replay-options","content":"Semantic replay does not enable mutable replay or auto-freeze; those output policies do not change patch interpretation. Configure auto-freeze on the restored instance instead. Deserialization does not freeze or mutate caller-owned snapshot objects.","locale":"en"},"2836":{"id":"/docs/persistence/migration-and-recovery-16","page_id":"/docs/persistence/migration-and-recovery","tags":[],"type":"text","url":"/docs/persistence/migration-and-recovery#interpret-typed-failures","content":"`PARSE_ERROR`: input is not valid JSON.","locale":"en"},"2837":{"id":"/docs/persistence/migration-and-recovery-17","page_id":"/docs/persistence/migration-and-recovery","tags":[],"type":"text","url":"/docs/persistence/migration-and-recovery#interpret-typed-failures","content":"`UNSUPPORTED_VERSION`: migrate or reject the schema explicitly.","locale":"en"},"2838":{"id":"/docs/persistence/migration-and-recovery-18","page_id":"/docs/persistence/migration-and-recovery","tags":[],"type":"text","url":"/docs/persistence/migration-and-recovery#interpret-typed-failures","content":"`INVALID_SCHEMA`: snapshot fields, metadata, or cursor are malformed.","locale":"en"},"2839":{"id":"/docs/persistence/migration-and-recovery-19","page_id":"/docs/persistence/migration-and-recovery","tags":[],"type":"text","url":"/docs/persistence/migration-and-recovery#interpret-typed-failures","content":"`INVALID_PATCHES`: patch shape, operation, path, or value is invalid.","locale":"en"},"2840":{"id":"/docs/persistence/migration-and-recovery-20","page_id":"/docs/persistence/migration-and-recovery","tags":[],"type":"text","url":"/docs/persistence/migration-and-recovery#interpret-typed-failures","content":"`INVALID_HISTORY`: reachable entries cannot replay and reverse consistently.","locale":"en"},"2841":{"id":"/docs/persistence/migration-and-recovery-21","page_id":"/docs/persistence/migration-and-recovery","tags":[],"type":"text","url":"/docs/persistence/migration-and-recovery#interpret-typed-failures","content":"`MIGRATION_FAILED` / `FALLBACK_FAILED`: inspect the callback boundary and `cause`.","locale":"en"},"2842":{"id":"/docs/persistence/migration-and-recovery-22","page_id":"/docs/persistence/migration-and-recovery","tags":[],"type":"text","url":"/docs/persistence/migration-and-recovery#interpret-typed-failures","content":"Structural validation does not apply patches, so it cannot detect every replay failure. For unverified storage, semantic validation is the corruption-detection boundary.","locale":"en"},"2843":{"id":"/docs/persistence/migration-and-recovery-23","page_id":"/docs/persistence/migration-and-recovery","tags":[],"type":"text","url":"/docs/persistence/migration-and-recovery#design-a-recovery-flow","content":"For important offline documents:","locale":"en"},"2844":{"id":"/docs/persistence/migration-and-recovery-24","page_id":"/docs/persistence/migration-and-recovery","tags":[],"type":"text","url":"/docs/persistence/migration-and-recovery#design-a-recovery-flow","content":"Read the exact stored bytes and the previous verified generation.","locale":"en"},"2845":{"id":"/docs/persistence/migration-and-recovery-25","page_id":"/docs/persistence/migration-and-recovery","tags":[],"type":"text","url":"/docs/persistence/migration-and-recovery#design-a-recovery-flow","content":"Verify the application envelope, tenant/document identity, and monotonic revision.","locale":"en"},"2846":{"id":"/docs/persistence/migration-and-recovery-26","page_id":"/docs/persistence/migration-and-recovery","tags":[],"type":"text","url":"/docs/persistence/migration-and-recovery#design-a-recovery-flow","content":"Decode or decompress outside Travels.","locale":"en"},"2847":{"id":"/docs/persistence/migration-and-recovery-27","page_id":"/docs/persistence/migration-and-recovery","tags":[],"type":"text","url":"/docs/persistence/migration-and-recovery#design-a-recovery-flow","content":"Migrate to the current snapshot schema.","locale":"en"},"2848":{"id":"/docs/persistence/migration-and-recovery-28","page_id":"/docs/persistence/migration-and-recovery","tags":[],"type":"text","url":"/docs/persistence/migration-and-recovery#design-a-recovery-flow","content":"Run semantic validation for unverified input.","locale":"en"},"2849":{"id":"/docs/persistence/migration-and-recovery-29","page_id":"/docs/persistence/migration-and-recovery","tags":[],"type":"text","url":"/docs/persistence/migration-and-recovery#design-a-recovery-flow","content":"Restore into a detached state or explicit mutable target.","locale":"en"},"2850":{"id":"/docs/persistence/migration-and-recovery-30","page_id":"/docs/persistence/migration-and-recovery","tags":[],"type":"text","url":"/docs/persistence/migration-and-recovery#design-a-recovery-flow","content":"If any step fails, restore a trusted default or last-known-good generation and report the stable error code.","locale":"en"},"2851":{"id":"/docs/persistence/migration-and-recovery-31","page_id":"/docs/persistence/migration-and-recovery","tags":[],"type":"text","url":"/docs/persistence/migration-and-recovery#design-a-recovery-flow","content":"Preserve the bad payload for diagnostics when privacy policy permits; do not overwrite it immediately with a blank snapshot before the user or support flow can inspect it.","locale":"en"},"2852":{"id":"/docs/persistence/migration-and-recovery-32","page_id":"/docs/persistence/migration-and-recovery","tags":[],"type":"text","url":"/docs/persistence/migration-and-recovery#collection-migrations","content":"Do not replay old Map/Set-specific patch histories after normalizing current state. Reference-based collection paths and values cannot be migrated reliably as generic JSON Patch. Materialize the authoritative current state outside Travels, convert it to supported plain objects and dense arrays, then create a new history baseline.","locale":"en"},"2853":{"id":"/docs/persistence/migration-and-recovery-33","page_id":"/docs/persistence/migration-and-recovery","tags":[],"type":"text","url":"/docs/persistence/migration-and-recovery#application-schema-versus-travels-schema","content":"`TRAVELS_HISTORY_SCHEMA_VERSION` versions the history envelope, not your document’s business fields. Keep a separate application schema version in the outer storage record when document migrations are needed, and perform them before creating or restoring Travels state.","locale":"en"},"2854":{"id":"/docs/persistence/security-and-integrity","page_id":"/docs/persistence/security-and-integrity","type":"page","content":"Security and Integrity","breadcrumbs":["Travels","Persistence"],"tags":[],"url":"/docs/persistence/security-and-integrity","locale":"en"},"2855":{"id":"/docs/persistence/security-and-integrity-0","page_id":"/docs/persistence/security-and-integrity","tags":[],"type":"text","url":"/docs/persistence/security-and-integrity","content":"Understand what semantic validation proves and where authentication, revisions, and conflict handling belong.","locale":"en"},"2856":{"id":"/docs/persistence/security-and-integrity-1","page_id":"/docs/persistence/security-and-integrity","type":"heading","tags":[],"url":"/docs/persistence/security-and-integrity#put-verification-before-deserialization","content":"Put verification before deserialization","locale":"en"},"2857":{"id":"/docs/persistence/security-and-integrity-2","page_id":"/docs/persistence/security-and-integrity","type":"heading","tags":[],"url":"/docs/persistence/security-and-integrity#choose-controls-for-the-trust-model","content":"Choose controls for the trust model","locale":"en"},"2858":{"id":"/docs/persistence/security-and-integrity-3","page_id":"/docs/persistence/security-and-integrity","type":"heading","tags":[],"url":"/docs/persistence/security-and-integrity#snapshot-and-prototype-safety","content":"Snapshot and prototype safety","locale":"en"},"2859":{"id":"/docs/persistence/security-and-integrity-4","page_id":"/docs/persistence/security-and-integrity","type":"heading","tags":[],"url":"/docs/persistence/security-and-integrity#multi-device-and-collaborative-editing","content":"Multi-device and collaborative editing","locale":"en"},"2860":{"id":"/docs/persistence/security-and-integrity-5","page_id":"/docs/persistence/security-and-integrity","type":"heading","tags":[],"url":"/docs/persistence/security-and-integrity#protect-availability","content":"Protect availability","locale":"en"},"2861":{"id":"/docs/persistence/security-and-integrity-6","page_id":"/docs/persistence/security-and-integrity","type":"heading","tags":[],"url":"/docs/persistence/security-and-integrity#reporting-vulnerabilities","content":"Reporting vulnerabilities","locale":"en"},"2862":{"id":"/docs/persistence/security-and-integrity-7","page_id":"/docs/persistence/security-and-integrity","tags":[],"type":"text","url":"/docs/persistence/security-and-integrity","content":"`Travels.deserialize({ validation: 'semantic' })` proves that the stored anchor and reachable patch entries can replay and reverse consistently on an isolated graph. It does **not** prove who wrote the snapshot, whether it is the latest generation, or whether the reconstructed past is the history originally recorded.","locale":"en"},"2863":{"id":"/docs/persistence/security-and-integrity-8","page_id":"/docs/persistence/security-and-integrity","tags":[],"type":"text","url":"/docs/persistence/security-and-integrity#put-verification-before-deserialization","content":"If external verification fails, discard the unverified snapshot and choose a trusted default or last-known-good generation. Do not expect `fallback` to detect an internally consistent but unauthorized history.","locale":"en"},"2864":{"id":"/docs/persistence/security-and-integrity-9","page_id":"/docs/persistence/security-and-integrity","tags":[],"type":"text","url":"/docs/persistence/security-and-integrity#choose-controls-for-the-trust-model","content":"| Scenario                  | Host-application responsibility                               |\n| ------------------------- | ------------------------------------------------------------- |\n| Ephemeral local undo/redo | Replay validation and a safe fallback are normally sufficient |","locale":"en","table":"table-0"},"2865":{"id":"/docs/persistence/security-and-integrity-10","page_id":"/docs/persistence/security-and-integrity","tags":[],"type":"text","url":"/docs/persistence/security-and-integrity#choose-controls-for-the-trust-model","content":"| Scenario                 | Host-application responsibility                                                          |\n| ------------------------ | ---------------------------------------------------------------------------------------- |\n| Important offline drafts | Checksum exact bytes, keep a monotonic revision, retain a previously verified generation |","locale":"en","table":"table-0"},"2866":{"id":"/docs/persistence/security-and-integrity-11","page_id":"/docs/persistence/security-and-integrity","tags":[],"type":"text","url":"/docs/persistence/security-and-integrity#choose-controls-for-the-trust-model","content":"| Scenario                     | Host-application responsibility                                                                            |\n| ---------------------------- | ---------------------------------------------------------------------------------------------------------- |\n| Multi-device synchronization | Bind tenant/user/document identity to a server-controlled revision and resolve stale/conflicting snapshots |","locale":"en","table":"table-0"},"2867":{"id":"/docs/persistence/security-and-integrity-12","page_id":"/docs/persistence/security-and-integrity","tags":[],"type":"text","url":"/docs/persistence/security-and-integrity#choose-controls-for-the-trust-model","content":"| Scenario                 | Host-application responsibility                                       |\n| ------------------------ | --------------------------------------------------------------------- |\n| Tamper-resistant storage | Verify a server-held HMAC, signature, or authenticated-encryption tag |","locale":"en","table":"table-0"},"2868":{"id":"/docs/persistence/security-and-integrity-13","page_id":"/docs/persistence/security-and-integrity","tags":[],"type":"text","url":"/docs/persistence/security-and-integrity#choose-controls-for-the-trust-model","content":"| Scenario            | Host-application responsibility                                                                  |\n| ------------------- | ------------------------------------------------------------------------------------------------ |\n| Audit-grade history | Use a server-authoritative append-only event log and trusted chain head or equivalent commitment |","locale":"en","table":"table-0"},"2869":{"id":"/docs/persistence/security-and-integrity-14","page_id":"/docs/persistence/security-and-integrity","tags":[],"type":"text","url":"/docs/persistence/security-and-integrity#choose-controls-for-the-trust-model","content":"A checksum detects accidental corruption; it does not authenticate the writer. A key stored beside attacker-controlled browser data does not establish trust. Hash chains and checkpoints inside the same mutable blob can be rewritten together with that blob.","locale":"en"},"2870":{"id":"/docs/persistence/security-and-integrity-15","page_id":"/docs/persistence/security-and-integrity","tags":[],"type":"text","url":"/docs/persistence/security-and-integrity#snapshot-and-prototype-safety","content":"Object-form snapshot fields and patch-container fields must be own data properties. Accessors and inherited fields are rejected without evaluation. Patch groups, array paths, and metadata lists must be plain dense arrays without custom prototypes or own properties; validation uses indexed data-property access rather than input-defined array methods.","locale":"en"},"2871":{"id":"/docs/persistence/security-and-integrity-16","page_id":"/docs/persistence/security-and-integrity","tags":[],"type":"text","url":"/docs/persistence/security-and-integrity#snapshot-and-prototype-safety","content":"These rules reduce input-defined behavior during decoding. Continue treating imported snapshots as untrusted application data: limit payload size and history length at your storage boundary, and avoid logging sensitive document contents.","locale":"en"},"2872":{"id":"/docs/persistence/security-and-integrity-17","page_id":"/docs/persistence/security-and-integrity","tags":[],"type":"text","url":"/docs/persistence/security-and-integrity#multi-device-and-collaborative-editing","content":"Travels is not a CRDT or operational-transform system. It does not merge concurrent histories or resolve conflicting edits. A synchronization layer must define:","locale":"en"},"2873":{"id":"/docs/persistence/security-and-integrity-18","page_id":"/docs/persistence/security-and-integrity","tags":[],"type":"text","url":"/docs/persistence/security-and-integrity#multi-device-and-collaborative-editing","content":"authoritative document and tenant identity;","locale":"en"},"2874":{"id":"/docs/persistence/security-and-integrity-19","page_id":"/docs/persistence/security-and-integrity","tags":[],"type":"text","url":"/docs/persistence/security-and-integrity#multi-device-and-collaborative-editing","content":"ordering and monotonic revisions;","locale":"en"},"2875":{"id":"/docs/persistence/security-and-integrity-20","page_id":"/docs/persistence/security-and-integrity","tags":[],"type":"text","url":"/docs/persistence/security-and-integrity#multi-device-and-collaborative-editing","content":"stale snapshot rejection;","locale":"en"},"2876":{"id":"/docs/persistence/security-and-integrity-21","page_id":"/docs/persistence/security-and-integrity","tags":[],"type":"text","url":"/docs/persistence/security-and-integrity#multi-device-and-collaborative-editing","content":"conflict detection and resolution;","locale":"en"},"2877":{"id":"/docs/persistence/security-and-integrity-22","page_id":"/docs/persistence/security-and-integrity","tags":[],"type":"text","url":"/docs/persistence/security-and-integrity#multi-device-and-collaborative-editing","content":"whether a remote snapshot replaces, rebases, or starts a new local timeline;","locale":"en"},"2878":{"id":"/docs/persistence/security-and-integrity-23","page_id":"/docs/persistence/security-and-integrity","tags":[],"type":"text","url":"/docs/persistence/security-and-integrity#multi-device-and-collaborative-editing","content":"retry behavior when a remote save fails after local state commits.","locale":"en"},"2879":{"id":"/docs/persistence/security-and-integrity-24","page_id":"/docs/persistence/security-and-integrity","tags":[],"type":"text","url":"/docs/persistence/security-and-integrity#multi-device-and-collaborative-editing","content":"When accepting an authoritative remote state without preserving local history, use `replaceStateWithoutHistory()` or restore a validated snapshot. When retaining a local session but clearing old history, use `rebase()` deliberately.","locale":"en"},"2880":{"id":"/docs/persistence/security-and-integrity-25","page_id":"/docs/persistence/security-and-integrity","tags":[],"type":"text","url":"/docs/persistence/security-and-integrity#protect-availability","content":"Semantic replay cost grows with state shape and reachable history. Before validating unverified uploads or sync payloads, enforce application limits for encoded bytes, entry count, nesting, and accepted document types. Use structural validation only after a trusted verification boundary or when schema-only validation is intentionally sufficient.","locale":"en"},"2881":{"id":"/docs/persistence/security-and-integrity-26","page_id":"/docs/persistence/security-and-integrity","tags":[],"type":"text","url":"/docs/persistence/security-and-integrity#protect-availability","content":"Mutable navigation can retain writes made before a replay failure. Semantic validation before restore is therefore both a correctness and availability safeguard for unverified histories.","locale":"en"},"2882":{"id":"/docs/persistence/security-and-integrity-27","page_id":"/docs/persistence/security-and-integrity","tags":[],"type":"text","url":"/docs/persistence/security-and-integrity#reporting-vulnerabilities","content":"For Travels library vulnerabilities, follow the project’s Security Policy. Do not include real user documents, secrets, or private persistence payloads in public issues.","locale":"en"},"2883":{"id":"/docs/persistence/storage-adapters","page_id":"/docs/persistence/storage-adapters","type":"page","content":"Storage Adapters","breadcrumbs":["Travels","Persistence"],"tags":[],"url":"/docs/persistence/storage-adapters","locale":"en"},"2884":{"id":"/docs/persistence/storage-adapters-0","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters","content":"Production-oriented persistence adapters for Dexie, idb, localForage, and localspace.","locale":"en"},"2885":{"id":"/docs/persistence/storage-adapters-1","page_id":"/docs/persistence/storage-adapters","type":"heading","tags":[],"url":"/docs/persistence/storage-adapters#snapshot-contract","content":"Snapshot Contract","locale":"en"},"2886":{"id":"/docs/persistence/storage-adapters-2","page_id":"/docs/persistence/storage-adapters","type":"heading","tags":[],"url":"/docs/persistence/storage-adapters#auto-save-pattern","content":"Auto-Save Pattern","locale":"en"},"2887":{"id":"/docs/persistence/storage-adapters-3","page_id":"/docs/persistence/storage-adapters","type":"heading","tags":[],"url":"/docs/persistence/storage-adapters#dexiejs","content":"Dexie.js","locale":"en"},"2888":{"id":"/docs/persistence/storage-adapters-4","page_id":"/docs/persistence/storage-adapters","type":"heading","tags":[],"url":"/docs/persistence/storage-adapters#idb","content":"idb","locale":"en"},"2889":{"id":"/docs/persistence/storage-adapters-5","page_id":"/docs/persistence/storage-adapters","type":"heading","tags":[],"url":"/docs/persistence/storage-adapters#localforage","content":"localForage","locale":"en"},"2890":{"id":"/docs/persistence/storage-adapters-6","page_id":"/docs/persistence/storage-adapters","type":"heading","tags":[],"url":"/docs/persistence/storage-adapters#localspace","content":"localspace","locale":"en"},"2891":{"id":"/docs/persistence/storage-adapters-7","page_id":"/docs/persistence/storage-adapters","type":"heading","tags":[],"url":"/docs/persistence/storage-adapters#choosing-an-adapter","content":"Choosing an Adapter","locale":"en"},"2892":{"id":"/docs/persistence/storage-adapters-8","page_id":"/docs/persistence/storage-adapters","type":"heading","tags":[],"url":"/docs/persistence/storage-adapters#migration-and-corruption-recovery","content":"Migration and Corruption Recovery","locale":"en"},"2893":{"id":"/docs/persistence/storage-adapters-9","page_id":"/docs/persistence/storage-adapters","type":"heading","tags":[],"url":"/docs/persistence/storage-adapters#integrity-and-provenance","content":"Integrity and Provenance","locale":"en"},"2894":{"id":"/docs/persistence/storage-adapters-10","page_id":"/docs/persistence/storage-adapters","type":"heading","tags":[],"url":"/docs/persistence/storage-adapters#external-references","content":"External References","locale":"en"},"2895":{"id":"/docs/persistence/storage-adapters-11","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters","content":"Travels persistence is storage-agnostic. The only value that needs to be stored is the versioned snapshot returned by `travels.serialize()`. Restore it with `Travels.deserialize(...)`, then pass the validated snapshot to `restoreTravels(...)`.","locale":"en"},"2896":{"id":"/docs/persistence/storage-adapters-12","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters","content":"This guide shows production-oriented adapters for:","locale":"en"},"2897":{"id":"/docs/persistence/storage-adapters-13","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters","content":"Dexie.js","locale":"en"},"2898":{"id":"/docs/persistence/storage-adapters-14","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters","content":"idb","locale":"en"},"2899":{"id":"/docs/persistence/storage-adapters-15","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters","content":"localForage","locale":"en"},"2900":{"id":"/docs/persistence/storage-adapters-16","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters","content":"localspace","locale":"en"},"2901":{"id":"/docs/persistence/storage-adapters-17","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters","content":"The API notes below were checked against the current docs and npm package metadata on 2026-05-15:","locale":"en"},"2902":{"id":"/docs/persistence/storage-adapters-18","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters","content":"| Library  | Checked package | Storage model                                         | Best fit                                                                 |\n| -------- | --------------- | ----------------------------------------------------- | ------------------------------------------------------------------------ |\n| Dexie.js | `dexie@4.4.2`   | IndexedDB tables, indexes, transactions, rich queries | Multiple documents, searchable snapshot catalogs, custom cleanup queries |","locale":"en","table":"table-0"},"2903":{"id":"/docs/persistence/storage-adapters-19","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters","content":"| Library | Checked package | Storage model                              | Best fit                                             |\n| ------- | --------------- | ------------------------------------------ | ---------------------------------------------------- |\n| idb     | `idb@8.0.3`     | Thin promise wrapper over native IndexedDB | Small IndexedDB adapter with explicit schema control |","locale":"en","table":"table-0"},"2904":{"id":"/docs/persistence/storage-adapters-20","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters","content":"| Library     | Checked package      | Storage model                                                                                     | Best fit                                                       |\n| ----------- | -------------------- | ------------------------------------------------------------------------------------------------- | -------------------------------------------------------------- |\n| localForage | `localforage@1.10.0` | Async key-value API over IndexedDB and localStorage, with a legacy WebSQL driver for old browsers | Simple browser key-value persistence with legacy compatibility |","locale":"en","table":"table-0"},"2905":{"id":"/docs/persistence/storage-adapters-21","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters","content":"| Library    | Checked package    | Storage model                                                                                                     | Best fit                                                                                   |\n| ---------- | ------------------ | ----------------------------------------------------------------------------------------------------------------- | ------------------------------------------------------------------------------------------ |\n| localspace | `localspace@1.2.0` | localForage-compatible async key-value API with IndexedDB/localStorage drivers, batch APIs, transactions, plugins | TypeScript-first key-value persistence, batching, plugin-driven TTL/compression/encryption |","locale":"en","table":"table-0"},"2906":{"id":"/docs/persistence/storage-adapters-22","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters","content":"The Playwright e2e suite exercises these adapter patterns against the real browser storage implementations. It also seeds structurally valid but unreplayable histories to verify semantic validation and fallback recovery. The fixture uses test-specific database names, but keeps the save, load, transaction, and cleanup semantics aligned with the examples below.","locale":"en"},"2907":{"id":"/docs/persistence/storage-adapters-23","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#snapshot-contract","content":"Use the whole serialized snapshot as a single storage record. It contains the state, patch history, current position, optional metadata, and the Travels schema version.","locale":"en"},"2908":{"id":"/docs/persistence/storage-adapters-24","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#snapshot-contract","content":"For durable persistence, state, retained patch values, and history metadata must use plain objects, dense arrays, strings, finite numbers other than `-0`, booleans, and `null`. Paths must be Travels-accepted JSON Pointer strings or dense arrays of strings/finite non-negative integers; other values are invalid segments. Encode `bigint`; normalize `NaN`, infinities, and `-0` because JSON rejects or changes them. Array holes and custom properties/prototypes are not preserved by snapshots or JSON/JSON Patch; fill holes with `null` and use plain arrays and objects. Map and Set are rejected as Travels state and retained patch payloads even when IndexedDB or another adapter can store them. A runtime-only value or path in old history remains part of the storage record.","locale":"en"},"2909":{"id":"/docs/persistence/storage-adapters-25","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#snapshot-contract","content":"The adapter examples below reuse the `DocumentState`, `restoreDocument(...)`, and `attachAutoSave(...)` definitions from this section.","locale":"en"},"2910":{"id":"/docs/persistence/storage-adapters-26","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#auto-save-pattern","content":"Storage writes should usually be debounced. This keeps rapid editing from writing one snapshot per keystroke while still persisting the latest committed Travels state.","locale":"en"},"2911":{"id":"/docs/persistence/storage-adapters-27","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#auto-save-pattern","content":"Use `flush()` before route transitions or other app-controlled shutdown points. Use `dispose()` when the Travels instance is no longer active; it clears any pending debounce, removes the subscription, and flushes the latest snapshot by default.","locale":"en"},"2912":{"id":"/docs/persistence/storage-adapters-28","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#auto-save-pattern","content":"If edits must survive a tab close, also call `travels.serialize()` from your page lifecycle handler and run a best-effort final save, or call the returned `flush()` method when the page is still active. Keep that path small: browser shutdown events are not reliable for long async work.","locale":"en"},"2913":{"id":"/docs/persistence/storage-adapters-29","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#dexiejs","content":"Dexie.js is a high-level IndexedDB wrapper with table APIs, schema versioning, indexes, transactions, and bulk operations. It is a good fit when an app stores many persisted timelines and needs to query them by document, timestamp, owner, or project.","locale":"en"},"2914":{"id":"/docs/persistence/storage-adapters-30","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#dexiejs","content":"Install:","locale":"en"},"2915":{"id":"/docs/persistence/storage-adapters-31","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#dexiejs","content":"Adapter:","locale":"en"},"2916":{"id":"/docs/persistence/storage-adapters-32","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#dexiejs","content":"Use a transaction when one user action updates the snapshot and a related table:","locale":"en"},"2917":{"id":"/docs/persistence/storage-adapters-33","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#dexiejs","content":"Use the `updatedAt` index when pruning old snapshot rows:","locale":"en"},"2918":{"id":"/docs/persistence/storage-adapters-34","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#dexiejs","content":"Dexie-specific notes:","locale":"en"},"2919":{"id":"/docs/persistence/storage-adapters-35","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#dexiejs","content":"Use `version(...).stores(...)` for schema evolution.","locale":"en"},"2920":{"id":"/docs/persistence/storage-adapters-36","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#dexiejs","content":"Keep the serialized Travels snapshot in one row when you need atomic restore.","locale":"en"},"2921":{"id":"/docs/persistence/storage-adapters-37","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#dexiejs","content":"Add secondary indexes such as `updatedAt` only for values you actually query.","locale":"en"},"2922":{"id":"/docs/persistence/storage-adapters-38","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#dexiejs","content":"Prefer Dexie when persistence is part of a broader IndexedDB data model, not just a single key-value record.","locale":"en"},"2923":{"id":"/docs/persistence/storage-adapters-39","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#idb","content":"`idb` is a small promise-based wrapper that mostly mirrors native IndexedDB. It is a good fit when you want IndexedDB's object stores, indexes, and transaction semantics without a larger abstraction.","locale":"en"},"2924":{"id":"/docs/persistence/storage-adapters-40","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#idb","content":"Install:","locale":"en"},"2925":{"id":"/docs/persistence/storage-adapters-41","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#idb","content":"Adapter:","locale":"en"},"2926":{"id":"/docs/persistence/storage-adapters-42","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#idb","content":"idb-specific notes:","locale":"en"},"2927":{"id":"/docs/persistence/storage-adapters-43","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#idb","content":"`openDB(name, version, { upgrade })` is where object stores and indexes are created or migrated.","locale":"en"},"2928":{"id":"/docs/persistence/storage-adapters-44","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#idb","content":"Use `db.get(...)`, `db.put(...)`, `db.delete(...)`, and `db.clear(...)` for single-store shortcuts.","locale":"en"},"2929":{"id":"/docs/persistence/storage-adapters-45","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#idb","content":"Use explicit transactions and `await tx.done` when a save includes multiple operations.","locale":"en"},"2930":{"id":"/docs/persistence/storage-adapters-46","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#idb","content":"Do not wait on unrelated async work, such as `fetch(...)`, in the middle of an active IndexedDB transaction. Transactions can auto-close while waiting.","locale":"en"},"2931":{"id":"/docs/persistence/storage-adapters-47","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#localforage","content":"localForage exposes an async `localStorage`-like API with `getItem`, `setItem`, `removeItem`, `clear`, `keys`, and `iterate`. Its documented default driver order is IndexedDB, WebSQL, then localStorage, but WebSQL is obsolete in modern browsers. Treat WebSQL as legacy migration context and design new persistence around IndexedDB.","locale":"en"},"2932":{"id":"/docs/persistence/storage-adapters-48","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#localforage","content":"Install:","locale":"en"},"2933":{"id":"/docs/persistence/storage-adapters-49","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#localforage","content":"Adapter:","locale":"en"},"2934":{"id":"/docs/persistence/storage-adapters-50","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#localforage","content":"localForage-specific notes:","locale":"en"},"2935":{"id":"/docs/persistence/storage-adapters-51","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#localforage","content":"Call `config(...)` before any data API call, or prefer `createInstance(...)` for isolated stores.","locale":"en"},"2936":{"id":"/docs/persistence/storage-adapters-52","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#localforage","content":"`setItem(...)` returns the saved value; `getItem(...)` returns `null` when a key does not exist.","locale":"en"},"2937":{"id":"/docs/persistence/storage-adapters-53","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#localforage","content":"`undefined` is not a durable stored value; use `null` for intentional empty values.","locale":"en"},"2938":{"id":"/docs/persistence/storage-adapters-54","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#localforage","content":"`clear()` removes everything in the current store. Use `removeItem(key)` for a single Travels snapshot.","locale":"en"},"2939":{"id":"/docs/persistence/storage-adapters-55","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#localforage","content":"localForage is a simple key-value adapter. If you need atomic multi-key writes, use IndexedDB directly, Dexie.js, idb, or localspace with IndexedDB as the active driver.","locale":"en"},"2940":{"id":"/docs/persistence/storage-adapters-56","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#localspace","content":"localspace keeps localForage-style storage methods while adding TypeScript-first APIs, batch operations, transaction helpers, plugins, and explicit modern drivers. It supports IndexedDB and localStorage in the browser; WebSQL is not supported. The in-memory driver is available only when explicitly added as a fallback and loses data on reload.","locale":"en"},"2941":{"id":"/docs/persistence/storage-adapters-57","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#localspace","content":"Install:","locale":"en"},"2942":{"id":"/docs/persistence/storage-adapters-58","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#localspace","content":"Adapter:","locale":"en"},"2943":{"id":"/docs/persistence/storage-adapters-59","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#localspace","content":"Use `runTransaction(...)` or batch APIs when saving related records together. This is transactional with the IndexedDB driver; localStorage fallback runs the operations sequentially but cannot provide IndexedDB-style atomic commits:","locale":"en"},"2944":{"id":"/docs/persistence/storage-adapters-60","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#localspace","content":"For multiple timelines:","locale":"en"},"2945":{"id":"/docs/persistence/storage-adapters-61","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#localspace","content":"localspace-specific notes:","locale":"en"},"2946":{"id":"/docs/persistence/storage-adapters-62","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#localspace","content":"Prefer `[localspace.INDEXEDDB, localspace.LOCALSTORAGE]` for durable browser fallback.","locale":"en"},"2947":{"id":"/docs/persistence/storage-adapters-63","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#localspace","content":"Add `localspace.MEMORY` only when runtime-only fallback is acceptable.","locale":"en"},"2948":{"id":"/docs/persistence/storage-adapters-64","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#localspace","content":"Use `setItems(...)`, `getItems(...)`, and `removeItems(...)` for batch workloads. With localStorage fallback, batches are not atomic.","locale":"en"},"2949":{"id":"/docs/persistence/storage-adapters-65","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#localspace","content":"Add `coalesceWrites` only for bursty multi-key writes. For a single debounced `SNAPSHOT_KEY`, it is usually unnecessary.","locale":"en"},"2950":{"id":"/docs/persistence/storage-adapters-66","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#localspace","content":"Set `pluginErrorPolicy: 'strict'` when using encryption so persistence errors do not get swallowed.","locale":"en"},"2951":{"id":"/docs/persistence/storage-adapters-67","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#localspace","content":"Call `destroy()` when disposing plugin-heavy instances.","locale":"en"},"2952":{"id":"/docs/persistence/storage-adapters-68","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#choosing-an-adapter","content":"| Requirement                       | Recommended adapter       |\n| --------------------------------- | ------------------------- |\n| One snapshot per app, minimal API | localForage or localspace |","locale":"en","table":"table-1"},"2953":{"id":"/docs/persistence/storage-adapters-69","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#choosing-an-adapter","content":"| Requirement                                      | Recommended adapter |\n| ------------------------------------------------ | ------------------- |\n| One snapshot per app, strict IndexedDB semantics | idb                 |","locale":"en","table":"table-1"},"2954":{"id":"/docs/persistence/storage-adapters-70","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#choosing-an-adapter","content":"| Requirement                              | Recommended adapter |\n| ---------------------------------------- | ------------------- |\n| Many documents, indexes, cleanup queries | Dexie.js            |","locale":"en","table":"table-1"},"2955":{"id":"/docs/persistence/storage-adapters-71","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#choosing-an-adapter","content":"| Requirement                                            | Recommended adapter |\n| ------------------------------------------------------ | ------------------- |\n| Batch writes and localForage-compatible migration path | localspace          |","locale":"en","table":"table-1"},"2956":{"id":"/docs/persistence/storage-adapters-72","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#choosing-an-adapter","content":"| Requirement                   | Recommended adapter                                                          |\n| ----------------------------- | ---------------------------------------------------------------------------- |\n| Existing localForage codebase | localForage first; localspace when adopting TypeScript-first APIs or batches |","locale":"en","table":"table-1"},"2957":{"id":"/docs/persistence/storage-adapters-73","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#choosing-an-adapter","content":"| Requirement                                           | Recommended adapter          |\n| ----------------------------------------------------- | ---------------------------- |\n| Avoid WebSQL and keep modern browser drivers explicit | localspace, idb, or Dexie.js |","locale":"en","table":"table-1"},"2958":{"id":"/docs/persistence/storage-adapters-74","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#migration-and-corruption-recovery","content":"Use `migrate` when the stored shape predates Travels' current serialized history schema:","locale":"en"},"2959":{"id":"/docs/persistence/storage-adapters-75","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#migration-and-corruption-recovery","content":"`migrate` and function-valued `fallback` are synchronous callbacks. Await storage, network, or other asynchronous work before calling `Travels.deserialize(...)`. Promise-like callback results fail with `MIGRATION_FAILED` or `FALLBACK_FAILED`, and Travels observes their rejection to prevent an unhandled Promise rejection.","locale":"en"},"2960":{"id":"/docs/persistence/storage-adapters-76","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#integrity-and-provenance","content":"`Travels.deserialize(...)` always verifies that a snapshot is structurally valid. With `validation: 'semantic'`, it also verifies that the history can replay consistently in both directions on a detached validation graph, without letting replay mutate the supplied state or patch values. Neither mode proves where the snapshot came from or that a reconstructed past is the history that was originally recorded. Version 1 has no independent trusted history anchor, so an internally reversible alternative history is accepted and does not trigger `fallback`. This boundary is covered by `test/persistence-semantics.test.ts`.","locale":"en"},"2961":{"id":"/docs/persistence/storage-adapters-77","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#integrity-and-provenance","content":"For object-form input, top-level snapshot fields and the patch container's `patches` and `inversePatches` fields must be own data properties. Accessors and inherited fields are rejected without evaluation, and accepted fields are captured once. Patch-history containers, patch groups, array paths, and metadata lists must be plain dense arrays with no custom own properties or prototypes. Frozen plain arrays are valid. Validation and history cloning use indexed data-property access rather than input-defined array methods, so malformed arrays are rejected through the stable persistence error codes.","locale":"en"},"2962":{"id":"/docs/persistence/storage-adapters-78","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#integrity-and-provenance","content":"When integrity or provenance matters, verification MUST happen outside Travels and before deserialization:","locale":"en"},"2963":{"id":"/docs/persistence/storage-adapters-79","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#integrity-and-provenance","content":"If external verification fails, discard the unverified snapshot and restore a trusted default or last-known-good generation. Do not rely on `fallback` to discover an internally consistent alternative history.","locale":"en"},"2964":{"id":"/docs/persistence/storage-adapters-80","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#integrity-and-provenance","content":"Structural validation is the default to preserve the synchronous API's low-latency behavior. It rejects malformed schemas and patch encodings, but it does not prove that navigation will apply successfully. Use explicit semantic validation for unverified or potentially corrupted storage:","locale":"en"},"2965":{"id":"/docs/persistence/storage-adapters-81","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#integrity-and-provenance","content":"Semantic replay detects applicability and reversibility failures before the restored history is used. Its work grows with the reachable history and the containers copied by each patch. A snapshot that has already been authenticated or otherwise verified by a trusted application boundary can use the default structural path when restore latency matters.","locale":"en"},"2966":{"id":"/docs/persistence/storage-adapters-82","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#integrity-and-provenance","content":"Choose the integrity mechanism according to the application's trust model:","locale":"en"},"2967":{"id":"/docs/persistence/storage-adapters-83","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#integrity-and-provenance","content":"| Scenario               | Host-application responsibility                                              |\n| ---------------------- | ---------------------------------------------------------------------------- |\n| Ephemeral UI undo/redo | Travels replay validation and a known-safe fallback are normally sufficient. |","locale":"en","table":"table-2"},"2968":{"id":"/docs/persistence/storage-adapters-84","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#integrity-and-provenance","content":"| Scenario                 | Host-application responsibility                                                                                                                                                                      |\n| ------------------------ | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Important offline drafts | Checksum the exact encoded bytes, store a monotonic revision, and retain at least one previously verified generation. A checksum detects accidental corruption; it does not authenticate the writer. |","locale":"en","table":"table-2"},"2969":{"id":"/docs/persistence/storage-adapters-85","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#integrity-and-provenance","content":"| Scenario                     | Host-application responsibility                                                                                                            |\n| ---------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------ |\n| Multi-device synchronization | Bind document and tenant/user identity to a server-controlled revision, and resolve stale or conflicting snapshots before deserialization. |","locale":"en","table":"table-2"},"2970":{"id":"/docs/persistence/storage-adapters-86","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#integrity-and-provenance","content":"| Scenario                 | Host-application responsibility                                                                                                                               |\n| ------------------------ | ------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Tamper-resistant storage | Verify a server-held HMAC, digital signature, or authenticated-encryption tag. A key stored beside attacker-controlled browser data does not establish trust. |","locale":"en","table":"table-2"},"2971":{"id":"/docs/persistence/storage-adapters-87","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#integrity-and-provenance","content":"| Scenario            | Host-application responsibility                                                                                                                                       |\n| ------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Audit-grade history | Keep a server-authoritative append-only event log and a trusted signed chain head or equivalent commitment. Treat Travels snapshots as reconstructable client caches. |","locale":"en","table":"table-2"},"2972":{"id":"/docs/persistence/storage-adapters-88","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#integrity-and-provenance","content":"Hashing every patch, storing extra checkpoints, or embedding a hash chain in the same mutable blob adds redundancy but cannot by itself prove historical intent; an attacker that can rewrite the blob can rewrite those values too. The trusted checksum, signature, revision, or chain commitment must be controlled outside the snapshot it protects.","locale":"en"},"2973":{"id":"/docs/persistence/storage-adapters-89","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#integrity-and-provenance","content":"Recovery rules:","locale":"en"},"2974":{"id":"/docs/persistence/storage-adapters-90","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#integrity-and-provenance","content":"Always provide `fallback` for browser startup paths. It recovers detected parsing, migration, and validation failures; external integrity failures must select a trusted snapshot before deserialization.","locale":"en"},"2975":{"id":"/docs/persistence/storage-adapters-91","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#integrity-and-provenance","content":"Select `validation: 'semantic'` for unverified snapshots. Use the default structural mode only when schema validation is sufficient or a trusted application boundary has already verified the snapshot.","locale":"en"},"2976":{"id":"/docs/persistence/storage-adapters-92","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#integrity-and-provenance","content":"Use `onError` to log the stable `TravelsPersistenceError.code`; entry-specific `INVALID_HISTORY` replay failures also identify the failing `entryIndex` and replay `direction`, while whole-graph isolation failures omit fields that cannot be attributed truthfully.","locale":"en"},"2977":{"id":"/docs/persistence/storage-adapters-93","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#integrity-and-provenance","content":"When recording uses custom Mutative `strict` or `mark` settings, pass the same values through `replayOptions` so semantic validation uses identical replay rules.","locale":"en"},"2978":{"id":"/docs/persistence/storage-adapters-94","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#integrity-and-provenance","content":"Normalize Map, Set, built-in subclasses, custom own properties, accessors, non-enumerable data, custom array prototypes, and non-zero `RegExp.lastIndex` values at the application boundary; semantic comparison rejects those shapes as unverifiable.","locale":"en"},"2979":{"id":"/docs/persistence/storage-adapters-95","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#integrity-and-provenance","content":"Configure `enableAutoFreeze` on the restored Travels instance; deserialization deliberately avoids freezing caller-owned snapshot objects.","locale":"en"},"2980":{"id":"/docs/persistence/storage-adapters-96","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#integrity-and-provenance","content":"Keep storage keys namespaced, for example `travels:<app>:<documentId>`.","locale":"en"},"2981":{"id":"/docs/persistence/storage-adapters-97","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#integrity-and-provenance","content":"If persistence size matters, compress the serialized snapshot before storage and decompress before `Travels.deserialize(...)`.","locale":"en"},"2982":{"id":"/docs/persistence/storage-adapters-98","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#integrity-and-provenance","content":"If application data contains `bigint`, Date, Map, or Set values, normalize them before creating or updating Travels state. A persistence codec may restore application-domain collections outside Travels, but the state passed to `createTravels(...)` must remain finite numbers, timestamps, records, dense arrays, and the other supported JSON-shaped values.","locale":"en"},"2983":{"id":"/docs/persistence/storage-adapters-99","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#external-references","content":"Dexie.js documentation: https://dexie.org/docs/index","locale":"en"},"2984":{"id":"/docs/persistence/storage-adapters-100","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#external-references","content":"Dexie.js API reference: https://dexie.org/docs/API-Reference","locale":"en"},"2985":{"id":"/docs/persistence/storage-adapters-101","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#external-references","content":"idb README and API: https://github.com/jakearchibald/idb#readme","locale":"en"},"2986":{"id":"/docs/persistence/storage-adapters-102","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#external-references","content":"localForage README: https://github.com/localForage/localForage#readme","locale":"en"},"2987":{"id":"/docs/persistence/storage-adapters-103","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#external-references","content":"localForage API docs: https://github.com/localForage/localForage/blob/master/docs/api.md","locale":"en"},"2988":{"id":"/docs/persistence/storage-adapters-104","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#external-references","content":"localspace README: https://github.com/unadlib/localspace#readme","locale":"en"},"2989":{"id":"/docs/persistence/storage-adapters-105","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#external-references","content":"localspace API reference: https://github.com/unadlib/localspace/blob/main/docs/api-reference.md","locale":"en"},"2990":{"id":"/docs/persistence/storage-adapters-106","page_id":"/docs/persistence/storage-adapters","tags":[],"type":"text","url":"/docs/persistence/storage-adapters#external-references","content":"Chrome Web SQL deprecation timeline: https://developer.chrome.com/blog/web-sql-deprecation-timeline-updated","locale":"en"},"2991":{"id":"/docs/reference/compatibility","page_id":"/docs/reference/compatibility","type":"page","content":"Compatibility Policy","breadcrumbs":["Travels","Reference"],"tags":[],"url":"/docs/reference/compatibility","locale":"en"},"2992":{"id":"/docs/reference/compatibility-0","page_id":"/docs/reference/compatibility","tags":[],"type":"text","url":"/docs/reference/compatibility","content":"Supported runtimes, browsers, state shapes, official bindings, and versioning.","locale":"en"},"2993":{"id":"/docs/reference/compatibility-1","page_id":"/docs/reference/compatibility","type":"heading","tags":[],"url":"/docs/reference/compatibility#runtime-support","content":"Runtime Support","locale":"en"},"2994":{"id":"/docs/reference/compatibility-2","page_id":"/docs/reference/compatibility","type":"heading","tags":[],"url":"/docs/reference/compatibility#browser-support","content":"Browser Support","locale":"en"},"2995":{"id":"/docs/reference/compatibility-3","page_id":"/docs/reference/compatibility","type":"heading","tags":[],"url":"/docs/reference/compatibility#peer-dependencies","content":"Peer Dependencies","locale":"en"},"2996":{"id":"/docs/reference/compatibility-4","page_id":"/docs/reference/compatibility","type":"heading","tags":[],"url":"/docs/reference/compatibility#official-bindings","content":"Official Bindings","locale":"en"},"2997":{"id":"/docs/reference/compatibility-5","page_id":"/docs/reference/compatibility","type":"heading","tags":[],"url":"/docs/reference/compatibility#state-compatibility","content":"State Compatibility","locale":"en"},"2998":{"id":"/docs/reference/compatibility-6","page_id":"/docs/reference/compatibility","type":"heading","tags":[],"url":"/docs/reference/compatibility#versioning","content":"Versioning","locale":"en"},"2999":{"id":"/docs/reference/compatibility-7","page_id":"/docs/reference/compatibility","tags":[],"type":"text","url":"/docs/reference/compatibility#runtime-support","content":"Travels is tested on:","locale":"en"},"3000":{"id":"/docs/reference/compatibility-8","page_id":"/docs/reference/compatibility","tags":[],"type":"text","url":"/docs/reference/compatibility#runtime-support","content":"Node.js 22.x","locale":"en"},"3001":{"id":"/docs/reference/compatibility-9","page_id":"/docs/reference/compatibility","tags":[],"type":"text","url":"/docs/reference/compatibility#runtime-support","content":"Node.js 24.x","locale":"en"},"3002":{"id":"/docs/reference/compatibility-10","page_id":"/docs/reference/compatibility","tags":[],"type":"text","url":"/docs/reference/compatibility#runtime-support","content":"jsdom browser-like environment through Vitest","locale":"en"},"3003":{"id":"/docs/reference/compatibility-11","page_id":"/docs/reference/compatibility","tags":[],"type":"text","url":"/docs/reference/compatibility#runtime-support","content":"Chromium, Firefox, and WebKit through the Playwright integration suite","locale":"en"},"3004":{"id":"/docs/reference/compatibility-12","page_id":"/docs/reference/compatibility","tags":[],"type":"text","url":"/docs/reference/compatibility#runtime-support","content":"Node.js 22 is the minimum supported runtime. The package is distributed as ESM, CJS, UMD, and TypeScript declarations.","locale":"en"},"3005":{"id":"/docs/reference/compatibility-13","page_id":"/docs/reference/compatibility","tags":[],"type":"text","url":"/docs/reference/compatibility#browser-support","content":"Travels targets modern browsers that support the required standard JavaScript and JSON APIs. Persistence examples use `localStorage`, IndexedDB, and BroadcastChannel when available.","locale":"en"},"3006":{"id":"/docs/reference/compatibility-14","page_id":"/docs/reference/compatibility","tags":[],"type":"text","url":"/docs/reference/compatibility#browser-support","content":"Mutative 2 builds target ES2018 and read `process.env.NODE_ENV` to select their development or production build. Bundlers that define `NODE_ENV` handle both. Without a bundler, load `mutative/dist/mutative.esm.production.min.mjs` or Mutative's UMD build, because Mutative's default ES module needs a `process` global.","locale":"en"},"3007":{"id":"/docs/reference/compatibility-15","page_id":"/docs/reference/compatibility","tags":[],"type":"text","url":"/docs/reference/compatibility#peer-dependencies","content":"`mutative` is a peer dependency and is supported at `^2.0.0`. Mutative 1.x is not supported, because some of its patches cannot undo the changes they record. The test suite runs against the repository's pinned development version.","locale":"en"},"3008":{"id":"/docs/reference/compatibility-16","page_id":"/docs/reference/compatibility","tags":[],"type":"text","url":"/docs/reference/compatibility#official-bindings","content":"The v3 official bindings use the public factory capability instead of the internal constructor:","locale":"en"},"3009":{"id":"/docs/reference/compatibility-17","page_id":"/docs/reference/compatibility","tags":[],"type":"text","url":"/docs/reference/compatibility#official-bindings","content":"| Binding      | Binding version | Supported Travels versions | Restored history handoff                         |\n| ------------ | --------------- | -------------------------- | ------------------------------------------------ |\n| `use-travel` | `3.x`           | `^3.0.0`                   | `restoreTravels(snapshot)` then `useTravelStore` |","locale":"en","table":"table-0"},"3010":{"id":"/docs/reference/compatibility-18","page_id":"/docs/reference/compatibility","tags":[],"type":"text","url":"/docs/reference/compatibility#official-bindings","content":"| Binding          | Binding version | Supported Travels versions | Restored history handoff            |\n| ---------------- | --------------- | -------------------------- | ----------------------------------- |\n| `zustand-travel` | `3.x`           | `^3.0.1`                   | `travel(initializer, { snapshot })` |","locale":"en","table":"table-0"},"3011":{"id":"/docs/reference/compatibility-19","page_id":"/docs/reference/compatibility","tags":[],"type":"text","url":"/docs/reference/compatibility#official-bindings","content":"Each binding major declares the same `mutative` peer range as Travels (`^2.0.0`), so the three packages install together without a peer conflict. The binding majors require Travels 3 so their factory overloads, atomic restore path, read-only shared views, and control capabilities have one stable contract. Publish and install the core major first, then validate and release each binding major against that published artifact. Binding-owned timelines remain immutable, and the bindings reject removed or incompatible ownership options rather than silently discarding them.","locale":"en"},"3012":{"id":"/docs/reference/compatibility-20","page_id":"/docs/reference/compatibility","tags":[],"type":"text","url":"/docs/reference/compatibility#state-compatibility","content":"State, retained patch values, and history metadata are supported when they use plain objects, dense arrays, strings, finite numbers other than `-0`, booleans, and `null`. Paths must be Travels-accepted JSON Pointer strings or dense arrays of strings/finite non-negative integers; other values are invalid segments. Object-form snapshot fields and patch-container fields must be own data properties; accessors and inherited fields are rejected without evaluation. Restored history containers, patch groups, array paths, and metadata lists must be plain dense arrays without custom own properties or prototypes; frozen plain arrays are accepted. `bigint` makes `JSON.stringify` throw; `NaN` and infinities become `null`, while `-0` becomes `0`. Normalize those values at the application boundary. Array holes, custom properties, and custom or null prototypes are not durable across patch replay and JSON persistence; fill holes with `null` and use plain arrays and objects. Mutative does not draft null-prototype state dictionaries by default, so nested writes may not produce undoable patches. An incompatible value or path retained only in an older patch still makes the snapshot unsafe.","locale":"en"},"3013":{"id":"/docs/reference/compatibility-21","page_id":"/docs/reference/compatibility","tags":[],"type":"text","url":"/docs/reference/compatibility#state-compatibility","content":"Map and Set are rejected in both immutable and mutable runtime modes. Travels checks initial state and newly generated patch payloads before committing an update; structural restore also rejects collections in state or retained patches. Convert Map entries to a plain record or dense entry array and Set values to a dense array before passing them to Travels; a persistence codec must produce those supported shapes rather than decode collections back into Travels state.","locale":"en"},"3014":{"id":"/docs/reference/compatibility-22","page_id":"/docs/reference/compatibility","tags":[],"type":"text","url":"/docs/reference/compatibility#versioning","content":"Travels follows semver:","locale":"en"},"3015":{"id":"/docs/reference/compatibility-23","page_id":"/docs/reference/compatibility","tags":[],"type":"text","url":"/docs/reference/compatibility#versioning","content":"Patch releases fix bugs without intentional API changes.","locale":"en"},"3016":{"id":"/docs/reference/compatibility-24","page_id":"/docs/reference/compatibility","tags":[],"type":"text","url":"/docs/reference/compatibility#versioning","content":"Minor releases may add APIs and warnings while preserving existing behavior.","locale":"en"},"3017":{"id":"/docs/reference/compatibility-25","page_id":"/docs/reference/compatibility","tags":[],"type":"text","url":"/docs/reference/compatibility#versioning","content":"Major releases may change public API, persisted schema semantics, or runtime support.","locale":"en"},"3018":{"id":"/docs/reference/compatibility-26","page_id":"/docs/reference/compatibility","tags":[],"type":"text","url":"/docs/reference/compatibility#versioning","content":"Persisted history snapshots include a schema version. Use `Travels.deserialize(..., { migrate })` when upgrading storage formats.","locale":"en"},"3019":{"id":"/docs/reference/instance-methods","page_id":"/docs/reference/instance-methods","type":"page","content":"Instance Methods","breadcrumbs":["Travels","Reference"],"tags":[],"url":"/docs/reference/instance-methods","locale":"en"},"3020":{"id":"/docs/reference/instance-methods-0","page_id":"/docs/reference/instance-methods","tags":[],"type":"text","url":"/docs/reference/instance-methods","content":"A task-oriented index of timeline, journal, navigation, history, and persistence methods.","locale":"en"},"3021":{"id":"/docs/reference/instance-methods-1","page_id":"/docs/reference/instance-methods","type":"heading","tags":[],"url":"/docs/reference/instance-methods#state-and-revision","content":"State and revision","locale":"en"},"3022":{"id":"/docs/reference/instance-methods-2","page_id":"/docs/reference/instance-methods","type":"heading","tags":[],"url":"/docs/reference/instance-methods#updates-and-grouping","content":"Updates and grouping","locale":"en"},"3023":{"id":"/docs/reference/instance-methods-3","page_id":"/d