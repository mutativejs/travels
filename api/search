ions","tags":[],"type":"text","url":"/docs/reference/options#capability-specific-options","content":"`createTravelJournal()` requires `apply` and rejects state-owning `mutable` options."},"3101":{"id":"/docs/reference/options-36","page_id":"/docs/reference/options","tags":[],"type":"text","url":"/docs/reference/options#capability-specific-options","content":"Automatic timelines omit `archive()` and `canArchive()`; manual factories expose them in runtime and TypeScript."},"3102":{"id":"/docs/reference/options-37","page_id":"/docs/reference/options","tags":[],"type":"text","url":"/docs/reference/options#capability-specific-options","content":"These distinctions fail closed instead of silently ignoring ownership-specific options."},"3103":{"id":"/docs/reference/typescript","page_id":"/docs/reference/typescript","type":"page","content":"TypeScript Guide","breadcrumbs":["Travels","Reference"],"tags":[],"url":"/docs/reference/typescript"},"3104":{"id":"/docs/reference/typescript-0","page_id":"/docs/reference/typescript","tags":[],"type":"text","url":"/docs/reference/typescript","content":"Infer timeline types, enforce durable state, and use read-only views and open event types safely."},"3105":{"id":"/docs/reference/typescript-1","page_id":"/docs/reference/typescript","type":"heading","tags":[],"url":"/docs/reference/typescript#infer-state-from-the-factory","content":"Infer state from the factory"},"3106":{"id":"/docs/reference/typescript-2","page_id":"/docs/reference/typescript","type":"heading","tags":[],"url":"/docs/reference/typescript#important-exported-types","content":"Important exported types"},"3107":{"id":"/docs/reference/typescript-3","page_id":"/docs/reference/typescript","type":"heading","tags":[],"url":"/docs/reference/typescript#durable-input-checks","content":"Durable input checks"},"3108":{"id":"/docs/reference/typescript-4","page_id":"/docs/reference/typescript","type":"heading","tags":[],"url":"/docs/reference/typescript#read-only-views","content":"Read